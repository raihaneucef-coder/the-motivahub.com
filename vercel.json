{
  "redirects": [
    { "source": "/blog/:path*", "destination": "/journal/:path*", "permanent": true },
    { "source": "/blog", "destination": "/journal", "permanent": true },
    { "source": "/goals", "destination": "/objectives", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-0.xml", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap-0.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30" }
      ]
    },
    {
      "source": "/(en|fr)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30" }
      ]
    },
    {
      "source": "/(en|fr)/journal/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30" }
      ]
    },
    {
      "source": "/(en|fr)/journal/page/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30" }
      ]
    },
    {
      "source": "/(en|fr)/topics/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
