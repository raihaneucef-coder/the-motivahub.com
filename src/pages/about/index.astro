---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { books } from '../../data/books';
import { podcasts } from '../../data/podcasts';

// Verified-at-build-time counts only — no invented audience metrics.
const essayCount = (await getCollection('blog')).filter((p) => !p.data.draft).length;
const bookCount = books.length;
const episodeCount = podcasts.length;

const principles = [
  { num: '01', word: 'Clarity', desc: 'We strip away the noise to find the one thing that matters.' },
  { num: '02', word: 'Consistency', desc: 'Small, repeated acts compound into an unrecognisable life.' },
  { num: '03', word: 'Composure', desc: 'The mind that can hold its centre decides the shape of the day.' },
];
---

<Layout title="About Motiva Hub — A Sanctuary for the Disciplined Mind" description="Motiva Hub exists to help people build a stronger mindset, better habits and consistent daily progress. A premium editorial sanctuary for the disciplined mind.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Motiva Hub",
    "description": "What Motiva Hub is, why it exists, and the editorial philosophy behind it.",
    "url": "https://the-motivahub.com/about/",
    "isPartOf": { "@type": "WebSite", "name": "Motiva Hub", "url": "https://the-motivahub.com/" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "About", "item": "https://the-motivahub.com/about/" }
    ]
  })} />

  <!-- Hero -->
  <section class="ab-hero">
    <div class="ab-hero-inner">
      <div class="ab-hero-text">
        <p class="ab-hero-eyebrow">About Motiva Hub</p>
        <h1 class="ab-hero-title">A Sanctuary for the<br /><em>Disciplined Mind.</em></h1>
        <p class="ab-hero-desc">Motiva Hub exists to help people build a stronger mindset, better habits and consistent daily progress — through honest writing, useful tools, and recommendations we actually stand behind.</p>
        <a href="/journal/" class="ab-hero-cta">Explore the Journal →</a>
        <span class="ab-hero-divider"></span>
        <p class="ab-hero-tagline">Read. Learn. Apply. Grow.</p>
      </div>
      <div class="ab-hero-media">
        <img src="/images/about-portrait.jpg" alt="Silhouette with outstretched arms facing a sunrise over the mist" loading="eager" width="1200" height="800" />
        <p class="ab-hero-img-label">The long<br />ascent.</p>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="ab-principles">
    <div class="container">
      <div class="ab-principles-grid">
        {principles.map((p) => (
          <div class="ab-principle">
            <span class="ab-principle-num">{p.num}</span>
            <h3 class="ab-principle-word">{p.word}</h3>
            <p class="ab-principle-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why we exist -->
  <section class="ab-why">
    <div class="container">
      <div class="ab-why-inner">
        <p class="ab-section-kicker">Why Motiva Hub Exists</p>
        <h2 class="journal-section-title">Not a Motivation<br /><em>Factory.</em></h2>
        <p class="ab-why-lead">Motiva Hub is a premium editorial sanctuary for the disciplined mind. It is a place for people who want to build systems that last, habits that stick, and identities that matter.</p>
        <p>It began as a private notebook — the kind of writing you do for yourself at 5 AM, when the house is quiet and the work is honest. It became a site. Then a publication. The mission never changed: help you build the thing that builds everything else — yourself.</p>
        <p>Every essay here is written to be read slowly. Every tool is built for the person who would rather act than scroll. The Daily Drive is a long game. We play it like one.</p>
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section class="ab-eco">
    <div class="container">
      <div class="ab-section-head">
        <p class="ab-section-kicker">What You'll Find Here</p>
        <h2 class="journal-section-title">One Ascent,<br /><em>Many Paths.</em></h2>
      </div>
      <div class="ab-eco-grid">
        <a class="ab-eco-item" href="/journal/">
          <h3>The Journal</h3>
          <p class="ab-eco-count">{essayCount} essays</p>
          <p>Habit systems, discipline protocols and stoic practice — written from experience, tested in real life.</p>
        </a>
        <a class="ab-eco-item" href="/guides/">
          <h3>Guides</h3>
          <p class="ab-eco-count">Long-form playbooks</p>
          <p>Deep, complete guides for the ideas that deserve more than one article.</p>
        </a>
        <a class="ab-eco-item" href="/tools/">
          <h3>Tools</h3>
          <p class="ab-eco-count">5 free tools</p>
          <p>A habit tracker, discipline quiz, meditation timer and more — built for action, not scrolling.</p>
        </a>
        <a class="ab-eco-item" href="/books/">
          <h3>The Bookstand</h3>
          <p class="ab-eco-count">{bookCount} books</p>
          <p>The books we return to — summarized, reviewed and honestly recommended.</p>
        </a>
        <a class="ab-eco-item" href="/podcast/">
          <h3>Curated Listening</h3>
          <p class="ab-eco-count">{episodeCount} episodes</p>
          <p>A handpicked listening list of conversations on discipline, focus and growth.</p>
        </a>
        <a class="ab-eco-item" href="/30-days-discipline/">
          <h3>30 Days of Discipline</h3>
          <p class="ab-eco-count">Free program</p>
          <p>A day-by-day plan to build the system — with a free PDF companion.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="ab-manifesto">
    <div class="container">
      <p class="ab-manifesto-kicker">A Quiet Manifesto</p>
      <blockquote class="ab-manifesto-quote">
        We are not here to be inspired for an afternoon.<br />
        <em>We are here to be built, slowly,</em><br />
        into the kind of person<br />
        who does the work<br />
        even when no one is watching.
      </blockquote>
      <p class="ab-manifesto-cite">— Motiva Hub · 2026</p>
    </div>
  </section>

  <!-- Author link -->
  <section class="ab-author">
    <div class="container">
      <a class="ab-author-inner" href="/author/youssef-raihane/">
        <span class="ab-author-photo">
          <img src="/images/yr-320.jpg" srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w" sizes="96px" alt="Youssef Raihane" width="96" height="96" loading="lazy" />
        </span>
        <span class="ab-author-text">
          <span class="ab-author-kicker">The Person Behind the Words</span>
          <span class="ab-author-name">Youssef Raihane</span>
          <span class="ab-author-role">Founder &amp; Editor-in-Chief of Motiva Hub — read the full story →</span>
        </span>
      </a>
      <p class="ab-contact">Collaborations, speaking, or just to say hello: <a href="mailto:contact@the-motivahub.com">contact@the-motivahub.com</a></p>
    </div>
  </section>
</Layout>
