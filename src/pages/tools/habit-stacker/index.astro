---
import Layout from "../../../layouts/Layout.astro";
import NewsletterSection from "../../../components/NewsletterSection.astro";

const title = "Habit Stack Generator — Build Your Atomic Habits Chain";
const description = "Free 2-minute tool. Combine any new habit with an existing one. Get a personalized 30-day implementation plan based on James Clear's habit stacking formula.";

const currentHabits = [
  "Brush my teeth", "Pour my morning coffee", "Sit at my desk", "Take off my shoes",
  "Open my laptop", "Park my car", "Take a shower", "Eat breakfast",
  "Check my phone", "Take my first sip of water", "Put on workout clothes",
  "Wash my hands", "Brush my hair", "Lock the front door", "Start the dishwasher"
];

const newHabits = [
  "Meditate for 2 minutes",
  "Read 1 page of a book",
  "Write 1 sentence in my journal",
  "Do 5 push-ups",
  "Drink a glass of water",
  "Stretch for 30 seconds",
  "Take 5 deep breaths",
  "Write down 3 priorities for today",
  "Say out loud: 'I am focused'",
  "Practice gratitude: write 1 thing",
  "Review my goals for 1 minute",
  "Stand up and walk for 30 seconds",
  "Listen to a podcast for 2 minutes",
  "Send a text to someone I appreciate",
  "Visualize my day for 60 seconds"
];
---

<Layout title={title} description={description}>
  <link rel="canonical" href="https://the-motivahub.com/tools/habit-stacker/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": "https://the-motivahub.com/tools/habit-stacker/#app",
    "name": title,
    "description": description,
    "url": "https://the-motivahub.com/tools/habit-stacker/",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": { "@type": "Person", "@id": "https://the-motivahub.com/author/youssef-raihane/#person", "name": "Youssef Raihane" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is habit stacking?", "acceptedAnswer": { "@type": "Answer", "text": "Habit stacking is James Clear's method: link a new habit to an existing one using the formula 'After [CURRENT], I will [NEW].' The current habit becomes the automatic trigger for the new one." } },
      { "@type": "Question", "name": "How long does it take to build a habit stack?", "acceptedAnswer": { "@type": "Answer", "text": "On average, 66 days for a behavior to feel automatic. Some people take 21 days, others 200+. The 2-minute version usually sticks in 14-21 days." } },
      { "@type": "Question", "name": "Can I stack more than one new habit on a current habit?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — but only after the first stack is automatic. Don't layer until each piece is reliable. One stack at a time is the rule." } }
    ]
  })} />

  <section class="hs-head">
    <div class="container">
      <p class="kicker">Free Tool · 2-Minute Setup</p>
      <h1>Build a <em>Habit Stack</em> That Actually Sticks</h1>
      <p>James Clear's method: pair a new habit with one you already do automatically. Get a personalized 30-day plan.</p>
    </div>
  </section>

  <section class="hs-main">
    <div class="container">
      <div class="hs-shell">
        <div class="hs-step hs-step-1" data-step="1">
          <p class="hs-step-num">STEP 1</p>
          <h2>Pick a habit you already do</h2>
          <p class="hs-step-hint">Choose something you do every day without thinking.</p>
          <div class="hs-options">
            {currentHabits.map((h) => (
              <button class="hs-option" data-current>{h}</button>
            ))}
          </div>
          <div class="hs-custom">
            <input type="text" placeholder="Or write your own..." data-custom-current />
          </div>
        </div>

        <div class="hs-step hs-step-2" data-step="2" hidden>
          <p class="hs-step-num">STEP 2</p>
          <h2>Choose a new habit to stack on</h2>
          <p class="hs-step-hint">Pick the smallest possible version. 2 minutes max.</p>
          <div class="hs-options">
            {newHabits.map((h) => (
              <button class="hs-option hs-option-new" data-new>{h}</button>
            ))}
          </div>
          <div class="hs-custom">
            <input type="text" placeholder="Or write your own..." data-custom-new />
          </div>
        </div>

        <div class="hs-step hs-step-3" data-step="3" hidden>
          <p class="hs-step-num">YOUR STACK</p>
          <div class="hs-result">
            <p class="hs-result-prefix">After I</p>
            <p class="hs-result-current" data-result-current></p>
            <p class="hs-result-then">I will</p>
            <p class="hs-result-new" data-result-new></p>
          </div>

          <div class="hs-result-plan">
            <h3>Your 30-Day Protocol</h3>
            <div class="hs-plan-grid">
              <div class="hs-plan-card">
                <p class="hs-plan-day">Days 1-7</p>
                <p class="hs-plan-text">Do the stack once daily. Same time. Same place. No exceptions.</p>
              </div>
              <div class="hs-plan-card">
                <p class="hs-plan-day">Days 8-14</p>
                <p class="hs-plan-text">Track on a paper calendar. Each day = an X. Don't break the chain.</p>
              </div>
              <div class="hs-plan-card">
                <p class="hs-plan-day">Days 15-21</p>
                <p class="hs-plan-text">Notice if it's feeling automatic. If yes, expand duration slightly.</p>
              </div>
              <div class="hs-plan-card">
                <p class="hs-plan-day">Days 22-30</p>
                <p class="hs-plan-text">You have a habit. Add a second stack only after this one feels natural.</p>
              </div>
            </div>
          </div>

          <div class="hs-result-cta">
            <button class="btn-pill btn-pill-cream" id="hs-restart">Build Another Stack</button>
            <a class="btn-pill btn-pill-secondary" href="/guides/atomic-habits-ultimate-guide/">Read the Full Atomic Habits Guide →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="hs-faq">
    <div class="container">
      <h2>Why habit stacking works</h2>
      <p>Most people try to build new habits from nothing. They rely on willpower and motivation — both temporary. Habit stacking works because it the an already-cemented neural pathway. Your brain has thousands of automatic behaviors. By chaining your new habit onto an existing one, you get free momentum.</p>
      <p>The formula: <em>"After [CURRENT], I will [NEW]."</em> Specific, immediate, no thinking required. This is the same principle every athlete, surgeon, and CEO uses — they don't invent new cues, they reuse existing ones.</p>
      <p>You can start using this method right now. The tool above gives you the structure. The discipline is in showing up for 30 days.</p>
    </div>
  </section>

  <NewsletterSection variant="default" showLeadMagnet={true} title="Get your stack tracked daily in your inbox." buttonText="Send My Plan" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://the-motivahub.com/#free-tools" },
      { "@type": "ListItem", "position": 3, "name": "Habit Stack Generator", "item": "https://the-motivahub.com/tools/habit-stacker/" }
    ]
  })} />
</Layout>

<script is:inline>
(function () {
  const state = { current: '', new: '' };

  function goTo(step) {
    document.querySelectorAll('.hs-step').forEach((el) => { el.hidden = true; });
    document.querySelector(`.hs-step-${step}`).hidden = false;
    document.querySelector(`.hs-step-${step}`).scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function pickText(target, value) {
    const customInput = document.querySelector(`[data-custom-${target}]`);
    if (customInput) customInput.value = '';
    if (target === 'current') state.current = value;
    if (target === 'new') state.new = value;
    setTimeout(() => {
      if (target === 'current') goTo(2);
      if (target === 'new') {
        document.querySelector('[data-result-current]').textContent = state.current;
        document.querySelector('[data-result-new]').textContent = state.new;
        goTo(3);
        if (typeof gtag !== 'undefined') {
          gtag('event', 'habit_stack_created', { current: state.current, new: state.new });
        }
      }
    }, 250);
  }

  document.querySelectorAll('[data-current]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-current]').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      pickText('current', btn.text.textContent);
    });
  });

  document.querySelectorAll('[data-new]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-new]').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      pickText('new', btn.textContent);
    });
  });

  document.querySelector('[data-custom-current]').addEventListener('change', (e) => {
    if (e.target.value.trim()) {
      state.current = e.target.value.trim();
      goTo(2);
    }
  });

  document.querySelector('[data-custom-new]').addEventListener('change', (e) => {
    if (e.target.value.trim()) {
      state.new = e.target.value.trim();
      document.querySelector('[data-result-current]').textContent = state.current;
      document.querySelector('[data-result-new]').textContent = state.new;
      goTo(3);
    }
  });

  document.getElementById('hs-restart').addEventListener('click', () => {
    state.current = '';
    state.new = '';
    document.querySelectorAll('.hs-option').forEach((b) => b.classList.remove('selected'));
    goTo(1);
  });
})();
</script>

<style>
  .hs-head { padding: 80px 0 32px; text-align: center; }
  .hs-main { padding: 32px 0 64px; }
  .hs-shell {
    max-width: 720px;
    margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 40px 32px;
  }
  .hs-step-num {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 2.5px;
    color: var(--gold);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .hs-step h2 {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 8px;
    line-height: 1.2;
  }
  .hs-step-hint { color: var(--muted); margin: 0 0 24px; }
  .hs-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; margin-bottom: 16px; }
  .hs-option {
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    cursor: pointer;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink);
    transition: all 0.2s ease;
    text-align: left;
  }
  .hs-option:hover { border-color: var(--gold); background: rgba(200, 160, 74, 0.04); }
  .hs-option.selected { border-color: var(--gold); background: rgba(200, 160, 74, 0.12); }
  .hs-custom input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 14px;
  }

  .hs-result { text-align: center; padding: 32px 0; }
  .hs-result-prefix, .hs-result-then {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 2.5px;
    color: var(--gold);
    margin: 16px 0 8px;
    font-weight: 700;
  }
  .hs-result-current, .hs-result-new {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  .hs-result-plan { margin-top: 32px; padding-top: 32px; border-top: 1px solid var(--line); }
  .hs-plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 20px; }
  .hs-plan-card {
    padding: 20px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 12px;
    text-align: left;
  }
  .hs-plan-day {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--gold);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .hs-plan-text { font-family: var(--sans); font-size: 14px; line-height: 1.5; color: var(--ink); margin: 0; }

  .hs-result-cta { margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-pill-secondary { background: transparent; color: var(--ink); border: 1px solid var(--line); }

  .hs-faq { padding: 64px 0; background: var(--cream); text-align: center; }
  .hs-faq h2 { font-family: var(--serif); font-size: 28px; margin: 0 0 24px; color: var(--ink); }
  .hs-faq p { max-width: 720px; margin: 0 auto 16px; line-height: 1.7; color: var(--ink); font-size: 16px; }
</style>