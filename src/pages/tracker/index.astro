---
import Layout from '../../layouts/Layout.astro';
import HabitTracker from '../../components/HabitTracker.astro';
---

<Layout title="Habit Tracker — Motiva Hub" description="Track your daily habits, build streaks, and stay consistent with your personal growth journey.">
  <section class="tracker-hero">
    <div class="container">
      <p class="kicker">BUILD CONSISTENCY</p>
      <h1>Habit Tracker</h1>
      <p class="tracker-hero-sub">Track your daily habits, build streaks, and watch your consistency grow over time.</p>
    </div>
  </section>

  <section class="tracker-main">
    <div class="container">
      <HabitTracker />
    </div>
  </section>
</Layout>

<style>
  .tracker-hero {
    text-align: center; padding: 4rem 0 2rem;
  }
  .tracker-hero h1 {
    font-family: var(--font-display); font-size: 2.5rem; margin: 0.5rem 0 1rem;
  }
  .tracker-hero-sub {
    max-width: 500px; margin: 0 auto; color: var(--muted); font-size: 1rem;
  }
  .tracker-main { padding-bottom: 4rem; }
</style>
