  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": "https://the-motivahub.com/tools/discipline-quiz/#app",
    "name": title,
    "description": description,
    "url": "https://the-motivahub.com/tools/discipline-quiz/",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": { "@type": "Person", "@id": "https://the-motivahub.com/author/youssef-raihane/#person", "name": "Youssef Raihane" }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Is this quiz really free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. 100% free. No signup required to see results." } },
      { "@type": "Question", "name": "How accurate is it?", "acceptedAnswer": { "@type": "Answer", "text": "Built on patterns from coaching 200+ people over8 years. Not clinical, but useful." } },
      { "@type": "Question", "name": "Will I get a custom plan?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Each archetype comes with a custom30-day protocol based on your type." } }
    ]
  })} />

  <section class="quiz-head">
    <div class="container">
      <p class="kicker" data-i18n="quizKicker">Free Tool · 2-Minute Quiz</p>
      <h1 data-i18n-html="quizTitle">What's Your <em>Discipline Type?</em></h1>
      <p class="quiz-sub" data-i18n="quizSubtitle">5 questions. 4 archetypes. One custom protocol. Find out why most productivity advice fails you — and what to do instead.</p>
    </div>
  </section>

  <section class="quiz-main">
    <div class="container">
      <div class="quiz-shell" id="quiz">
        <div class="quiz-progress">
          <span id="quiz-progress-text" data-i18n="quizProgress">Question 1 of 5</span>
