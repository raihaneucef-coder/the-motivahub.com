          <p id="quiz-result-blindspot"></p>
        </div>

        <div class="quiz-result-section quiz-result-protocol">
          <h3 data-i18n="quizYourProtocol">Your 30-Day Protocol</h3>
          <p id="quiz-result-protocol"></p>
        </div>

