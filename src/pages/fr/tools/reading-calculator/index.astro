---
import Layout from "../../../../layouts/Layout.astro";
import NewsletterSection from "../../../../components/NewsletterSection.astro";

const title = "Calculateur de lecture : livres cette année";
const description = "Calculez combien de livres vous pouvez lire cette année en fonction de votre vitesse de lecture et du temps que vous y consacre.";
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": "https://the-motivahub.com/fr/tools/reading-calculator/#app",
    "name": title,
    "description": description,
    "url": "https://the-motivahub.com/fr/tools/reading-calculator/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": { "@type": "Person", "name": "Youssef Raihane" }
  })} />

  <section class="rc-head">
    <div class="container">
      <p class="kicker" data-i18n="rcKicker">Free Tool · 30 Seconds</p>
      <h1 data-i18n="rcTitle">Reading Goal Calculator</h1>
      <p class="rc-subtitle" data-i18n="rcSubtitle">Turn "read more" into a daily page target. Get a custom plan in 30 seconds.</p>
      <p class="page-head-tagline">De petits outils. Un usage quotidien. Un vrai changement.</p>
    </div>
  </section>

  <section class="rc-main">
    <div class="container">
      <div class="rc-shell">
        <div class="rc-form-grid">
          <div class="rc-input-group">
            <label for="rc-goal" data-i18n="rcGoalLabel">Books you want to read this year</label>
            <input type="number" id="rc-goal" min="1" max="200" value="24" />
          </div>
          <div class="rc-input-group">
            <label for="rc-pages" data-i18n="rcPagesLabel">Average pages per book</label>
            <input type="number" id="rc-pages" min="100" max="1000" value="300" />
          </div>
          <div class="rc-input-group">
            <label for="rc-wpm" data-i18n="rcWpmLabel">Your reading speed (pages/hour)</label>
            <input type="number" id="rc-wpm" min="20" max="120" value="50" />
          </div>
          <div class="rc-input-group">
            <label for="rc-minutes" data-i18n="rcMinutesLabel">Minutes you can read daily</label>
            <input type="number" id="rc-minutes" min="5" max="180" value="20" />
          </div>
        </div>

        <button class="rc-btn rc-btn-primary" id="rc-calculate" data-i18n="rcCalculate">Calculate My Plan</button>

        <div class="rc-results" id="rc-results" hidden>
          <div class="rc-result-headline">
            <p class="rc-result-label" data-i18n="rcDailyTarget">Your daily target</p>
            <p class="rc-result-num" id="rc-pages-day">20</p>
            <p class="rc-result-unit" data-i18n="rcPagesPerDay">pages per day</p>
          </div>

          <div class="rc-result-grid">
            <div class="rc-result-stat">
              <p class="rc-stat-num" id="rc-total-pages">7 200</p>
              <p class="rc-stat-label" data-i18n="rcTotalPages">Total pages</p>
            </div>
            <div class="rc-result-stat">
              <p class="rc-stat-num" id="rc-hours-needed">144</p>
              <p class="rc-stat-label" data-i18n="rcHoursNeeded">Hours needed</p>
            </div>
            <div class="rc-result-stat">
              <p class="rc-stat-num" id="rc-feasibility">83%</p>
              <p class="rc-stat-label" data-i18n="rcGoalFeasible">Goal feasible</p>
            </div>
            <div class="rc-result-stat">
              <p class="rc-stat-num" id="rc-minutes-needed">24 min</p>
              <p class="rc-stat-label" data-i18n="rcDailyNeeded">Daily needed</p>
            </div>
          </div>

           <div class="rc-plan">
            <h2 class="rc-plan-h" data-i18n="rcPlanTitle">Your 4-Quarter Plan</h2>
            <div class="rc-plan-grid" id="rc-plan-grid">
              <div class="rc-plan-card">
                <p class="rc-plan-q">Q1</p>
                <p class="rc-plan-num" data-i18n="rcPlanBooks">6 books</p>
                <p class="rc-plan-desc" data-i18n="rcPlanDescQ1">Jan–Mar · 1 every 2 weeks</p>
              </div>
              <div class="rc-plan-card">
                <p class="rc-plan-q">Q2</p>
                <p class="rc-plan-num" data-i18n="rcPlanBooks">6 books</p>
                <p class="rc-plan-desc" data-i18n="rcPlanDescQ2">Apr–Jun · 1 every 2 weeks</p>
              </div>
              <div class="rc-plan-card">
                <p class="rc-plan-q">Q3</p>
                <p class="rc-plan-num" data-i18n="rcPlanBooks">6 books</p>
                <p class="rc-plan-desc" data-i18n="rcPlanDescQ3">Jul–Sep · 1 every 2 weeks</p>
              </div>
              <div class="rc-plan-card">
                <p class="rc-plan-q">Q4</p>
                <p class="rc-plan-num" data-i18n="rcPlanBooks">6 books</p>
                <p class="rc-plan-desc" data-i18n="rcPlanDescQ4">Oct–Dec · 1 every 2 weeks</p>
              </div>
            </div>
          </div>

          <div class="rc-tip" id="rc-tip">
            <p class="rc-tip-icon">📌</p>
            <p class="rc-tip-text" id="rc-tip-text"></p>
          </div>

          <div class="rc-presets">
            <p class="rc-presets-label" data-i18n="rcPresetsLabel">Quick presets:</p>
            <div class="rc-presets-grid">
              <button class="rc-preset" data-goal="12" data-pages="300" data-wpm="50" data-minutes="20" data-i18n="rcPreset1">12 books (1/month)</button>
              <button class="rc-preset" data-goal="24" data-pages="300" data-wpm="50" data-minutes="20" data-i18n="rcPreset2">24 books (2/month)</button>
              <button class="rc-preset" data-goal="36" data-pages="300" data-wpm="50" data-minutes="20" data-i18n="rcPreset3">36 books (3/month)</button>
              <button class="rc-preset" data-goal="50" data-pages="300" data-wpm="50" data-minutes="30" data-i18n="rcPreset4">50 books (challenge)</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rc-faq">
    <div class="container">
      <h2 data-i18n="rcWhyTitle">Why This Matters</h2>
      <p data-i18n="rcWhyP1">Most "I want to read more" goals fail because they're abstract. "Read 24 books" doesn't translate to "what do I do today?"</p>
      <p data-i18n="rcWhyP2">This calculator converts the goal into a daily target. 20 pages isn't scary. 24 minutes isn't a sacrifice. But 20 pages × 365 days = 7,300 pages = ~24 books a year.</p>
      <p data-i18n="rcWhyP3">The math compounds. So does the habit.</p>
    </div>
  </section>

  <section class="rc-faq">
    <div class="container">
      <h2 data-i18n="rcFaqTitle">FAQ</h2>
      <details>
        <summary data-i18n="rcFaq1Q">What if I miss a day?</summary>
        <p data-i18n="rcFaq1A">That's why the plan is set conservatively. Missing one day = add 20 pages to the next day (or split across 2 days). Missing a week = reassess: is the daily target realistic? If not, lower it.</p>
      </details>
      <details>
        <summary data-i18n="rcFaq2Q">How do I know my reading speed?</summary>
        <p data-i18n="rcFaq2A">Time yourself for 10 minutes on a typical book. Count the pages. Multiply by 6 = pages per hour. Most people: 40-60 p/h. Speed readers: 80-120 p/h.</p>
      </details>
      <details>
        <summary data-i18n="rcFaq3Q">Can I read more than one book at a time?</summary>
        <p data-i18n="rcFaq3A">You can, but retention drops 50%+ with multiple books. Stick to one book at a time. Once you finish, start the next. The math still works.</p>
      </details>
      <details>
        <summary data-i18n="rcFaq4Q">What's the realistic maximum?</summary>
        <p data-i18n="rcFaq4A">With 30 minutes daily and one book at a time: 30-40 books per year is realistic for most readers. Beyond that, retention suffers. Quality > quantity.</p>
      </details>
    </div>
  </section>

  <NewsletterSection variant="default" showLeadMagnet={true} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://the-motivahub.com/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Outils", "item": "https://the-motivahub.com/fr/tools/" },
      { "@type": "ListItem", "position": 3, "name": "Calculateur d'Objectif de Lecture", "item": "https://the-motivahub.com/fr/tools/reading-calculator/" }
    ]
  })} />
</Layout>

<script is:inline>
(function () {
  const goalInput = document.getElementById('rc-goal');
  const pagesInput = document.getElementById('rc-pages');
  const wpmInput = document.getElementById('rc-wpm');
  const minutesInput = document.getElementById('rc-minutes');
  const calcBtn = document.getElementById('rc-calculate');
  const results = document.getElementById('rc-results');
  const presets = document.querySelectorAll('.rc-preset');

  // Typing can push a number outside the min/max the field advertises — those
  // attributes only gate the spinners — so every value is clamped to them here
  // and written back into the field, so the visitor sees what was used.
  const clampInput = (el) => {
    const typed = parseInt(el.value, 10);
    if (!Number.isFinite(typed)) return NaN;
    const clamped = Math.min(Number(el.max), Math.max(Number(el.min), typed));
    if (String(clamped) !== el.value) el.value = String(clamped);
    return clamped;
  };

  // scrollAfter keeps the initial calc() silent: it fills the default numbers
  // without dragging the visitor past the H1 before they have read anything.
  function calc(scrollAfter) {
    const goal = clampInput(goalInput);
    const pages = clampInput(pagesInput);
    const wpm = clampInput(wpmInput);
    const minutes = clampInput(minutesInput);

    if (!goal || !pages || !wpm || !minutes) {
      alert('Veuillez remplir tous les champs avec des nombres valides.');
      return;
    }

    const totalPages = goal * pages;
    const totalHours = Math.round(totalPages / wpm);
    const dailyPages = Math.ceil(totalPages / 365);
    const pagesPerMinute = wpm / 60;
    const minutesNeeded = Math.ceil(dailyPages / pagesPerMinute);
    const minutesAvailable = minutes;
    const feasibility = Math.min(100, Math.round((minutesAvailable / minutesNeeded) * 100));

    document.getElementById('rc-pages-day').textContent = dailyPages;
    document.getElementById('rc-total-pages').textContent = totalPages.toLocaleString('fr-FR');
    document.getElementById('rc-hours-needed').textContent = totalHours;
    document.getElementById('rc-feasibility').textContent = feasibility + '%';
    document.getElementById('rc-minutes-needed').textContent = minutesNeeded + ' min';

    const perQuarter = Math.ceil(goal / 4);
    const weeks = Math.round(12 / perQuarter * 10) / 10;
    // French wording and typography: comma as decimal separator, and
    // "1 chaque semaine" rather than a literal "1 toutes les 1 semaines".
    const weeksFr = String(weeks).replace('.', ',');
    const cadence = weeks === 1 ? '1 chaque semaine' : '1 toutes les ' + weeksFr + ' semaine' + (weeks > 1 ? 's' : '');
    const perQuarterLabel = perQuarter + (perQuarter === 1 ? ' livre' : ' livres');
    document.getElementById('rc-plan-grid').innerHTML = `
      <div class="rc-plan-card">
        <p class="rc-plan-q">Q1</p>
        <p class="rc-plan-num">${perQuarterLabel}</p>
        <p class="rc-plan-desc">Janv.–Mars · ${cadence}</p>
      </div>
      <div class="rc-plan-card">
        <p class="rc-plan-q">Q2</p>
        <p class="rc-plan-num">${perQuarterLabel}</p>
        <p class="rc-plan-desc">Avr.–Juin · ${cadence}</p>
      </div>
      <div class="rc-plan-card">
        <p class="rc-plan-q">Q3</p>
        <p class="rc-plan-num">${perQuarterLabel}</p>
        <p class="rc-plan-desc">Juil.–Sept. · ${cadence}</p>
      </div>
      <div class="rc-plan-card">
        <p class="rc-plan-q">Q4</p>
        <p class="rc-plan-num">${perQuarterLabel}</p>
        <p class="rc-plan-desc">Oct.–Déc. · ${cadence}</p>
      </div>
    `;

    let tip = '';
    if (feasibility < 70) {
      // Pages the time budget really covers in a year, divided by the length of a
      // book — the old version multiplied by 365 and divided by 365, so the
      // suggestion always collapsed to 1 book.
      const sustainableGoal = Math.floor((minutesAvailable * pagesPerMinute * 365) / pages);
      if (sustainableGoal >= 1 && sustainableGoal < goal) {
        tip = `Cible quotidienne : ${dailyPages} pages (${minutesNeeded} min). Vous disposez de ${minutesAvailable} min. Envisagez de réduire votre objectif à ${sustainableGoal} ${sustainableGoal === 1 ? 'livre' : 'livres'} pour tenir sur la durée.`;
      } else {
        // The goal cannot be lowered any further: it is already at the minimum, or
        // the time budget does not even cover one book at this length.
        const oneBookPages = Math.ceil(pages / 365);
        const oneBookMinutes = Math.ceil(oneBookPages / pagesPerMinute);
        tip = `Cible quotidienne : ${dailyPages} pages (${minutesNeeded} min) alors que vous n'avez que ${minutesAvailable} min. Même un seul livre par an exige ${oneBookPages} pages (${oneBookMinutes} min) par jour à ${pages} pages par livre — choisissez des livres plus courts ou ajoutez des minutes.`;
      }
    } else if (feasibility < 90) {
      tip = `Serré. ${dailyPages} pages en ${minutesAvailable} min sont faisables, mais il faudra de la régularité. Choisissez un livre un peu plus simple si vous débutez la lecture quotidienne.`;
    } else if (feasibility < 100) {
      tip = `Faisable. ${dailyPages} pages en ${minutesAvailable} min vous laissent une marge. Vous atteindrez votre objectif sans forcer.`;
    } else {
      tip = `Large. Vous avez ${minutesAvailable - minutesNeeded} min de rab par jour. Lisez davantage ou ajoutez podcasts et livres audio.`;
    }
    document.getElementById('rc-tip-text').textContent = tip;

    results.hidden = false;
    if (scrollAfter) results.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  calcBtn.addEventListener('click', () => calc(true));
  presets.forEach(p => {
    p.addEventListener('click', () => {
      goalInput.value = p.dataset.goal;
      pagesInput.value = p.dataset.pages;
      wpmInput.value = p.dataset.wpm;
      minutesInput.value = p.dataset.minutes;
      calc(true);
    });
  });

  calc();
})();
</script>

<style>
  .rc-head { padding: 80px 0 32px; text-align: center; }
  .rc-subtitle { max-width: 540px; margin: 16px auto 0; color: var(--muted, #666); font-size: 18px; line-height: 1.6; }

  .rc-main { padding: 32px 0 64px; }
  .rc-shell {
    max-width: 720px;
    margin: 0 auto;
    background: var(--panel);
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 16px;
    padding: 40px 32px;
  }

  .rc-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .rc-input-group { display: flex; flex-direction: column; gap: 6px; }
  .rc-input-group label {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted, #888);
    font-weight: 600;
  }
  .rc-input-group input {
    padding: 14px 14px;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 8px;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 16px;
    background: var(--panel);
  }

  .rc-btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    width: 100%;
  }
  .rc-btn-primary { background: var(--text-1); color: #ffffff; }
  .rc-btn-primary:hover { background: var(--text-1); }

  .rc-results { margin-top: 32px; padding-top: 32px; border-top: 1px solid var(--line); }

  .rc-result-headline { text-align: center; padding: 24px 0; }
  .rc-result-label {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted, #888);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .rc-result-num {
    font-family: var(--serif, Georgia, serif);
    font-size: 96px;
    font-weight: 700;
    color: var(--gold, #111111);
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
  }
  .rc-result-unit {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 16px;
    color: var(--ink, #1a1a1a);
    margin: 8px 0 0;
  }

  .rc-result-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; padding: 24px; background: var(--cream, #ffffff); border-radius: 12px; margin-bottom: 24px; }
  .rc-result-stat { text-align: center; }
  .rc-stat-num {
    font-family: var(--serif, Georgia, serif);
    font-size: 22px;
    font-weight: 700;
    color: var(--ink, #1a1a1a);
    margin: 0;
  }
  .rc-stat-label {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted, #888);
    margin: 6px 0 0;
  }

  .rc-plan { margin-bottom: 24px; }
  .rc-plan-h {
    font-family: var(--serif, Georgia, serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink, #1a1a1a);
    margin: 0 0 16px;
  }
  .rc-plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
  .rc-plan-card {
    padding: 20px;
    background: var(--cream, #ffffff);
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 12px;
    text-align: center;
  }
  .rc-plan-q {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--gold, #111111);
    margin: 0 0 8px;
    font-weight: 700;
  }
  .rc-plan-num {
    font-family: var(--serif, Georgia, serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink, #1a1a1a);
    margin: 0 0 6px;
  }
  .rc-plan-desc {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    color: var(--muted, #888);
    margin: 0;
  }

  .rc-tip {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    background: rgba(17, 17, 17, 0.06);
    border: 1px solid rgba(17, 17, 17, 0.2);
    border-radius: 12px;
    margin-bottom: 24px;
  }
  .rc-tip-icon { font-size: 24px; }
  .rc-tip-text {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink, #1a1a1a);
    margin: 0;
  }

  .rc-presets { padding-top: 24px; border-top: 1px solid var(--line); }
  .rc-presets-label {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted, #888);
    margin: 0 0 12px;
    font-weight: 600;
    text-align: center;
  }
  .rc-presets-grid { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .rc-preset {
    padding: 8px 14px;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 6px;
    background: var(--panel);
    cursor: pointer;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--ink, #1a1a1a);
    transition: all 0.2s ease;
  }
  .rc-preset:hover { border-color: var(--gold, #111111); background: rgba(17, 17, 17, 0.04); }

  .rc-faq { padding: 64px 0; background: var(--cream, #ffffff); }
  .rc-faq + .rc-faq { background: var(--panel); }
  .rc-faq h2 { font-family: var(--serif, Georgia, serif); font-size: 28px; text-align: center; margin: 0 0 24px; color: var(--ink, #1a1a1a); }
  .rc-faq p { max-width: 720px; margin: 0 auto 16px; line-height: 1.7; color: var(--ink, #1a1a1a); font-size: 16px; }
  .rc-faq details { max-width: 720px; margin: 0 auto 12px; padding: 16px 20px; background: var(--panel); border: 1px solid var(--line, #e5e5e5); border-radius: 12px; }
  .rc-faq summary { cursor: pointer; font-family: var(--sans, system-ui, sans-serif); font-size: 15px; font-weight: 600; color: var(--ink, #1a1a1a); list-style: none; }
  .rc-faq summary::-webkit-details-marker { display: none; }
  .rc-faq details p { margin: 12px 0 0; }

  @media (max-width: 640px) {
    .rc-form-grid { grid-template-columns: 1fr; }
    .rc-result-num { font-size: 72px; }
  }
</style>