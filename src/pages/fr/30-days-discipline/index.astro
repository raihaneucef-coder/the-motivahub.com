---
import Layout from "../../../layouts/Layout.astro";

const weeks = [
  {
    label: "Semaine 1 — Fondation",
    title: "Construire la Base",
    days: [
      { n: 1, title: "Se Lever à la Même Heure", text: "Mettez un seul réveil. Sortez du lit au premier son. Pas de snooze. Votre journée commence par la discipline, pas par la négociation.", action: "Lever à 6h00 demain. Pas d'exception." },
      { n: 2, title: "Faire Son Lit", text: "La première petite victoire de la journée. Un lit fait signale : je suis en contrôle. L'amiral William McRaven avait raison — ça change le monde.", action: "Faites votre lit dans les 2 minutes après le réveil." },
      { n: 3, title: "Douche Froide — 30 Secondes", text: "Terminez votre douche par 30 secondes d'eau froide. Cela entraîne votre cerveau à faire des choses difficiles volontairement.", action: "Mettez l'eau froide pendant les 30 dernières secondes." },
      { n: 4, title: "Écrivez 3 Choses Dont Vous Êtes Reconnaissant", text: "La discipline n'est pas seulement physique. La gratitude entraîne votre esprit à voir ce qui compte. Écrivez-les à la main.", action: "Avant de dormir, écrivez 3 gratitudes dans un carnet." },
      { n: 5, title: "Pas de Téléphone pendant la Première Heure", text: "Votre matinée vous appartient, pas aux notifications. La première heure définit le ton de tout le reste.", action: "Laissez votre téléphone dans une autre pièce jusqu'à 7h00." },
      { n: 6, title: "10 Pompes", text: "La discipline vit dans le corps. Dix pompes ne sont rien — mais les faire quand vous n'en avez pas envie, c'est tout.", action: "Faites 10 pompes maintenant." },
      { n: 7, title: "Révisez Votre Semaine", text: "Qu'avez-vous fait ? Qu'avez-vous sauté ? Écrivez-le. La conscience de soi est la fondation de la croissance.", action: "Passez 10 minutes à réviser votre semaine honnêtement." },
    ],
  },
  {
    label: "Semaine 2 — Constance",
    title: "Empiler les Habitudes",
    days: [
      { n: 8, title: "Mangez un Repas Sain", text: "Vous n'avez pas besoin d'un régime. Vous avez besoin d'un bon repas. Cuisinez-le, mangez-le lentement, remarquez comment vous vous sentez.", action: "Préparez et mangez un repas nutritif aujourd'hui." },
      { n: 9, title: "Lisez 10 Pages", text: "Pas un chapitre. Pas un livre. Juste 10 pages. La constance bat l'intensité à chaque fois.", action: "Lisez 10 pages de n'importe quel livre avant de dormir." },
      { n: 10, title: "Marchez 20 Minutes", text: "Le mouvement est un médicament. Une marche de 20 minutes clarifie votre esprit, renforce votre corps et construit l'habitude de se présenter.", action: "Marchez pendant 20 minutes sans votre téléphone." },
      { n: 11, title: "Dites Non à une Distraction", text: "Une notification ignorée. Une session de défilement évitée. Chaque « non » à la distraction est un « oui » à votre avenir.", action: "Identifiez votre plus grande distraction et évitez-la pendant 2 heures." },
      { n: 12, title: "Planifiez Demain ce Soir", text: "Écrivez vos 3 principales priorités pour demain. Réveillez-vous avec une direction, pas avec la confusion.", action: "Avant de dormir, écrivez vos 3 priorités pour demain." },
      { n: 13, title: "5 Minutes de Silence", text: "Asseyez-vous seul. Pas de musique. Pas de téléphone. Pas de pensées — observez juste. L'esprit qui peut être tranquille peut tout faire.", action: "Asseyez-vous dans le silence complet pendant 5 minutes." },
      { n: 14, title: "Révision de la Semaine 2", text: "Deux semaines déjà. Êtes-vous constant ? Écrivez ce qui a fonctionné, ce qui n'a pas fonctionné, et ce que vous changerez.", action: "Révisez vos progrès honnêtement. Ajustez si nécessaire." },
    ],
  },
  {
    label: "Semaine 3 — Défi",
    title: "Repousser les Limites",
    days: [
      { n: 15, title: "Douche Froide — 1 Minute", text: "Vous avez survécu à 30 secondes. Maintenant doublez. Le confort est l'ennemi de la croissance.", action: "1 minute d'eau froide. Respirez à travers." },
      { n: 16, title: "Pas de Plaintes pendant 24 Heures", text: "Zéro plainte. Pas sur le temps. Pas sur le travail. Pas sur quoi que ce soit. La gratitude remplace les plaintes.", action: "Passez toute la journée sans vous plaindre une fois." },
      { n: 17, title: "20 Pompes + 20 Squats", text: "Le corps devient plus fort. Prouvez-le-vous. Doublez ce que vous avez fait le Jour 6.", action: "20 pompes et 20 squats. Pas de repos entre les deux." },
      { n: 18, title: "Faites la Chose que Vous Évitez", text: "Cet email. Cette conversation. Cette tâche. Faites-la aujourd'hui. La discipline signifie faire ce qui doit être fait.", action: "Complétez la seule tâche que vous avez remise à plus tard." },
      { n: 19, title: "Mangez Sain toute la Journée", text: "Pas de malbouffe. Pas de sucre. Pas de nourriture transformée. Une journée saine vous montre ce dont votre corps est capable.", action: "Mangez uniquement des aliments entiers pendant une journée complète." },
      { n: 20, title: "Se Lever à 5h00", text: "Vous vous entraînez depuis 20 jours. Maintenant levez-vous une heure plus tôt. Possédez la matinée avant que le monde ne vous possède.", action: "Réveil à 5h00. Hors du lit au premier son." },
      { n: 21, title: "Révision de la Semaine 3", text: "Trois semaines. Vous n'êtes plus la même personne qui a commencé. Écrivez comment vous avez changé.", action: "Journalisez sur la personne que vous devenez." },
    ],
  },
  {
    label: "Semaine 4 — Maîtrise",
    title: "Devenir la Personne",
    days: [
      { n: 22, title: "2 Minutes d'Eau Froide", text: "Vous êtes allé aussi loin. Deux minutes ne sont plus rien maintenant. Votre esprit est plus fort qu'il ne l'était le Jour 3.", action: "2 minutes de douche froide. Vous l'avez mérité." },
      { n: 23, title: "Aidez Quelqu'un Aujourd'hui", text: "La discipline n'est pas égoïste. Utilisez votre force pour élever quelqu'un d'autre. Un mot gentil, un coup de main, un moment de votre temps.", action: "Faites un acte de gentillesse pour quelqu'un d'autre." },
      { n: 24, title: "30 Pompes + 30 Squats", text: "Trois fois ce avec quoi vous avez commencé. Le corps suit l'esprit. Vous êtes la preuve.", action: "30 pompes et 30 squats. Sentez la différence." },
      { n: 25, title: "Pas de Réseaux Sociaux pendant 24 Heures", text: "Une journée complète. Pas de défilement. Pas d'histoires. Pas de reels. Vous survivrez. Vous pourriez même prospérer.", action: "Supprimez les applications pendant 24 heures. Réinstallez demain." },
      { n: 26, title: "Écrivez une Lettre à Votre Futur Moi", text: "Où serez-vous dans un an ? Écrivez à cette personne. Dites-lui ce que vous avez commencé. Dites-lui pourquoi.", action: "Écrivez une lettre à vous-même, dans un an." },
      { n: 27, title: "Jeûnez Jusqu'au Déjeuner", text: "La faim est un sentiment, pas une urgence. Sautez le petit-déjeuner. Mangez à midi. Apprenez la différence entre vouloir et avoir besoin.", action: "Ne mangez qu'après 12h00." },
      { n: 28, title: "Courez ou Marchez 5K", text: "28 jours de discipline vous ont amené ici. Bougez votre corps pendant 5 kilomètres. Vous n'êtes plus la même personne qu'au Jour 1.", action: "Complétez 5K — courir, jogger ou marcher." },
      { n: 29, title: "Enseignez ce que Vous Avez Appris", text: "Partagez une leçon de ce voyage avec un ami, un membre de la famille, un collègue. Enseigner cimente l'apprentissage.", action: "Dites à une personne ce que 30 jours de discipline vous ont appris." },
      { n: 30, title: "Recommencez — Jour 1", text: "Vous avez fini. Mais la discipline n'a pas de ligne d'arrivée. Recommencez. Cette fois, vous savez qui vous êtes.", action: "Demain est le Jour 1 à nouveau. Serez-vous présent ?" },
    ],
  },
];

const allDays = weeks.flatMap((w) => w.days);
---

<Layout title="30 Jours de Discipline — Guide Gratuit | Motiva Hub" description="Un défi gratuit de 30 jours pour construire une discipline inébranlable. Un petit acte par jour — transforme votre vie à la fin.">
  <link rel="canonical" href="https://the-motivahub.com/fr/30-days-discipline/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://the-motivahub.com/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Outils", "item": "https://the-motivahub.com/fr/tools/" },
      { "@type": "ListItem", "position": 3, "name": "30 Jours de Discipline", "item": "https://the-motivahub.com/fr/30-days-discipline/" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Qu'est-ce que le programme 30 Jours de Discipline ?", "acceptedAnswer": { "@type": "Answer", "text": "Un défi gratuit et pratique de 30 jours. Chaque jour vous donne une petite action qui prend 5 minutes ou moins. Complétez les 30 jours pour construire une discipline et une constance durables." } },
      { "@type": "Question", "name": "Ai-je besoin d'un compte ?", "acceptedAnswer": { "@type": "Answer", "text": "Non. Tout le programme est gratuit et accessible sur une seule page. Pas d'inscription, pas de connexion, pas de suivi. Venez simplement et faites l'action du jour." } },
      { "@type": "Question", "name": "Comment ça marche ?", "acceptedAnswer": { "@type": "Answer", "text": "Chaque jour a un défi — une petite action concrète. Commencez au Jour 1, complétez l'action, puis passez au Jour 2. Vous pouvez télécharger la version PDF pour suivre votre progression hors ligne." } }
    ]
  })} />

  <!-- Hero -->
  <section class="d30-hero">
    <div class="d30-hero-inner">
      <div class="d30-hero-text">
        <p class="d30-hero-eyebrow">Un Petit Pas. Chaque Jour.</p>
        <h1 class="d30-hero-title">30 Jours de<br /><em>Discipline.</em></h1>
        <p class="d30-hero-sub">Une page. Une action. Chaque jour.</p>
        <p class="d30-hero-desc">Un programme simple et pratique de 30 jours pour vous aider à construire la constance, prendre le contrôle de vos habitudes et devenir une meilleure version de vous-même.</p>
        <a href="#day-1" class="d30-hero-cta">Commencer le Jour 1 →</a>
        <span class="d30-hero-divider"></span>
        <p class="d30-hero-tagline">Discipline aujourd'hui. Un demain meilleur.</p>
      </div>
      <div class="d30-hero-img">
        <img src="/images/hero-mountain-man.jpg" alt="Personne au sommet d'une montagne au coucher du soleil" loading="eager" width="1024" height="1024" />
        <p class="d30-hero-img-label">Des actions<br />constantes<br />produisent des<br />résultats<br />extraordinaires.</p>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="d30-benefits">
    <div class="container">
      <div class="d30-benefits-grid">
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="4" x2="9" y2="10"/></svg></div>
          <div><h3>30 Actions Quotidiennes</h3><p>Petits pas pratiques qui se cumulent.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg></div>
          <div><h3>Construire la Constance</h3><p>Créez de vraies habitudes qui durent.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></div>
          <div><h3>Pensé pour la Vraie Vie</h3><p>Simple. Concentré. Pas de perfection requise.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
          <div><h3>Un Meilleur Vous</h3><p>Plus de clarté, d'énergie et de direction.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Day Index Grid -->
  <section class="d30-journey">
    <div class="container">
      <div class="journal-section-head">
        <h2 class="journal-section-title">Le Parcours <em>30 Jours</em></h2>
        <p class="d30-journey-label">30 Jours. Vrais Progrès.</p>
      </div>
      <div class="d30-grid">
        {allDays.map((d) => (
          <a href={`#day-${d.n}`} class={`d30-grid-item${d.n === 1 ? ' active' : ''}`}>Jour {d.n}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Day Cards -->
  {weeks.map((week) => (
    <section class="d30-week">
      <div class="container">
        <div class="d30-week-head">
          <p class="d30-week-kicker">{week.label}</p>
          <h2 class="d30-week-title">{week.title}</h2>
        </div>
        <div class="d30-days">
          {week.days.map((d) => (
            <article class="d30-day-card" id={`day-${d.n}`}>
              <span class="d30-day-num">{String(d.n).padStart(2, '0')}</span>
              <div class="d30-day-body">
                <h3 class="d30-day-title">{d.title}</h3>
                <p class="d30-day-text">{d.text}</p>
                <p class="d30-day-action"><strong>Défi :</strong> {d.action}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Quote -->
  <section class="d30-quote">
    <div class="container">
      <div class="d30-quote-inner">
        <div class="d30-quote-text-wrap">
          <p class="d30-quote-label">Mentalité de Discipline</p>
          <blockquote class="d30-quote-block">« Vous ne vous élevez pas au niveau de vos objectifs. Vous tombez au niveau de <em>vos systèmes</em>. »</blockquote>
          <p class="d30-quote-attr">— James Clear</p>
        </div>
        <div class="d30-quote-img">
          <img src="/images/path.jpg" alt="Sentier de montagne au lever du soleil" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="d30-faq">
    <div class="container">
      <div class="journal-section-head">
        <h2 class="journal-section-title">Questions <em>Fréquentes</em></h2>
        <p class="d30-journey-label">Restons Simples.</p>
      </div>
      <div class="d30-faq-list">
        <details class="d30-faq-item">
          <summary>Qu'est-ce que le programme 30 Jours de Discipline ?</summary>
          <p>Un défi gratuit et pratique de 30 jours. Chaque jour vous donne une petite action qui prend 5 minutes ou moins. Complétez les 30 jours pour construire une discipline et une constance durables.</p>
        </details>
        <details class="d30-faq-item">
          <summary>Ai-je besoin d'un compte ?</summary>
          <p>Non. Tout le programme est gratuit et accessible sur une seule page. Pas d'inscription, pas de connexion, pas de suivi. Venez simplement et faites l'action du jour.</p>
        </details>
        <details class="d30-faq-item">
          <summary>Comment ça marche ?</summary>
          <p>Chaque jour a un défi — une petite action concrète. Commencez au Jour 1, complétez l'action, puis passez au Jour 2. Vous pouvez télécharger la version PDF pour suivre votre progression hors ligne.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- PDF Download -->
  <section class="d30-pdf" id="subscribe">
    <div class="container">
      <div class="d30-pdf-inner">
        <div class="d30-pdf-text">
          <p class="d30-pdf-label">Obtenir le PDF</p>
          <h2>Téléchargez « 30 Jours de Discipline »</h2>
          <p>Emportez le programme avec vous. Un PDF propre, prêt à imprimer ou à utiliser sur n'importe quel appareil.</p>
        </div>
        <div class="d30-pdf-actions">
          <a href="/30-days-discipline.pdf" download class="d30-pdf-btn">Télécharger le PDF</a>
          <form class="d30-pdf-form" id="pdf-form" novalidate>
            <input type="text" name="name" placeholder="Prénom (facultatif)" aria-label="Prénom" autocomplete="name" />
            <input type="email" name="email" placeholder="Ou recevez-le par email" aria-label="Adresse e-mail" required autocomplete="email" />
            <button type="submit">Envoyer →</button>
          </form>
          <p id="pdf-msg" class="d30-pdf-msg" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const pdfForm = document.getElementById("pdf-form") as HTMLFormElement | null;
    const pdfMsg = document.getElementById("pdf-msg");
    pdfForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(pdfForm);
      const email = String(fd.get("email") || "").trim();
      const name = String(fd.get("name") || "").trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (pdfMsg) { pdfMsg.textContent = "Veuillez entrer un email valide."; pdfMsg.style.color = "#ff4d00"; }
        return;
      }
      if (pdfMsg) { pdfMsg.textContent = "Envoi en cours..."; pdfMsg.style.color = "#888"; }
      try {
        const res = await fetch("https://formsubmit.co/ajax/raihaneucef@gmail.com", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            name: name || "(sans nom)",
            email,
            _subject: "Nouvel abonné 30 Jours de Discipline (FR)",
            _template: "table",
            _response: "Merci ! Votre PDF gratuit : https://the-motivahub.com/30-days-discipline.pdf",
            source: "30-days-discipline-page-fr"
          })
        });
        if (res.ok) {
          if (pdfMsg) { pdfMsg.textContent = "✓ Vérifiez votre boîte mail pour le lien PDF."; pdfMsg.style.color = "#4caf50"; }
          pdfForm.reset();
        } else throw new Error("failed");
      } catch {
        if (pdfMsg) { pdfMsg.textContent = "Une erreur est survenue. Essayez le téléchargement direct."; pdfMsg.style.color = "#ff4d00"; }
      }
    });
  </script>
</Layout>
