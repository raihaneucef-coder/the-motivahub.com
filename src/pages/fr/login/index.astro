---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
---

<Layout title="Login — Motiva Hub" description="Log in to your Motiva Hub account." noindex={true}>
  <section class="auth-section">
    <div class="container">
      <div class="auth-card">
        <p class="kicker" data-i18n="loginKicker">The Daily Drive</p>
        <h1 data-i18n-html="loginTitle">Welcome <em>back.</em></h1>
        <p class="auth-sub" data-i18n="loginSub">Log in to continue your ascent.</p>
        <!--
          AUTH INTEGRATION POINT:
          Connect this form to your authentication service
          (e.g. Supabase Auth, Auth0, or a custom API) by
          replacing the action URL and handling the response.
        -->
        <form action="/login/" method="post" class="auth-form">
          <div class="form-group">
            <label for="email" data-i18n="loginEmailLabel">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="password" data-i18n="loginPasswordLabel">Password</label>
            <input type="password" id="password" name="password" required />
          </div>
          <button type="submit" class="btn-pill" style="width: 100%;" data-i18n="loginButton">Log In</button>
        </form>
        <div class="auth-links">
          <Link href="/forgot-password/" data-i18n="loginForgot">Forgot password?</a>
          <Link href="/register/" data-i18n="loginCreateAccount">Create an account →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>