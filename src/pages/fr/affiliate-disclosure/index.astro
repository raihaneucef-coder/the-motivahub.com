---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
---

<Layout title="Affiliate Disclosure — Motiva Hub" description="Motiva Hub earns commissions from Amazon affiliate links and book recommendations. Learn how our affiliate relationships work and how they affect our content.">
  <section class="legal">
    <div class="container">
      <h1 data-i18n="disclosurePageTitle">Affiliate Disclosure</h1>
      <p data-i18n="disclosureLastUpdated"><strong>Last updated:</strong> August 20, 2026</p>
      <p data-i18n="disclosureIntro">Motiva Hub participates in affiliate programs, including the Amazon Associates Program. This means that some of the "View Book" buttons on our Books page may contain affiliate links.</p>
      <h2 data-i18n="disclosureWhatTitle">What This Means for You</h2>
      <ul>
        <li data-i18n="disclosureWhatItem1">If you click an affiliate link and make a purchase, we may earn a small commission.</li>
        <li data-i18n="disclosureWhatItem2">This costs you nothing extra — the price you pay is the same.</li>
        <li data-i18n="disclosureWhatItem3">We only recommend books we have actually read and return to.</li>
        <li data-i18n="disclosureWhatItem4">We never let commissions influence our recommendations.</li>
      </ul>
      <h2 data-i18n="disclosureTransparencyTitle">Transparency</h2>
      <p data-i18n="disclosureTransparencyP1">We believe in full transparency. As an Amazon Associate we earn from qualifying purchases. If you have any questions about our affiliate relationships, contact us through the <Link href="/contact/">contact page</a>.</p>
    </div>
  </section>
</Layout>