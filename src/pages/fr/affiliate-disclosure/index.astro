---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
---

<Layout title="Divulgation d'Affiliation — Motiva Hub" description="Motiva Hub participe à des programmes d'affiliation, notamment le Programme Partenaires Amazon. Cela signifie que certains boutons sur notre page Livres peuvent contenir des liens d'affiliation. Apprenez comment cela fonctionne et ce que cela signifie pour vous.">
  <section class="legal">
    <div class="container">
      <h1 data-i18n="disclosurePageTitle">Divulgation d'Affiliation</h1>
      <p data-i18n-html="disclosureLastUpdated"><strong>Dernière mise à jour :</strong> 20 août 2026</p>
      <p data-i18n="disclosureIntro">Motiva Hub participe à des programmes d'affiliation, notamment le Programme Partenaires Amazon. Cela signifie que certains boutons sur notre page Livres peuvent contenir des liens d'affiliation.</p>
      <h2 data-i18n="disclosureWhatTitle">Ce Que Cela Signifie Pour Vous</h2>
      <ul>
        <li data-i18n="disclosureWhatItem1">If you click an affiliate link and make a purchase, we may earn a small commission.</li>
        <li data-i18n="disclosureWhatItem2">This costs you nothing extra — the price you pay is the same.</li>
        <li data-i18n="disclosureWhatItem3">We only recommend books we have actually read and return to.</li>
        <li data-i18n="disclosureWhatItem4">We never let commissions influence our recommendations.</li>
      </ul>
      <h2 data-i18n="disclosureTransparencyTitle">Transparency</h2>
      <p data-i18n="disclosureTransparencyP1">We believe in full transparency. As an Amazon Associate we earn from qualifying purchases. If you have any questions about our affiliate relationships, contact us through the <Link href="/contact/">contact page</a>.</p>
    </div>
  </section>
</Layout>