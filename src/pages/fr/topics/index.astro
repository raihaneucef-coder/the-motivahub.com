---
import Layout from "../../../layouts/Layout.astro";
import TopicCard from "../../../components/TopicCard.astro";
import NewsletterSection from "../../../components/NewsletterSection.astro";
import { topics } from "../../../data/topics";
---

<Layout title="Thèmes — Motiva Hub" description="Tous les sujets Motiva Hub au même endroit — état d'esprit, habitudes, discipline, productivité, sport et plus. Choisissez une porte et commencez l'ascension.">
  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="topicsKicker">The Intellectual Feed</p>
      <h1 data-i18n-html="topicsTitle">Eight subjects. <em>One ascent.</em></h1>
      <p data-i18n="topicsSubtitle">Each topic is a doorway into a single, durable idea. Enter wherever you are — they were designed to be returned to.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="topics-grid">
        {topics.map((topic) => <TopicCard topic={topic} />)}
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>