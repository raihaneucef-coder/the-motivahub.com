---
import Layout from "../../../layouts/Layout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import PillarHub from "../../../components/PillarHub.astro";
import { topics } from "../../../data/topics";
import { pillars } from "../../../data/pillars";
import dictFr from "../../../../public/i18n/dict-fr.json";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return topics.map((t) => ({ params: { id: t.id }, props: { topic: t } }));
}

const { topic } = Astro.props;
const norm = (s: string) => s.toLowerCase().trim().replace(/\s+/g, "-");
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft && norm(p.data.topic) === topic.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pillar = pillars[topic.id];
---

<Layout title={`${topic.title} — Motiva Hub`} description={topic.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${topic.title} — Motiva Hub`,
    "description": topic.description,
    "url": `https://the-motivahub.com/topics/${topic.id}/`,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Motiva Hub",
      "url": "https://the-motivahub.com/"
    },
    "about": {
      "@type": "Thing",
      "name": topic.title
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": posts.length,
      "itemListElement": posts.slice(0, 10).map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://the-motivahub.com/journal/${p.id}/`,
        "name": p.data.title
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "Topics", "item": "https://the-motivahub.com/topics/" },
      { "@type": "ListItem", "position": 3, "name": topic.title, "item": `https://the-motivahub.com/topics/${topic.id}/` }
    ]
  })} />
  <section class="page-head">
    <div class="container">
      <p class="kicker"><a href="/fr/topics/" style="color:inherit;text-decoration:none;" data-i18n="topicsKicker">{dictFr.topicsKicker}</a> · <span data-i18n="theFeed">{dictFr.theFeed}</span></p>
      <h1>{topic.title} <em>— {posts.length} {posts.length === 1 ? "essay" : "essays"}.</em></h1>
      <p>{topic.descriptionFr || topic.description}</p>
    </div>
  </section>

  {pillar && <PillarHub pillar={pillar} posts={posts} locale="fr" />}

  <section class="feed">
    <div class="container">
      {pillar && <p class="kicker" style="margin-bottom:22px;" data-i18n="hubFeedTitle">{dictFr.hubFeedTitle}</p>}
      <div class="grid">
        {posts.map((post) => <ArticleCard post={post} locale="fr" />)}
      </div>
      {posts.length === 0 && (
        <p style="text-align:center;color:var(--muted);margin-top:40px;" data-i18n="essaysBeingPrepared">
          The first essays for this topic are being prepared. Return soon.
        </p>
      )}
      <p style="text-align:center;margin-top:48px;">
        <a class="read-more" href="/fr/journal/" data-i18n="backToAllEssays">← Back to all essays</a>
      </p>
    </div>
  </section>

  {topic.id === "habits" && !pillar && (
    <section class="pillar-cta">
      <div class="container" style="text-align:center;padding:48px 24px;background:var(--surface);border-radius:12px;margin:48px auto;max-width:720px;">
        <p class="kicker" data-i18n="pillarKicker">The Pillar</p>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;margin:12px 0;" data-i18n="pillarTitle">The 2-Minute Rule: A Complete System</h2>
        <p style="color:var(--muted);margin-bottom:20px;" data-i18n="pillarHabitsDesc">The most misunderstood idea in habit science — read the full 3,000-word architecture, including the recovery protocol for when it stops working.</p>
        <a class="read-more" href="/fr/journal/2-minute-rule-system/" data-i18n="readPillar">Read the pillar →</a>
      </div>
    </section>
  )}

  {topic.id === "discipline" && (
    <section class="pillar-cta">
      <div class="container" style="text-align:center;padding:48px 24px;background:var(--surface);border-radius:12px;margin:48px auto;max-width:720px;">
        <p class="kicker" data-i18n="pillarKicker">The Pillar</p>
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;margin:12px 0;" data-i18n="pillarTitle">The 2-Minute Rule: A Complete System</h2>
        <p style="color:var(--muted);margin-bottom:20px;" data-i18n="pillarDisciplineDesc">Discipline is the output of identity. The 2-minute rule is the smallest on-ramp to both — read the full architecture.</p>
        <a class="read-more" href="/fr/journal/2-minute-rule-system/" data-i18n="readPillar">Read the pillar →</a>
      </div>
    </section>
  )}
</Layout>
