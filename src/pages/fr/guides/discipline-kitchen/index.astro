---
import Layout from "../../../../layouts/Layout.astro";
const title = "La Cuisine Disciplinée — PDF Gratuit 12 Pages | Motiva Hub";
const description = "Mangez comme un système, pas comme un humeur. Prep dimanche 2h, protocole protéines, hydratation, template 7 jours. PDF imprimable gratuit.";
const canonical = "https://the-motivahub.com/fr/guides/discipline-kitchen/";
---

<Layout title={title} description={description} canonical={canonical} lang="fr">
  <link rel="canonical" href={canonical} />
  <style>
    .guide-hero { padding: clamp(48px,8vw,96px) 0 40px; }
    .guide-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    .guide-kicker { color: var(--gold, #d4b377); font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; margin-bottom: 16px; }
    .guide-h1 { font-family: 'Fraunces', serif; font-size: clamp(32px,5vw,52px); line-height: 1.05; margin: 0 0 16px; }
    .guide-sub { font-size: 16px; line-height: 1.6; color: var(--text-muted, #999); margin: 0 0 24px; max-width: 500px; }
    .guide-form { display: flex; flex-direction: column; gap: 10px; max-width: 460px; }
    .guide-form-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .guide-form input { flex: 1 1 160px; padding: 14px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; color: var(--text, #f5f5f5); font-size: 15px; }
    .guide-form input:focus { outline: none; border-color: var(--gold, #d4b377); }
    .guide-form button { padding: 14px 22px; background: var(--gold, #d4b377); color: #0a0a0a; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 15px; }
    .guide-msg { font-size: 13px; color: var(--text-muted, #888); min-height: 20px; }
    .guide-legal { font-size: 11px; color: var(--text-muted, #666); }
    .guide-legal a { color: inherit; }
    .guide-mockup { background: #faf8f0; border-radius: 8px; padding: 24px; aspect-ratio: 5/7; max-width: 320px; margin: 0 auto; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.4); display: flex; flex-direction: column; justify-content: space-between; color: #1a1a1a; }
    .guide-mockup-kicker { font-size: 9px; color: #b8965a; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; }
    .guide-mockup-title { font-family: 'Fraunces', serif; font-size: 30px; line-height: 1.05; margin: 10px 0 0; color: #0a0a0a; }
    .guide-mockup-rule { width: 36px; height: 2px; background: #b8965a; margin: 12px 0; }
    .guide-mockup-body { font-size: 11px; color: #333; }
    .guide-mockup-footer { font-size: 10px; color: #6b5320; font-family: 'Fraunces', serif; font-style: italic; }
    .guide-list { max-width: 700px; margin: 40px auto; padding: 0 24px; }
    .guide-list h2 { font-family: 'Fraunces', serif; font-size: 28px; margin: 0 0 20px; }
    .guide-list ol { padding-left: 20px; }
    .guide-list li { margin-bottom: 10px; color: var(--text-muted, #aaa); font-size: 15px; }
    .guide-list li strong { color: var(--text, #f5f5f5); }
    @media (max-width: 780px) { .guide-inner { grid-template-columns: 1fr; } .guide-mockup { max-width: 240px; } }
  </style>

  <section class="guide-hero">
    <div class="guide-inner">
      <div>
        <div class="guide-kicker">Motiva Hub · Guide de Terrain № 03</div>
        <h1 class="guide-h1">La Cuisine Disciplinée</h1>
        <p class="guide-sub">Mangez comme un système, pas comme une humeur. 12 pages : prep dimanche 2h, protéines d'abord, hydratation, template 7 jours. Éliminez chaque décision alimentaire quotidienne.</p>
        <form class="guide-form" id="fr-ck-form" novalidate>
          <input type="hidden" name="source" value="discipline-kitchen" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" />
          <div class="guide-form-row">
            <input type="text" name="name" placeholder="Prénom (optionnel)" autocomplete="given-name" />
            <input type="email" name="email" placeholder="vous@email.com" required autocomplete="email" />
            <button type="submit">Envoyer le PDF →</button>
          </div>
          <p class="guide-msg" id="fr-ck-msg" aria-live="polite"></p>
          <p class="guide-legal">Gratuit pour toujours. <a href="/fr/privacy/">Confidentialité</a> · <a href="/fr/affiliate-disclosure/">Divulgation</a></p>
        </form>
      </div>
      <aside class="guide-mockup" aria-label="Aperçu du PDF">
        <div>
          <div class="guide-mockup-kicker">Guide de Terrain № 03</div>
          <div class="guide-mockup-title">The Discipline<br>Kitchen</div>
          <div class="guide-mockup-rule"></div>
          <div class="guide-mockup-body">Eat like a system, not a mood.</div>
        </div>
        <div class="guide-mockup-footer">Youssef Raihane · the-motivahub.com</div>
      </aside>
    </div>
  </section>

  <section class="guide-list">
    <h2>Contenu (12 pages, en anglais)</h2>
    <ol>
      <li><strong>Bienvenue</strong> — pourquoi la cuisine est la première discipline</li>
      <li><strong>La Formule</strong> — Prep × Proximité × Pattern</li>
      <li><strong>Dimanche 2h</strong> — protocole meal-prep minuté</li>
      <li><strong>Protéines d'abord</strong> — ordre alimentaire + objectifs journaliers</li>
      <li><strong>Hydratation</strong> — l'eau avant la volonté</li>
      <li><strong>L'Assiette</strong> — framework visuel, sans comptage</li>
      <li><strong>Jeûne intermittent</strong> — la version honnête</li>
      <li><strong>Timing</strong> — la règle 3-2-1</li>
      <li><strong>Template 7 jours</strong> — copiez, ajustez</li>
      <li><strong>Ustensiles</strong> — 5 investissements anti-friction</li>
    </ol>
  </section>

  <script>
    const form = document.getElementById('fr-ck-form');
    const msg = document.getElementById('fr-ck-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email')||'').trim();
      const name = String(fd.get('name')||'').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent='Entrez un email valide.'; return; }
      msg.textContent = 'Envoi…';
      try {
        const r = await fetch('/api/pdf-subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({email,name,source:'discipline-kitchen'}) });
        const d = await r.json();
        if (d.ok) { msg.textContent='✓ Vérifiez votre boîte mail.'; form.reset(); try{window.gtag&&window.gtag('event','pdf_subscribe',{source:'discipline-kitchen-fr'})}catch{} }
        else throw new Error(d.message);
      } catch { msg.textContent='Échec. Essayez le lien direct.'; }
    });
  </script>
</Layout>
