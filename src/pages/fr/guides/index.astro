---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";

// Guide data — mirrors EN, with French titles/descriptions from the FR guide page
const guides = [
  {
    slug: "habit-stack-kit",
    title: "Le Kit de Habitudes — PDF Gratuit 14 Pages",
    description: "Guide imprimable pour ceux qui ont lu les livres mais n'ont toujours pas les habitudes. Ancre + comportement + récompense.",
    topic: "Habitudes",
    wordCount: 0,
    image: "/images/blog/atomic-habits-review-2.jpg",
    datePublished: "2026-10-04",
  },
  {
    slug: "discipline-kitchen",
    title: "La Cuisine Disciplinée — PDF Gratuit 12 Pages",
    description: "Mangez comme un système, pas comme une humeur. Prep dimanche 2h, protéines d'abord, hydratation, template 7 jours.",
    topic: "Alimentation",
    wordCount: 0,
    image: "/images/blog/atomic-habits-review-2.jpg",
    datePublished: "2026-10-04",
  },
  {
    slug: "home-athlete",
    title: "L'Athlète à Domicile — PDF Gratuit 10 Pages",
    description: "Entraînez-vous chez vous sans gadgets. Protocoles poids du corps, exposition au froid, récupération.",
    topic: "Sport",
    wordCount: 0,
    image: "/images/blog/atomic-habits-review-2.jpg",
    datePublished: "2026-10-04",
  },
  {
    slug: "atomic-habits-ultimate-guide",
    title: "Le Guide Ultime Atomic Habits — Ce Qui Fonctionne Vraiment en 2026",
    description: "Une analyse complète et fondée sur la recherche du livre Atomic Habits de James Clear. Les 4 lois, la science, le protocole de 30 jours — et ce que la plupart des critiques laissent de côté.",
    topic: "Habitudes",
    wordCount: 3800,
    image: "/images/blog/atomic-habits-review-2.jpg",
    datePublished: "2026-09-01",
  },
];

const readTime = (words: number) => `${Math.round(words / 250)} MIN DE LECTURE`;
---

<Layout title="Guides Pratiques — Motiva Hub" description="Des guides étape par étape, des frameworks et de vraies stratégies pour vous aider à construire de meilleures habitudes, un esprit plus sain et une vie plus intentionnelle.">
  <link rel="canonical" href="https://the-motivahub.com/fr/guides/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Guides Pratiques — Motiva Hub",
    "description": "Guides étape par étape et frameworks pour construire de meilleures habitudes et une vie plus intentionnelle.",
    "url": "https://the-motivahub.com/fr/guides/",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Motiva Hub",
      "url": "https://the-motivahub.com/"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": guides.length,
      "itemListElement": guides.map((g, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://the-motivahub.com/fr/guides/${g.slug}/`,
        "name": g.title
      }))
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://the-motivahub.com/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://the-motivahub.com/fr/guides/" }
    ]
  })} />

  <!-- Hero Banner -->
  <section class="guides-hero-banner">
    <div class="guides-hero-inner">
      <div class="guides-hero-text">
        <p class="guides-hero-eyebrow">Apprendre. Appliquer. Grandir.</p>
        <h1 class="guides-hero-title">Guides Pratiques<br />pour un <em>Vous Meilleur.</em></h1>
        <p class="guides-hero-desc">Transformez les idées en connaissances pratiques. Des guides étape par étape, des frameworks et de vraies stratégies pour construire de meilleures habitudes, un esprit plus sain et une vie plus intentionnelle.</p>
        <span class="guides-hero-divider"></span>
        <p class="guides-hero-tagline">De vraies connaissances pour un vous plus lumineux.</p>
      </div>
      <div class="guides-hero-img">
        <img src="/images/hero-stoic-ascent.jpg" alt="Personne gravissant un sentier de montagne à l'heure dorée" loading="eager" width="1024" height="1024" />
      </div>
    </div>
  </section>

  <!-- Featured Guide -->
  {guides[0] && (
    <section class="guides-featured">
      <div class="container">
        <p class="guide-section-label">Guide à la une</p>
        <div class="guide-featured-card">
          <Link href={`/fr/guides/${guides[0].slug}/`} class="guide-featured-img">
            <img src={guides[0].image} alt={guides[0].title} loading="eager" width="600" height="400" />
          </Link>
          <div class="guide-featured-body">
            <div class="guide-featured-meta-top">
              <span class="guide-meta-item guide-meta-topic">{guides[0].topic}</span>
              <span class="guide-meta-sep">·</span>
              <span class="guide-meta-item">{readTime(guides[0].wordCount)}</span>
            </div>
            <h2 class="guide-featured-title">
              <Link href={`/fr/guides/${guides[0].slug}/`}>{guides[0].title}</Link>
            </h2>
            <p class="guide-featured-desc">{guides[0].description}</p>
            <Link href={`/fr/guides/${guides[0].slug}/`} class="guide-read-btn">Lire le Guide →</Link>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All Guides -->
  <section class="guides-all">
    <div class="container">
      <div class="journal-section-head">
        <h2 class="journal-section-title">Tous les <em>Guides</em></h2>
        <p class="guides-count">{guides.length} {guides.length === 1 ? "guide" : "guides"}</p>
      </div>
      <div class="guides-list">
        {guides.map((g) => (
          <Link href={`/fr/guides/${g.slug}/`} class="guide-list-item">
            <div class="guide-list-thumb">
              <img src={g.image} alt={g.title} loading="lazy" width="120" height="80" />
            </div>
            <div class="guide-list-body">
              <div class="guide-list-meta-top">
                <span class="guide-meta-item guide-meta-topic">{g.topic}</span>
                <span class="guide-meta-sep">·</span>
                <span class="guide-meta-item">{readTime(g.wordCount)}</span>
              </div>
              <h3 class="guide-list-title">{g.title}</h3>
              <p class="guide-list-desc">{g.description}</p>
            </div>
            <span class="guide-list-arrow">Lire →</span>
          </Link>
        ))}
      </div>
    </div>
  </section>

</Layout>
