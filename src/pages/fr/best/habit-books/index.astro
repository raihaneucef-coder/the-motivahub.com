---
import Layout from "../../../../layouts/Layout.astro";
import Link from "../../../../components/Link.astro";
import { books } from "../../../../data/books";
import BookCard from "../../../../components/BookCard.astro";
import AffiliateBanner from "../../../../components/AffiliateBanner.astro";
import AdSlot from "../../../../components/AdSlot.astro";

const habitBooks = books.filter((b) => b.category === "HABITS" || b.category === "DISCIPLINE");
const title = "Meilleurs Livres sur les Habitudes 2026 — Motiva Hub";
const description = "Les meilleurs livres pour construire des habitudes durables et briser les mauvaises routines. Sélectionnés par l'équipe Motiva Hub.";
---

<Layout title={title} description={description} lang="fr">
  <link rel="canonical" href="https://the-motivahub.com/fr/best/habit-books/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://the-motivahub.com/best/habit-books/#article",
        "headline": title,
        "description": description,
        "image": "https://the-motivahub.com/images/hero.jpg",
        "datePublished": "2026-01-01",
        "dateModified": new Date().toISOString().split("T")[0],
        "inLanguage": "en",
        "author": { "@type": "Person", name: "Youssef Raihane", url: "https://the-motivahub.com/about/" },
        "publisher": { "@type": "Organization", name: "Motiva Hub", logo: { "@type": "ImageObject", url: "https://the-motivahub.com/logo.jpg" } },
        "mainEntityOfPage": { "@type": "WebPage", "@id": "https://the-motivahub.com/best/habit-books/" }
      },
      {
        "@type": "ItemList",
        "@id": "https://the-motivahub.com/best/habit-books/#list",
        "name": title,
        "description": description,
        "url": "https://the-motivahub.com/best/habit-books/",
        "numberOfItems": habitBooks.length,
        "itemListElement": habitBooks.map((b, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": `${b.title} by ${b.author}`,
          "url": b.affiliateUrl || `https://the-motivahub.com/books/`
        }))
      }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the best book on building habits?", "acceptedAnswer": { "@type": "Answer", "text": "Atomic Habits by James Clear is the clearest modern system for identity-based habit change." } },
      { "@type": "Question", "name": "How do I build discipline?", "acceptedAnswer": { "@type": "Answer", "text": "Discipline is built by small, repeated acts. Make the cue obvious, the action easy, the reward satisfying." } }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "The Bookstand", "item": "https://the-motivahub.com/books/" },
      { "@type": "ListItem", "position": 3, "name": "Best Habit Books", "item": "https://the-motivahub.com/best/habit-books/" }
    ]
  })} />

  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="habitBooksKicker">The Bookstand · Best Of</p>
      <h1 data-i18n-html="habitBooksTitle">Best Books on <em>Habits & Discipline</em></h1>
      <p data-i18n="habitBooksSubtitle">The systems that outlast motivation — how to make small acts compound into an unrecognisable life.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="affiliate-disclosure">
        <p><strong data-i18n="habitAffiliateHeading">Divulgation Affiliate :</strong> <span data-i18n="habitAffiliateText">En tant qu'Associé Amazon, nous gagnons des commissions sur les achats éligibles made through the Amazon links on this page. The price you pay is unchanged. We only recommend books we've personally read and found genuinely valuable — never paid placements.</span> <Link href="/fr/affiliate-disclosure/" data-i18n="habitAffiliateLink">Lire notre politique de divulgation complète →</a></p>
      </div>
      <AffiliateBanner variant="callout" lang="fr" />

      <div class="intro-block">
        <h2 data-i18n="habitWhyStack">Why habit books stack</h2>
        <p data-i18n="habitWhyStackP1">These books are not interchangeable. Atomic Habits gives you the design framework. Can't Hurt Me gives you the accountability standard. The Discipline Daily gives you the daily execution layer. Read them in that order.</p>
        <p data-i18n="habitWhyStackP2">If you want to test one habit before buying the books, read our <Link href="/fr/journal/two-minute-rule-guide/" data-i18n="habitTwoMinLink">2-Minute Rule guide</a> and the <Link href="/fr/journal/identity-based-habits-90-day-test/" data-i18n="habit90DayLink">90-day identity test</a>. For the full system, see the <Link href="/fr/guides/atomic-habits-ultimate-guide/" data-i18n="habitAtomicGuideLink">Atomic Habits ultimate guide</a>.</p>
        <p data-i18n="habitBrowseFull">Browse the full collection: <Link href="/fr/best/books/" data-i18n="habitBestBooksLink">best self-help books</a>, <Link href="/fr/best/focus-books/" data-i18n="habitBestFocusLink">best focus books</a>, and <Link href="/fr/best/stoicism-books/" data-i18n="habitBestStoicismLink">best stoicism books</a>.</p>
      </div>

      <div class="book-grid">
        {habitBooks.map((book, i) => (
          <div class="ranked-book">
            <span class="rank">#{i + 1}</span>
            <BookCard book={book} />
          </div>
        ))}
      </div>

      <AdSlot format="horizontal" />

      <AffiliateBanner variant="footer" lang="fr" />
    </div>
  </section>
</Layout>

<style>
  .affiliate-disclosure {
    max-width: 720px;
    margin: 0 auto 24px;
    padding: 16px 20px;
    background: rgba(200, 160, 74, 0.06);
    border: 1px solid rgba(200, 160, 74, 0.18);
    border-radius: 8px;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted, #666);
  }
  .affiliate-disclosure strong { color: var(--ink, #1a1a1a); }
  .affiliate-disclosure a { color: var(--gold, #c8a04a); text-decoration: underline; }

  .ranked-book { position: relative; }
  .rank {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: var(--gold, #c8a04a);
    color: var(--ink, #0e0e0e);
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 1px;
  }
  .intro-block {
    max-width: 720px;
    margin: 0 auto 48px;
    padding: 32px 28px;
    background: var(--cream, #faf7f2);
    border-left: 3px solid var(--gold, #c8a04a);
    border-radius: 0 8px 8px 0;
  }
  .intro-block h2 {
    font-family: var(--serif, Georgia, serif);
    font-size: 24px;
    margin: 0 0 16px;
    color: var(--ink, #1a1a1a);
  }
  .intro-block p {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    margin: 0 0 12px;
  }
  .intro-block strong {
    color: var(--gold, #c8a04a);
    font-weight: 600;
  }
</style>