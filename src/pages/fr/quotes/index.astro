---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
import QuoteCard from "../../../components/QuoteCard.astro";
import NewsletterSection from "../../../components/NewsletterSection.astro";
import { quotes } from "../../../data/quotes";
---

<Layout title="Citations — Motiva Hub" description="Affiches numériques. Des mots qui ont du poids — une dose quotidienne de sagesse stoïcienne et de motivation.">
  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="quotesKicker">Digital Posters</p>
      <h1 data-i18n-html="quotesTitle">Des mots qui <em>pèsent leur poids.</em></h1>
      <p data-i18n="quotesSubtitle">Minimalist typographic posters — designed to be sat with, not scrolled past.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="quotes-grid">
        {quotes.map((q) => <QuoteCard quote={q} />)}
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>