---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { getFrenchSlug } from "../../../utils/i18n";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Le Journal — Motiva Hub" description="Des essais pratiques sur le mindset, les habitudes, la discipline et le travail profond. Lis-en un. Applique une habitude aujourd'hui. Recommence.">
  <link rel="canonical" href="https://the-motivahub.com/fr/journal/" />
  <link rel="next" href="/fr/journal/page/2/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Journal Motiva Hub",
    "description": "Essais sur mindset, habitudes, discipline, productivité et travail profond.",
    "url": "https://the-motivahub.com/fr/journal/",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 20).map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://the-motivahub.com/fr/journal/${getFrenchSlug(p.id)}/`,
      "name": p.data.titleFr || p.data.title
    }))
  })} />
  <section class="page-head">
    <div class="container">
      <p class="kicker">Le Journal</p>
      <h1>Essais pour la <em>longue ascension.</em></h1>
      <p>État d'esprit, habitudes, discipline, productivité, travail profond — à lire lentement et à relire.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="journal-hero">
        <p class="journal-hero-lead">La motivation est une étincelle. La discipline est le feu.</p>
        <p class="journal-hero-sub">Le Journal Motiva Hub : des essais pratiques sur le mindset, les habitudes, la discipline et le travail profond.</p>
        <p class="journal-hero-cta">Lis-en un. Applique une habitude aujourd'hui. Recommence.</p>
      </div>

      <div class="grid" id="journal-grid">
        {posts.slice(0, 12).map((post) => (
          <ArticleCard post={post} locale="fr" />
        ))}
      </div>
      <nav class="pagination" aria-label="Pagination">
        <span class="pagination-link disabled" data-i18n="newerPagination">← Plus récents</span>
        <span class="pagination-current">Page 1 de {Math.ceil((posts.length - 1) / 12) + 1}</span>
        <a class="pagination-link" href="/fr/journal/page/2/" data-i18n="olderPagination">Plus anciens →</a>
      </nav>
    </div>
  </section>
<style>
  /* Journal hero: 3 centered lines (no images, static content, no CLS) */
  .journal-hero{max-width:780px;margin:4px auto 40px;text-align:center;}
  .journal-hero-lead{font-family:var(--serif, Georgia, serif);font-size:clamp(1.35rem, 3vw, 1.7rem);line-height:1.35;color:var(--ink, #0a0a0a);margin:0 0 12px;}
  .journal-hero-sub{font-family:var(--sans, system-ui, sans-serif);font-size:1rem;line-height:1.65;color:var(--muted, #555);margin:0 auto;max-width:640px;}
  .journal-hero-cta{font-family:var(--sans, system-ui, sans-serif);font-size:0.95rem;color:var(--gold, #c8a04a);letter-spacing:0.3px;margin:14px 0 0;}
</style>
</Layout>
