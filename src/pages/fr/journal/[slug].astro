---
import Layout from "../../../layouts/Layout.astro";
import Link from "../../../components/Link.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import RelatedArticles from "../../../components/RelatedArticles.astro";
import SocialShare from "../../../components/SocialShare.astro";
import ToolCta from "../../../components/ToolCta.astro";
import AdSlot from "../../../components/AdSlot.astro";
import NewsletterSection from "../../../components/NewsletterSection.astro";
import AffiliateBanner from "../../../components/AffiliateBanner.astro";
import BookCTA from "../../../components/BookCTA.astro";
import AuthorBio from "../../../components/AuthorBio.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import { getLangFromUrl, getPathWithoutLocale, getFrenchSlug, getEnglishSlug } from "../../../utils/i18n";
import { getImageDimensions } from "../../../utils/image";
import frSlugs from "../../../i18n/slugs-fr.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  
  for (const post of posts) {
    if (post.data.draft) continue;
    
    const enSlug = post.id;
    const frSlug = getFrenchSlug(enSlug);
    
    // FR version - always generate, using FR slug if different
    paths.push({
      params: { slug: frSlug },
      props: { post, locale: 'fr' },
    });
  }
  
  return paths;
}

const { post, locale } = Astro.props;
const coverDims = await getImageDimensions(post.data.image);
const currentLocale = locale || getLangFromUrl(Astro.url);

// FR translations for article bodies (public/i18n/articles-fr.json), parsed once per build.
const G = globalThis as { __motivaFrArticles?: Record<string, string> };
const frArticles = (G.__motivaFrArticles ??= JSON.parse(
  readFileSync(join(process.cwd(), "public", "i18n", "articles-fr.json"), "utf-8")
));

// GitHub-style slugger with per-page dedup, shared by heading ids and the TOC
// so every TOC link always matches an id on the same page.
const usedSlugs = new Map<string, number>();
function frSlugify(text: string): string {
  let base = text
    .replace(/&[a-z]+;/g, "")
    .replace(/<[^>]*>/g, "")
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, "")
    .trim()
    .replace(/\s+/g, "-");
  if (!base) base = "section";
  const n = usedSlugs.get(base) ?? 0;
  usedSlugs.set(base, n + 1);
  return n === 0 ? base : `${base}-${n}`;
}

// Assign ids to the French h2/h3 and collect the TOC entries from the same
// pass (Astro's render().headings cannot see headings inside raw-HTML blocks,
// so the TOC never rendered before).
const frHeadings: { depth: number; slug: string; text: string }[] = [];
function injectFrIds(html: string): string {
  return html.replace(
    /<h([23])>([\s\S]*?)<\/h\1>/g,
    (_m: string, lvl: string, inner: string) => {
      const text = inner.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
      const slug = frSlugify(text);
      frHeadings.push({ depth: Number(lvl), slug, text });
      return `<h${lvl} id="${slug}">${inner}</h${lvl}>`;
    }
  );
}

// Give the English original the SAME ids (by heading order) so the EN toggle
// keeps the TOC anchors working. The result is escaped for safe storage in
// the data-en-html attribute — the id pass used to run over the attribute
// content as well, injecting raw quotes that broke the markup and leaked
// every English heading as visible text above its French twin.
function injectEnIds(html: string, slugs: string[]): string {
  let i = 0;
  return html.replace(
    /<h([23])>([\s\S]*?)<\/h\1>/g,
    (_m: string, lvl: string, inner: string) => {
      const text = inner.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
      const slug = slugs[i] ?? frSlugify(text);
      i++;
      return `<h${lvl} id="${slug}">${inner}</h${lvl}>`;
    }
  );
}

// Replace each <div data-i18n-html="article_slug_pN">…</div> inner HTML with the French
// value at build time. Uses a balanced-tag scan (not naive regex) because 11 divs contain
// nested <div> blocks. Falls back to the English inner HTML when a key is missing.
function frSwapDivs(src: string): string {
  const pieces: string[] = [];
  let cursor = 0;
  for (const m of src.matchAll(/<div data-i18n-html="(article_[^"]+)">/g)) {
    const innerStart = m.index + m[0].length;
    const scan = /<div\b|<\/div>/g;
    scan.lastIndex = innerStart;
    let depth = 1;
    let endIdx = -1;
    let s: RegExpExecArray | null;
    while ((s = scan.exec(src)) !== null) {
      if (s[0] === "</div>") {
        depth--;
        if (depth === 0) {
          endIdx = s.index;
          break;
        }
      } else {
        depth++;
      }
    }
    if (endIdx === -1) break; // malformed markup: keep the rest verbatim
    const inner = src.slice(innerStart, endIdx);
    const fr = frArticles[m[1]];
    // French body with heading ids; the English original keeps the same ids
    // and is stored escaped in data-en-html for the client-side EN/FR
    // toggle (the DOM now starts in French).
    const frHtml = injectFrIds(fr != null ? fr : inner);
    const enSlugs = Array.from(frHtml.matchAll(/<h[23] id="([^"]+)">/g), (s) => s[1]);
    const enEsc = injectEnIds(inner, enSlugs).replace(/&/g, "&amp;").replace(/"/g, "&quot;");
    const openTag = `<div data-i18n-html="${m[1]}" data-en-html="${enEsc}">`;
    pieces.push(src.slice(cursor, m.index), openTag, frHtml, "</div>");
    cursor = endIdx + "</div>".length;
  }
  pieces.push(src.slice(cursor));
  return pieces.join("");
}

// Render the French body server-side; the final pass is a safety net that
// only reaches h2/h3 living outside the i18n divs (everything inside them
// already carries ids and the escaped attribute content no longer matches).
const proseHtml = frSwapDivs(post.body).replace(
  /<h([23])>([\s\S]*?)<\/h\1>/g,
  (_m: string, lvl: string, inner: string) => {
    const text = inner.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
    const slug = frSlugify(text);
    frHeadings.push({ depth: Number(lvl), slug, text });
    return `<h${lvl} id="${slug}">${inner}</h${lvl}>`;
  }
);

const all = (await getCollection("blog")).filter((p) => !p.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const enSlug = getEnglishSlug(post.id);
const idx = all.findIndex((p) => p.id === enSlug);
const prev = all[idx + 1];
const next = all[idx - 1];

function scoreRelated(p: any): number {
  if (p.id === post.id) return -1;
  let s = 0;
  if (p.data.topic.toLowerCase() === post.data.topic.toLowerCase()) s += 5;
  const postWords = post.data.title.toLowerCase().split(/\W+/).filter((w: string) => w.length > 4);
  const pWords = p.data.title.toLowerCase().split(/\W+/).filter((w: string) => w.length > 4);
  const shared = postWords.filter((w: string) => pWords.includes(w)).length;
  s += shared;
  if (post.data.description && p.data.description) {
    const d1 = post.data.description.toLowerCase();
    const d2 = p.data.description.toLowerCase();
    const d1Words = d1.split(/\W+/).filter((w: string) => w.length > 5);
    const dShared = d1Words.filter((w: string) => d2.includes(w)).length;
    s += dShared * 0.5;
  }
  return s;
}

const scored = all
  .map((p) => ({ post: p, score: scoreRelated(p) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4);
const related = scored.length >= 1 ? scored.map((x) => x.post) : all.filter((p) => p.id !== post.id).slice(0, 4);
const relatedPosts = related.slice(0, 4);

const postLang = currentLocale;
const displayTitle = currentLocale === "fr" && post.data.titleFr ? post.data.titleFr : post.data.title;
const displayDesc = currentLocale === "fr" && post.data.descriptionFr ? post.data.descriptionFr : post.data.description;
const isReviewPost = /review|revue|test/i.test(post.id) || /review|revue/i.test(post.data.topic) || post.data.topic.toLowerCase() === "books";
---

<Layout title={`${displayTitle} — Motiva Hub`} description={displayDesc} image={post.data.image} ogType="article" lang={postLang}>
  <meta slot="head" property="article:published_time" content={post.data.pubDate.toISOString()} />
  <meta slot="head" property="article:modified_time" content={(post.data.updatedDate || post.data.pubDate).toISOString()} />
  <meta slot="head" name="keywords" content={(post.data.keywords || []).join(", ")} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: displayTitle,
    description: displayDesc,
    image: post.data.image.startsWith("http") ? post.data.image : `https://the-motivahub.com${post.data.image}`,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
    inLanguage: postLang,
    keywords: (post.data.keywords || []).join(", "),
    articleSection: post.data.topic,
    wordCount: post.data.wordCount || 0,
    author: { "@type": "Person", "name": "Youssef Raihane", "url": "https://the-motivahub.com/about/" },
    publisher: { "@type": "Organization", "name": "Motiva Hub", "logo": { "@type": "ImageObject", "url": "https://the-motivahub.com/logo.jpg" } },
    mainEntityOfPage: { "@type": "WebPage", "@id": `https://the-motivahub.com/journal/${post.id}/` }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "Journal", "item": "https://the-motivahub.com/journal/" },
      { "@type": "ListItem", "position": 3, "name": displayTitle, "item": `https://the-motivahub.com/journal/${post.id}/` }
    ]
  })} />
  {isReviewPost && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Review",
      "itemReviewed": {
        "@type": "Book",
        "name": displayTitle.replace(/^(Book Review|Test|Review|Revue):?\s*/i, "").replace(/[—–-]\s*(review|revue|test|complete|complète).*$/i, "").trim()
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      },
      "author": { "@type": "Person", "name": "Youssef Raihane", "url": "https://the-motivahub.com/about/" },
      "publisher": { "@type": "Organization", "name": "Motiva Hub" },
      "datePublished": post.data.pubDate.toISOString(),
      "inLanguage": postLang
    })} />
  )}
  {post.data.faq && post.data.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": postLang,
      "mainEntity": post.data.faq.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  )}
  <article>
    <header class="article-header">
      <div class="container">
        <p class="card-meta"><span data-i18n={`topic-${post.data.topic.toLowerCase()}`}>{post.data.topic.toUpperCase()}</span> · {post.data.readTime}</p>
        <h1 data-i18n={`article_${post.id}_title`} data-en-text={post.data.title}>{displayTitle}</h1>
        <p class="card-date">{post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
        <img class="article-img" src={post.data.image} alt={post.data.imageAlt || post.data.title} width={coverDims.width} height={coverDims.height} fetchpriority="high" />
      </div>
    </header>

    <div class="article-body container">
      {isReviewPost && <AffiliateBanner variant="callout" lang={postLang} />}
      <TableOfContents headings={frHeadings} />
      <div class="prose" data-ssr-fr="1" set:html={proseHtml} />
      {post.data.bookSlug && <BookCTA bookSlug={post.data.bookSlug} variant="primary" />}
      <AdSlot format="horizontal" />
      <ToolCta topic={post.data.topic} />
      {isReviewPost && <AffiliateBanner variant="footer" lang={postLang} />}
      <SocialShare title={displayTitle} description={displayDesc} />
      <AuthorBio variant="compact" showSchema={false} />
      <div class="article-nav">
        {prev ? <a class="link-ochre" href={`/journal/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}
        <a class="link-ochre" href="/journal/" data-i18n="returnToJournal">Return to Journal</a>
        {next ? <a class="link-ochre" href={`/journal/${next.id}/`}>{next.data.title} →</a> : <span></span>}
      </div>
    </div>
  </article>

  <RelatedArticles>
    {relatedPosts.map((p) => <ArticleCard post={p} locale="fr" />)}
  </RelatedArticles>
  <NewsletterSection />
</Layout>
