---
import Layout from "../../../../layouts/Layout.astro";
import ArticleCard from "../../../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { getFrenchSlug } from "../../../../utils/i18n";

export async function getStaticPaths({ paginate }: any) {
  const posts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props as any;
const totalPages = page.lastPage;
const isFirst = page.currentPage === 1;
const prevHref = page.url.prev;
const nextHref = page.url.next;
---

<Layout title={`Le Journal · Page ${page.currentPage} — Motiva Hub`} description={`Page ${page.currentPage} sur ${totalPages} — Articles pratiques sur le mindset, les habitudes, la discipline et le travail profond.`} canonical={isFirst ? "https://the-motivahub.com/fr/journal/" : undefined}>
  {isFirst && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Journal Motiva Hub",
      "description": "Essais sur mindset, habitudes, discipline, productivité et travail profond.",
      "url": "https://the-motivahub.com/fr/journal/",
      "numberOfItems": page.total,
      "itemListElement": page.data.slice(0, 20).map((p: any, i: number) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://the-motivahub.com/fr/journal/${getFrenchSlug(p.id)}/`,
        "name": p.data.titleFr || p.data.title
      }))
    })} />
  )}
  {!isFirst && <link rel="prev" href={prevHref} />}
  {page.url.next && <link rel="next" href={nextHref} />}

  <section class="journal-page-head">
    <div class="container">
      <p class="journal-hero-eyebrow">Pensées. Idées. Progrès.</p>
      <h1 class="journal-hero-title" style="font-size:clamp(2rem,4vw,3rem);">Le <em>Journal</em></h1>
      <p class="journal-hero-desc">Page {page.currentPage} sur {totalPages} · {page.total} articles au total</p>
    </div>
  </section>

  <section class="journal-full-grid">
    <div class="container">
      <div class="grid">
        {page.data.map((post: any) => <ArticleCard post={post} locale="fr" />)}
      </div>

      <nav class="pagination" aria-label="Pagination">
        {prevHref ? <a class="pagination-link" href={prevHref} data-i18n="newerPagination">← Plus récents</a> : <span class="pagination-link disabled" data-i18n="newerPagination">← Plus récents</span>}
        <span class="pagination-current">Page {page.currentPage} sur {totalPages}</span>
        {nextHref ? <a class="pagination-link" href={nextHref} data-i18n="olderPagination">Plus anciens →</a> : <span class="pagination-link disabled" data-i18n="olderPagination">Plus anciens →</span>}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .journal-page-head {
    padding: clamp(100px, 14vh, 140px) 0 clamp(24px, 4vh, 40px);
  }
  .journal-page-head .journal-hero-desc { margin-top: 8px; }
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 56px 0 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line, #2a2a2a);
    font-family: var(--sans);
    font-size: 14px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pagination-link {
    color: #ff4d00;
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 16px;
    border: 1px solid var(--line, #2a2a2a);
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }
  .pagination-link:hover { border-color: #ff4d00; }
  .pagination-link.disabled { color: #666; cursor: not-allowed; opacity: 0.5; }
  .pagination-current { color: #888; font-size: 13px; }
</style>
