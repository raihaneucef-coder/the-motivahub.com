---
import Layout from "../../../../layouts/Layout.astro";
import ArticleCard from "../../../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { getFrenchSlug } from "../../../../utils/i18n";

export async function getStaticPaths({ paginate }: any) {
  const posts = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props as any;
const totalPages = page.lastPage;
const isFirst = page.currentPage === 1;
const prevHref = page.url.prev;
const nextHref = page.url.next;
---

<Layout title={`Le Journal · Page ${page.currentPage} — Motiva Hub`} description={`Page ${page.currentPage} sur ${totalPages} — Essais pour la longue ascension.`}>
  {isFirst && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Journal Motiva Hub",
      "description": "Essais sur mindset, habitudes, discipline, productivité et travail profond.",
      "url": "https://the-motivahub.com/fr/journal/",
      "numberOfItems": page.total,
      "itemListElement": page.data.slice(0, 20).map((p: any, i: number) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://the-motivahub.com/fr/journal/${getFrenchSlug(p.id)}/`,
        "name": p.data.titleFr || p.data.title
      }))
    })} />
  )}
  <link rel="canonical" href={`https://the-motivahub.com/fr/journal/${isFirst ? "" : `page/${page.currentPage}/`}`} />
  {!isFirst && <link rel="prev" href={prevHref} />}
  {page.url.next && <link rel="next" href={nextHref} />}

  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="journalKicker">Le Journal</p>
      <h1 data-i18n-html="journalTitle">Essais pour la <em>longue ascension.</em></h1>
      <p><span data-i18n="pageLabel">Page</span> {page.currentPage} <span data-i18n="ofLabel">sur</span> {totalPages} · {page.total} <span data-i18n="essaysTotal">essais au total</span></p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="grid">
        {page.data.map((post: any) => <ArticleCard post={post} locale="fr" />)}
      </div>

      <nav class="pagination" aria-label="Pagination">
        {prevHref ? <a class="pagination-link" href={prevHref} data-i18n="newerPagination">← Plus récents</a> : <span class="pagination-link disabled" data-i18n="newerPagination">← Plus récents</span>}
        <span class="pagination-current">Page {page.currentPage} sur {totalPages}</span>
        {nextHref ? <a class="pagination-link" href={nextHref} data-i18n="olderPagination">Plus anciens →</a> : <span class="pagination-link disabled" data-i18n="olderPagination">Plus anciens →</span>}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 56px 0 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line, #e5e5e5);
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pagination-link {
    color: var(--gold, #c8a04a);
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 16px;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }
  .pagination-link:hover { border-color: var(--gold, #c8a04a); }
  .pagination-link.disabled {
    color: var(--muted, #999);
    cursor: not-allowed;
    opacity: 0.5;
  }
  .pagination-current {
    color: var(--muted, #666);
    font-size: 13px;
  }
</style>
