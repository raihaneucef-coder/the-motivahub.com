---
import Layout from "../../../../layouts/Layout.astro";

const title = "30 Jours de Discipline — PDF Gratuit — Motiva Hub";
const description = "Téléchargez gratuitement le PDF 30 Jours de Discipline. Un guide quotidien pour construire des habitudes durables et transformer votre mentalité.";
const canonical = "https://the-motivahub.com/fr/pdf/30-days-discipline/";

const benefits = [
  { icon: "📄", title: "Une page par jour", text: "30 jours, 30 pages. Pas de submersion. Lisez 1 page le matin, faites l'action de 2 minutes, répondez à la question de réflexion." },
  { icon: "🧪", title: "Fondé sur la recherche", text: "Construit sur Lally (2009), Wood (2007), Clear (2018) et 8 ans de pratique personnelle. Pas de la motivation — un système." },
  { icon: "⏱️", title: "5 minutes au total", text: "Affirmation + micro-action de 2 min + 1 question de réflexion. Tenable même le pire de vos jours." },
  { icon: "🪞", title: "Changement d'identité", text: "Au jour 30, vous n'êtes plus quelqu'un qui recommence sans cesse. Vous êtes celui qui a terminé." },
];

const weeklyThemes = [
  { week: 1, title: "Fondations", focus: "Auditer, simplifier, choisir 2-3 priorités" },
  { week: 2, title: "Identité", focus: "Devenir quelqu'un qui fait l'action" },
  { week: 3, title: "Systèmes", focus: "Aménager l'environnement pour réussir" },
  { week: 4, title: "Résilience", focus: "Rebondir après les ratés inévitables" },
  { week: 5, title: "Corps", focus: "10 pompes, eau froide, marche, sommeil" },
  { week: 6, title: "Direction", focus: "Bilan, héritage, mentor, les 30 prochains" },
];

const faq = [
  { q: "Quand le PDF sera-t-il prêt ?", a: "Nous finalisons la version définitive sur Canva. Les abonnés le reçoivent dès sa sortie — en général sous 2 semaines. Vous serez premier de la liste, avant la publication publique." },
  { q: "Est-il vraiment gratuit ?", a: "Oui. 100 % gratuit, sans paywall, sans vente additionnelle. Nous pourrons ajouter des liens affiliate dans la section « livres recommandés » (clairement indiqués), mais le PDF central reste et restera gratuit." },
  { q: "Ai-je besoin d'une imprimante ?", a: "Non. Le PDF fonctionne sur n'importe quelle tablette avec annotation (GoodNotes, Notability), ou vous pouvez l'utiliser en numérique et taper vos réflexions." },
  { q: "En quoi est-ce différent d'Atomic Habits ou d'autres livres ?", a: "Un rien peut tout changer est un livre à lire. Ici, c'est un programme de 30 jours à faire. Le contenu s'inspire d'Atomic Habits, Slow Productivity, Deep Work et de 8 ans de pratique personnelle — mais organisé en protocole quotidien, pas en théorie." },
  { q: "Et si je rate un jour ?", a: "Le protocole est conçu pour ça. Le principe : ne jamais rater deux fois. Si vous sautez un jour, reprenez le lendemain. La semaine 4 est dédiée à la résilience — exactement à cela." },
];
---

<Layout title={title} description={description} image="/images/youssef-raihane.jpg">
  <link rel="canonical" href={canonical} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a }
    }))
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonical + "#webpage",
    "name": title,
    "description": description,
    "inLanguage": "fr",
  })} />

  <section class="pdf-head">
    <div class="container">
      <p class="kicker" data-i18n="pdfKicker">PDF Gratuit · 32 Pages · Disponible dans 2 semaines</p>
      <h1 data-i18n-html="pdfTitle">30 Jours de <em>Discipline</em></h1>
      <p class="pdf-subtitle" data-i18n-html="pdfSubtitle"><em>Le PDF de pratique quotidienne qui transforme la motivation en système. Une page par jour. 2 minutes chaque matin. Gratuit pour toujours.</em></p>
    </div>
  </section>

  <section class="pdf-coming-soon">
    <div class="container">
      <div class="coming-soon-box">
        <p class="coming-soon-label" data-i18n="pdfStatusLabel">📦 Statut</p>
        <h2 class="coming-soon-title" data-i18n="pdfStatusTitle">Le PDF est en cours de création dans Canva</h2>
        <p class="coming-soon-text" data-i18n="pdfStatusText">Nous fabriquons chaque page à la main — typographie, mise en page, prompts, micro-actions. La version finale sera prête à imprimer (A4) et adaptée au numérique (tablette). Abonnez-vous ci-dessous pour le recevoir dès sa publication.</p>
        <form class="notify-form" id="notify-form" novalidate>
          <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" data-i18n-placeholder="pdfNotifyPlaceholder">
          <button type="submit" class="btn-pill btn-pill-cream" data-i18n="pdfNotifyButton">Prévenez-moi quand il sera disponible</button>
        </form>
        <p class="notify-note" id="notify-note" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <section class="pdf-content">
    <div class="container">
      <div class="pdf-info">
        <h2 data-i18n="pdfWhatsInside">Ce qu'il contient (aperçu)</h2>
        <p data-i18n-html="pdfInsideText">Ce n'est pas un livre de motivation. C'est un <strong>système</strong>. Pendant 30 jours, vous avancerez à travers six thèmes hebdomadaires, complèterez des exercices quotidiens et suivrez vos progrès sur une page imprimable. Au jour 30, vous aurez posé les fondations d'un système de discipline qui survit aux mauvais jours.</p>

        <h2 data-i18n="pdfReasonsTitle">4 raisons pour lesquelles cela fonctionne</h2>
        <div class="benefits-grid">
          {benefits.map((b) => (
            <div class="benefit-card">
              <p class="benefit-icon">{b.icon}</p>
              <h3 class="benefit-title">{b.title}</h3>
              <p class="benefit-text">{b.text}</p>
            </div>
          ))}
        </div>

        <h2 data-i18n="pdfWeeksTitle">6 thèmes hebdomadaires (la structure)</h2>
        <div class="weeks-grid">
          {weeklyThemes.map((w) => (
            <div class="week-card">
              <p class="week-label">Semaine {w.week}</p>
              <h3 class="week-title">{w.title}</h3>
              <p class="week-focus">{w.focus}</p>
            </div>
          ))}
        </div>

        <h2 data-i18n="pdfHowTitle">Comment vous l'utiliserez (5 min/jour)</h2>
        <ol class="how-to">
          <li><strong data-i18n="pdfMorningRitual">Rituel du matin :</strong> Lisez la page du jour. Café, eau, silence.</li>
          <li><strong data-i18n="pdfAffirmation">Affirmation :</strong> Lisez l'affirmation du jour à voix haute. Laissez-la poser.</li>
          <li><strong data-i18n="pdfMicroAction">Micro-action (2 min) :</strong> Faites la petite action du jour. Mettez un minuteur. Arrêtez à 2 min.</li>
          <li><strong data-i18n="pdfReflection">Réflexion (1 min) :</strong> Répondez à 1 question. Dans votre tête, dans un journal, sur la page.</li>
          <li><strong data-i18n="pdfCloseGo">Fermez et avancez :</strong> Fermez le PDF. Vivez votre journée.</li>
        </ol>

        <h2 data-i18n="pdfDaySampleTitle">Le protocole quotidien (exemple — Jour 7)</h2>
        <div class="day-sample">
          <p class="day-title" data-i18n="pdfDay7Title">Jour 7 — Le rituel des 2 minutes</p>
          <ol>
            <li><strong data-i18n="pdfSampleAffirmation">Affirmation :</strong> « Deux minutes, c'est la porte. Je l'ouvre chaque jour. »</li>
            <li><strong data-i18n="pdfSampleMicroAction">Micro-action (2 min) :</strong> Faites la nouvelle habitude pendant 2 minutes. Mettez un minuteur. Arrêtez à 2 min — pas plus.</li>
            <li><strong data-i18n="pdfSampleReflection">Réflexion :</strong> « Qu'est-ce que j'avais envie de faire au-delà des 2 minutes ? »</li>
          </ol>
          <p data-i18n="pdfTotalTime">Durée totale : 5 minutes. Tenable même le pire de vos jours.</p>
        </div>

        <div class="related-tools">
          <h2 data-i18n="pdfRelatedTitle">Outils à utiliser avec le PDF</h2>
          <div class="related-grid">
            <a class="related-card" href="/fr/tools/discipline-quiz/">
              <p class="related-name">🎯 Quiz du type discipline</p>
              <p class="related-desc">Trouvez votre archétype (Bâtisseur, Sprinter, Marathonien, Stratège) — 2 minutes</p>
            </a>
            <a class="related-card" href="/fr/tools/habit-stacker/">
              <p class="related-name">🧱 Générateur de chaînes d'habitudes</p>
              <p class="related-desc">Construisez votre chaîne quotidienne avec la formule d'Atomic Habits — 2 minutes</p>
            </a>
            <a class="related-card" href="/fr/journal/identity-based-habits-90-day-test/">
              <p class="related-name">📖 Objectifs identitaires</p>
              <p class="related-desc">Le principe plus profond derrière le protocole — lecture de 9 minutes</p>
            </a>
            <a class="related-card" href="/fr/tools/meditation-timer/">
              <p class="related-name">🧘 Minuteur de méditation</p>
              <p class="related-desc">Carillons audio web. Séances de 2 minutes pour démarrer la journée.</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pdf-faq">
    <div class="container">
      <h2 data-i18n="pdfFaqTitle">Questions fréquentes</h2>
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="pdf-cta-final">
    <div class="container">
      <h2 data-i18n="pdfCtaTitle">The PDF is almost ready</h2>
      <p data-i18n="pdfCtaText">Subscribe above to be first in line. We'll email you the moment it ships — usually within 2 weeks.</p>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('notify-form');
    const note = document.getElementById('notify-note');
    const getT = () => {
      const lang = localStorage.getItem("lang") || "en";
      return window.i18nDict?.[lang] || window.i18nDict?.en || {};
    };
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = String(new FormData(form).get('email') || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      const originalText = form.querySelector('button').textContent;
      const t = getT();
      if (!emailOk) {
        note.textContent = t.daysEmailError || 'Please enter a valid email address.';
        note.style.color = '#c0392b';
        return;
      }
      form.querySelector('button').textContent = t.daysSending || 'Saving...';
      form.querySelector('button').disabled = true;
      try {
        const res = await fetch('https://formsubmit.co/ajax/' + 'raihaneucef@gmail.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'pdf/30-days-discipline (notify-me)',
            page: window.location.pathname,
            _subject: '🔔 PDF notify signup — 30 Days of Discipline',
            _template: 'table'
          })
        });
        if (res.ok) {
          note.textContent = t.daysThanks || "🎉 You're on the list. We'll email you the moment the PDF ships.";
          note.style.color = '#c8a04a';
          form.reset();
        } else throw new Error('failed');
      } catch (err) {
        note.textContent = t.daysSomethingWrong || '⚠️ Something went wrong. Email us at contact@the-motivahub.com';
        note.style.color = '#c0392b';
      } finally {
        form.querySelector('button').textContent = originalText;
        form.querySelector('button').disabled = false;
      }
    });
  })();
</script>

<style>
  .pdf-head { padding: 80px 0 32px; text-align: center; }
  .pdf-subtitle { max-width: 720px; margin: 24px auto 0; font-size: 18px; color: var(--muted); line-height: 1.6; }

  .pdf-coming-soon { padding: 32px 0 48px; }
  .coming-soon-box { max-width: 640px; margin: 0 auto; padding: 40px 32px; background: linear-gradient(180deg, rgba(200, 160, 74, 0.08), rgba(200, 160, 74, 0.02)); border: 1px solid rgba(200, 160, 74, 0.25); border-radius: 16px; text-align: center; }
  .coming-soon-label { font-family: var(--sans, system-ui, sans-serif); font-size: 11px; letter-spacing: 2px; color: var(--gold, #c8a04a); margin: 0 0 12px; font-weight: 700; }
  .coming-soon-title { font-family: var(--serif, Georgia, serif); font-size: 26px; font-weight: 600; color: var(--ink, #1a1a1a); margin: 0 0 16px; line-height: 1.3; }
  .coming-soon-text { font-size: 15px; line-height: 1.6; color: var(--muted, #666); margin: 0 0 24px; }

  .notify-form { display: flex; gap: 8px; max-width: 480px; margin: 0 auto; flex-wrap: wrap; }
  .notify-form input { flex: 1; min-width: 200px; padding: 14px 18px; border: 1px solid var(--line, #e5e5e5); border-radius: 8px; font-family: var(--sans, system-ui, sans-serif); font-size: 15px; }
  .notify-form input:focus { outline: 2px solid var(--gold, #c8a04a); outline-offset: 2px; }
  .notify-note { margin: 12px 0 0; font-family: var(--sans, system-ui, sans-serif); font-size: 14px; min-height: 20px; }

  .pdf-content { padding: 32px 0 64px; }
  .pdf-info { max-width: 720px; margin: 0 auto; font-family: var(--sans, system-ui, sans-serif); line-height: 1.7; color: var(--ink, #1a1a1a); }
  .pdf-info h2 { font-family: var(--serif, Georgia, serif); font-size: 28px; margin: 48px 0 20px; }
  .pdf-info p { margin: 0 0 20px; font-size: 16px; }

  .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin: 24px 0 32px; }
  .benefit-card { padding: 24px; background: var(--cream, #faf7f2); border: 1px solid var(--line, #e5e5e5); border-radius: 12px; }
  .benefit-icon { font-size: 28px; margin: 0 0 12px; line-height: 1; }
  .benefit-title { font-family: var(--serif, Georgia, serif); font-size: 18px; font-weight: 600; color: var(--ink, #1a1a1a); margin: 0 0 8px; }
  .benefit-text { font-family: var(--sans, system-ui, sans-serif); font-size: 14px; line-height: 1.6; color: var(--muted, #666); margin: 0; }

  .weeks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 24px 0 32px; }
  .week-card { padding: 20px; background: var(--cream, #faf7f2); border: 1px solid var(--line, #e5e5e5); border-radius: 12px; }
  .week-label { font-family: var(--sans, system-ui, sans-serif); font-size: 11px; letter-spacing: 2px; color: var(--gold, #c8a04a); margin: 0 0 8px; font-weight: 700; }
  .week-title { font-family: var(--serif, Georgia, serif); font-size: 20px; font-weight: 600; color: var(--ink, #1a1a1a); margin: 0 0 8px; }
  .week-focus { font-family: var(--sans, system-ui, sans-serif); font-size: 13px; color: var(--muted, #666); margin: 0; }

  .how-to { padding-left: 20px; }
  .how-to li { padding: 8px 0; font-size: 15px; }

  .day-sample { padding: 24px; background: var(--cream, #faf7f2); border-left: 3px solid var(--gold, #c8a04a); border-radius: 0 12px 12px 0; margin: 24px 0; }
  .day-title { font-family: var(--serif, Georgia, serif); font-size: 20px; font-weight: 600; color: var(--ink, #1a1a1a); margin: 0 0 12px; }
  .day-sample ol { padding-left: 20px; margin: 0 0 16px; }
  .day-sample ol li { padding: 4px 0; font-size: 14px; }
  .day-sample p { font-size: 14px; color: var(--muted, #666); margin: 12px 0 0; }

  .related-tools { margin: 48px 0; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .related-card { padding: 20px; background: var(--white, #fff); border: 1px solid var(--line, #e5e5e5); border-radius: 12px; text-decoration: none; transition: border-color 0.2s ease; }
  .related-card:hover { border-color: var(--gold, #c8a04a); }
  .related-name { font-family: var(--sans, system-ui, sans-serif); font-size: 15px; font-weight: 600; color: #1a1a1a; margin: 0 0 6px; }
  .related-desc { font-family: var(--sans, system-ui, sans-serif); font-size: 13px; color: #555555; margin: 0; }

  .pdf-faq { padding: 64px 0; background: var(--cream, #faf7f2); }
  .pdf-faq h2 { font-family: var(--serif, Georgia, serif); font-size: 28px; text-align: center; margin: 0 0 32px; color: var(--ink, #1a1a1a); }
  .pdf-faq details { max-width: 720px; margin: 0 auto 16px; background: var(--white, #fff); border: 1px solid var(--line, #e5e5e5); border-radius: 12px; padding: 16px 20px; }
  .pdf-faq summary { cursor: pointer; font-family: var(--sans, system-ui, sans-serif); font-size: 15px; font-weight: 600; color: #1a1a1a; list-style: none; }
  .pdf-faq summary::-webkit-details-marker { display: none; }
  .pdf-faq details[open] summary::before { content: "▾ "; color: var(--gold); }
  .pdf-faq details summary::before { content: "▸ "; color: var(--gold); }
  .pdf-faq details p { margin: 12px 0 0; line-height: 1.6; color: var(--ink, #1a1a1a); }

  .pdf-cta-final { padding: 64px 0; text-align: center; }
  .pdf-cta-final h2 { font-family: var(--serif, Georgia, serif); font-size: 36px; margin: 0 0 16px; color: var(--ink, #1a1a1a); }
  .pdf-cta-final p { max-width: 540px; margin: 0 auto 32px; color: var(--muted, #666); font-size: 16px; }

  .btn-pill { display: inline-block; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 15px; cursor: pointer; border: none; }
  .btn-pill-cream { background: var(--gold, #c8a04a); color: #0e0e0e; }
  .btn-pill-cream:hover { background: #b8965a; }
</style>