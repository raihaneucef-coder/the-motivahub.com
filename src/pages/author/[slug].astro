---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return [{ params: { slug: "youssef-raihane" }, props: { slug: "youssef-raihane", name: "Youssef Raihane", title: "Founder & Editor-in-Chief" } }];
}

const { slug } = Astro.params;
const author = Astro.props ?? { slug: "youssef-raihane", name: "Youssef Raihane", title: "Founder & Editor-in-Chief" };
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 12);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `https://the-motivahub.com/author/${author.slug}/#person`,
  name: author.name,
  jobTitle: author.title,
  worksFor: { "@type": "Organization", name: "Motiva Hub", url: "https://the-motivahub.com" },
  url: `https://the-motivahub.com/author/${author.slug}/`,
  image: "https://the-motivahub.com/images/youssef-raihane.jpg",
  description: "Founder of Motiva Hub. 8 years applied practice in habits, focus, stoicism, performance. Writes from practice — not theory.",
  knowsAbout: ["Habits", "Discipline", "Stoicism", "Deep Work", "Productivity", "Mental Models", "Focus", "Goal Setting", "Performance Psychology", "Behavior Change"],
  sameAs: ["https://www.linkedin.com/in/youssefraihane/", "https://www.instagram.com/uce__f/", "https://www.facebook.com/youssefraihane/"],
  foundingDate: "2025",
  award: ["Top 10 Personal Development Sites (niche, 2026)"],
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://the-motivahub.com/" },
    { "@type": "ListItem", position: 2, name: author.name, item: `https://the-motivahub.com/author/${author.slug}/` },
  ],
};
---

<Layout title={`${author.name} — Founder of Motiva Hub`} description={`Founder of Motiva Hub. 8 years applied practice in habits, focus, stoicism, performance. Writes from practice — not theory.`} image="/images/youssef-raihane.jpg">
  <link rel="canonical" href={`https://the-motivahub.com/author/${author.slug}/`} />
  <link rel="author" href={`https://the-motivahub.com/author/${author.slug}/`} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="authorKicker">The Person Behind The Words</p>
      <h1>{author.name}</h1>
      <p data-i18n="authorSubtitle">Founder & Editor-in-Chief of Motiva Hub. Building a sanctuary for the disciplined mind — one idea at a time.</p>
    </div>
  </section>

  <section class="author-section">
    <div class="container">
      <div class="author-grid">
        <div class="author-photo-wrap">
          <div class="author-photo">
            <img src="/images/yr-640.jpg" srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w, /images/yr-1024.jpg 1024w" sizes="(max-width: 720px) 200px, 240px" alt={author.name} width="240" height="240" loading="eager" fetchpriority="high" />
          </div>
        </div>
        <div class="author-bio-content">
          <p class="kicker" data-i18n="authorPromise">My Promise To You</p>
          <h2 data-i18n="authorPromiseTitle">I write what I built.</h2>
          <p data-i18n="authorBioText1">Motiva Hub is not a content farm. It is a daily practice, written in public, edited in private, and tested in my own life before it reaches yours.</p>
          <p data-i18n="authorBioText2">I started this site in 2025 after a decade of reading the same five books on habits, focus, and discipline — and noticing that nobody was turning them into a daily, edible practice.</p>
          <p data-i18n-html="authorBioText3">Eight years into building systems for myself — discipline rituals, focus stacks, sleep protocols — I can tell you one thing: <strong>motivation is a visitor, discipline is a resident</strong>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .author-grid { display: grid; grid-template-columns: 280px 1fr; gap: 56px; align-items: start; }
  .author-photo { width: 100%; max-width: 240px; aspect-ratio: 1; overflow: hidden; border-radius: 50%; border: 3px solid var(--gold, #c8a04a); margin: 0 auto 24px; }
  .author-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-bio-content p { font-family: var(--serif, Georgia, serif); font-size: 1.0625rem; line-height: 1.7; color: var(--muted); margin: 0 0 18px; }
  .author-bio-content h2 { font-family: var(--serif, Georgia, serif); font-size: 36px; font-weight: 600; margin: 8px 0 24px; color: var(--ink, #1a1a1a); line-height: 1.2; }
  @media (max-width: 768px) { .author-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
