---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../../components/ArticleCard.astro";

// Verified identity facts only (see Phase 8 audit): founder since 2025,
// writer of the Journal, the real book-failure origin story.
// No awards, no credentials, no audience numbers, no social links
// until they are confirmed as real.
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 12);

const essayCount = (await getCollection("blog")).filter((p) => !p.data.draft).length;

const focus = [
  { word: "Mindset", desc: "Mental models, stoic clarity, thinking straight under noise." },
  { word: "Habits & Discipline", desc: "Systems that hold when motivation leaves the room." },
  { word: "Deep Work & Focus", desc: "Attention as the scarce resource — protected on purpose." },
  { word: "The Long Ascent", desc: "Patient, compounding progress — books, tools and daily practice." },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://the-motivahub.com/author/youssef-raihane/#person",
  name: "Youssef Raihane",
  jobTitle: "Founder & Editor-in-Chief",
  worksFor: { "@type": "Organization", name: "Motiva Hub", url: "https://the-motivahub.com" },
  url: "https://the-motivahub.com/author/youssef-raihane/",
  image: "https://the-motivahub.com/images/youssef-raihane.jpg",
  description: "Founder of Motiva Hub. Writes on habits, discipline, focus and stoic practice — from experience, not theory.",
  knowsAbout: [
    "Habits",
    "Discipline",
    "Stoicism",
    "Deep Work",
    "Productivity",
    "Mental Models",
    "Focus",
    "Goal Setting",
  ],
  foundingDate: "2025",
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
    { "@type": "ListItem", "position": 2, "name": "Youssef Raihane", "item": "https://the-motivahub.com/author/youssef-raihane/" },
  ],
};
---

<Layout title="Youssef Raihane — Founder of Motiva Hub" description="Youssef Raihane founded Motiva Hub in 2025. Writer of the Journal, building a sanctuary for the disciplined mind — one idea at a time." image="/images/youssef-raihane.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- Hero -->
  <section class="au-hero">
    <div class="au-hero-inner">
      <div class="au-hero-text">
        <p class="au-hero-eyebrow">Author</p>
        <h1 class="au-hero-title">Youssef<br /><em>Raihane.</em></h1>
        <p class="au-hero-sub">Founder &amp; Editor-in-Chief of Motiva Hub</p>
        <p class="au-hero-desc">Motiva Hub is the editorial work of one person, building in public, choosing the slow road on purpose. Every essay is written from experience — tested in real life before it reaches yours.</p>
        <a href="/about/" class="au-hero-cta">More About Motiva Hub →</a>
        <span class="au-hero-divider"></span>
        <p class="au-hero-tagline">Est. 2025 · {essayCount} essays published</p>
      </div>
      <div class="au-hero-media">
        <img
          src="/images/yr-640.jpg"
          srcset="/images/yr-320.jpg 320w, /images/yr-480.jpg 480w, /images/yr-640.jpg 640w, /images/yr-1024.jpg 1024w"
          sizes="(max-width: 768px) 100vw, 480px"
          alt="Youssef Raihane — Founder of Motiva Hub"
          width="640" height="640"
          loading="eager"
          fetchpriority="high"
        />
        <p class="au-hero-img-label">The person<br />behind the words.</p>
      </div>
    </div>
  </section>

  <!-- The Story (moved from /about/ — real project copy) -->
  <section class="au-story">
    <div class="container">
      <div class="au-story-inner">
        <p class="au-section-kicker">The Story</p>
        <h2 class="journal-section-title">Failure Was<br /><em>the Lesson.</em></h2>
        <p>I founded MotivaHub in 2025 after spending eight months writing my first book, but I failed to launch it because of self-sabotage. I had the content. I had the plan. After many attempts that did not go as I had hoped, I began to understand that failure was not the end, but part of the journey. With each attempt, I learned more about myself, about discipline, and about the need to build a system that helps me keep going.</p>
        <p>That failure taught me more than any success could have taught me. It taught me that discipline is not about motivation, but about designing systems, building identity, and showing up even when there is no accountability.</p>
        <p>That is where the idea for MotivaHub began: to build something that helps people turn these lessons into systems, habits, and practices they can continue even when motivation disappears.</p>
        <blockquote class="au-pullquote">"Motivation is a visitor, discipline is a resident."</blockquote>
      </div>
    </div>
  </section>

  <!-- Promise -->
  <section class="au-promise">
    <div class="container">
      <div class="au-promise-inner">
        <p class="au-section-kicker">My Promise</p>
        <h2 class="journal-section-title">I Write<br /><em>What I Built.</em></h2>
        <p class="au-promise-lead">Motiva Hub is not a content farm. It is a daily practice, written in public, edited in private, and tested in my own life before it reaches yours.</p>
        <p>I write about the things I have tested personally: habits, discipline, productivity, mindset, and the long game. Every article is based on real experiments, real failures, and real results. I do not write theory. I write about what worked, what did not work, and what I learned from both.</p>
        <p class="au-promise-links">See the system in action: <a href="/journal/identity-based-habits-90-day-test/">the Identity-Based 90-Day Test</a> — or start with <a href="/journal/2-minute-rule-system/">the 2-Minute Rule guide</a>.</p>
      </div>
    </div>
  </section>

  <!-- Focus areas -->
  <section class="au-focus">
    <div class="container">
      <div class="au-section-head">
        <p class="au-section-kicker">What I Focus On</p>
        <h2 class="journal-section-title">Areas I Explore<br /><em>and Write About.</em></h2>
      </div>
      <div class="au-focus-grid">
        {focus.map((f) => (
          <div class="au-focus-item">
            <h3>{f.word}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent work -->
  <section class="au-work">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">Recent Essays</p>
        <a class="link-ochre" href="/journal/">All Essays →</a>
      </div>
      <div class="book-grid">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>
</Layout>
