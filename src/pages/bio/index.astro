---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Motiva Hub — Link in Bio" description="Your gateway to motivation, discipline, and growth.">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #0a0a0a;
    color: #ffffff;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .bio-container {
    max-width: 480px;
    margin: 0 auto;
    padding: 40px 20px 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
  }

  /* Profile Section */
  .profile {
    text-align: center;
    margin-bottom: 32px;
  }

  .avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c9a227, #e8c547);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 42px;
    font-weight: 800;
    color: #0a0a0a;
    letter-spacing: -1px;
    box-shadow: 0 0 0 3px #0a0a0a, 0 0 0 5px #c9a227;
  }

  .name {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 4px;
  }

  .handle {
    font-size: 14px;
    color: #888;
    margin-bottom: 12px;
  }

  .bio-text {
    font-size: 15px;
    color: #aaa;
    line-height: 1.6;
    max-width: 360px;
  }

  .bio-text strong {
    color: #c9a227;
  }

  /* Stats */
  .stats {
    display: flex;
    gap: 32px;
    margin: 24px 0 32px;
    padding: 16px 0;
    border-top: 1px solid #1a1a1a;
    border-bottom: 1px solid #1a1a1a;
    width: 100%;
    justify-content: center;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    font-size: 22px;
    font-weight: 700;
    color: #c9a227;
  }

  .stat-label {
    font-size: 12px;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 2px;
  }

  /* Links */
  .links {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: #111111;
    border: 1px solid #1a1a1a;
    border-radius: 14px;
    text-decoration: none;
    color: #ffffff;
    transition: all 0.3s ease;
    width: 100%;
  }

  .link-item:hover {
    background: #1a1a1a;
    border-color: #c9a227;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(201, 162, 39, 0.15);
  }

  .link-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .link-content {
    flex: 1;
  }

  .link-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .link-desc {
    font-size: 12px;
    color: #888;
  }

  .link-arrow {
    color: #555;
    font-size: 18px;
    transition: color 0.3s;
  }

  .link-item:hover .link-arrow {
    color: #c9a227;
  }

  /* Icon Colors */
  .icon-yellow { background: linear-gradient(135deg, #c9a227, #e8c547); color: #0a0a0a; }
  .icon-blue { background: linear-gradient(135deg, #2563eb, #60a5fa); color: #fff; }
  .icon-green { background: linear-gradient(135deg, #16a34a, #4ade80); color: #fff; }
  .icon-purple { background: linear-gradient(135deg, #9333ea, #c084fc); color: #fff; }
  .icon-red { background: linear-gradient(135deg, #dc2626, #f87171); color: #fff; }
  .icon-orange { background: linear-gradient(135deg, #ea580c, #fb923c); color: #fff; }
  .icon-pink { background: linear-gradient(135deg, #db2777, #f472b6); color: #fff; }
  .icon-teal { background: linear-gradient(135deg, #0d9488, #5eead4); color: #fff; }

  /* Featured Section */
  .featured {
    width: 100%;
    margin-bottom: 32px;
  }

  .featured-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #555;
    text-align: center;
    margin-bottom: 16px;
  }

  .featured-card {
    background: linear-gradient(135deg, #111111, #1a1a1a);
    border: 1px solid #222;
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    text-decoration: none;
    color: #fff;
    transition: all 0.3s ease;
  }

  .featured-card:hover {
    border-color: #c9a227;
    transform: translateY(-2px);
  }

  .featured-badge {
    display: inline-block;
    background: linear-gradient(135deg, #c9a227, #e8c547);
    color: #0a0a0a;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .featured-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .featured-card p {
    font-size: 13px;
    color: #888;
    line-height: 1.5;
  }

  /* Footer */
  .bio-footer {
    margin-top: auto;
    padding-top: 32px;
    text-align: center;
  }

  .footer-logo {
    font-size: 13px;
    color: #444;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .footer-logo a {
    color: #c9a227;
    text-decoration: none;
  }

  .footer-tagline {
    font-size: 11px;
    color: #333;
    margin-top: 8px;
  }

  /* Animations */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .profile { animation: fadeInUp 0.5s ease 0.1s both; }
  .stats { animation: fadeInUp 0.5s ease 0.2s both; }
  .featured { animation: fadeInUp 0.5s ease 0.3s both; }
  .links { animation: fadeInUp 0.5s ease 0.4s both; }

  .link-item:nth-child(1) { animation: fadeInUp 0.4s ease 0.5s both; }
  .link-item:nth-child(2) { animation: fadeInUp 0.4s ease 0.6s both; }
  .link-item:nth-child(3) { animation: fadeInUp 0.4s ease 0.7s both; }
  .link-item:nth-child(4) { animation: fadeInUp 0.4s ease 0.8s both; }
  .link-item:nth-child(5) { animation: fadeInUp 0.4s ease 0.9s both; }
  .link-item:nth-child(6) { animation: fadeInUp 0.4s ease 1.0s both; }
  .link-item:nth-child(7) { animation: fadeInUp 0.4s ease 1.1s both; }
  .link-item:nth-child(8) { animation: fadeInUp 0.4s ease 1.2s both; }

  /* Mobile */
  @media (max-width: 480px) {
    .bio-container { padding: 32px 16px 48px; }
    .avatar { width: 95px; height: 95px; font-size: 36px; }
    .name { font-size: 20px; }
    .stats { gap: 24px; }
  }
</style>

<div class="bio-container">

  <!-- Profile -->
  <div class="profile">
    <div class="avatar">MH</div>
    <h1 class="name">Motiva Hub</h1>
    <p class="handle">@the.motivahub</p>
    <p class="bio-text">
      Mindset · Discipline · Habits<br>
      <strong>Your daily drive to become unstoppable.</strong>
    </p>
  </div>

  <!-- Stats -->
  <div class="stats">
    <div class="stat">
      <div class="stat-number">156+</div>
      <div class="stat-label">Articles</div>
    </div>
    <div class="stat">
      <div class="stat-number">16</div>
      <div class="stat-label">Topics</div>
    </div>
    <div class="stat">
      <div class="stat-number">30</div>
      <div class="stat-label">Day Challenge</div>
    </div>
  </div>

  <!-- Featured -->
  <div class="featured">
    <div class="featured-title">Featured</div>
    <a href="/30-days-discipline/" class="featured-card">
      <div class="featured-badge">Free Download</div>
      <h3>30 Days of Discipline</h3>
      <p>Your complete guide to building unbreakable habits and mental toughness. Free PDF + daily tracker.</p>
    </a>
  </div>

  <!-- Links -->
  <div class="links">

    <a href="/journal/" class="link-item">
      <div class="link-icon icon-yellow">📝</div>
      <div class="link-content">
        <div class="link-title">Read Our Articles</div>
        <div class="link-desc">156+ articles on mindset, habits & discipline</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/30-days-discipline/" class="link-item">
      <div class="link-icon icon-green">🎯</div>
      <div class="link-content">
        <div class="link-title">30-Day Challenge</div>
        <div class="link-desc">Free PDF guide to build discipline in 30 days</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/tracker/" class="link-item">
      <div class="link-icon icon-blue">📊</div>
      <div class="link-content">
        <div class="link-title">Habit Tracker</div>
        <div class="link-desc">Track your daily habits & build streaks</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/topics/" class="link-item">
      <div class="link-icon icon-purple">🧠</div>
      <div class="link-content">
        <div class="link-title">Explore Topics</div>
        <div class="link-desc">16 topics to transform every area of your life</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/quotes/" class="link-item">
      <div class="link-icon icon-orange">💬</div>
      <div class="link-content">
        <div class="link-title">Daily Quotes</div>
        <div class="link-desc">Inspiration to fuel your day</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/books/" class="link-item">
      <div class="link-icon icon-pink">📚</div>
      <div class="link-content">
        <div class="link-title">Book Reviews</div>
        <div class="link-desc">Best books for growth & success</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/podcast/" class="link-item">
      <div class="link-icon icon-teal">🎧</div>
      <div class="link-content">
        <div class="link-title">Podcast</div>
        <div class="link-desc">Listen & learn on the go</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

    <a href="/contact/" class="link-item">
      <div class="link-icon icon-red">✉️</div>
      <div class="link-content">
        <div class="link-title">Contact Us</div>
        <div class="link-desc">Get in touch or collaborate</div>
      </div>
      <div class="link-arrow">→</div>
    </a>

  </div>

  <!-- Footer -->
  <div class="bio-footer">
    <div class="footer-logo">
      <a href="https://the-motivahub.com">the-motivahub.com</a>
    </div>
    <div class="footer-tagline">Discipline is the bridge between goals and accomplishment.</div>
  </div>

</div>

</Layout>
