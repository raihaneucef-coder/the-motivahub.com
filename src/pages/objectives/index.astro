---
import Layout from "../../layouts/Layout.astro";
import GoalTracker from "../../components/GoalTracker.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
---

<Layout title="Objectives — Motiva Hub" description="Set up to three daily objectives. Consistent progress, one day at a time.">
  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="objectivesKicker">Objectives</p>
      <h1 data-i18n="objectivesTitle">The <em>Daily Drive.</em></h1>
      <p data-i18n="objectivesSubtitle">Up to three objectives a day. Small, repeated acts compound into an unrecognisable life.</p>
    </div>
  </section>

  <section class="goals-section">
    <div class="container">
      <GoalTracker />
    </div>
  </section>

  <section class="premise">
    <div class="container">
      <div class="pillars">
        <div class="pillar">
          <img src="/images/desk.jpg" alt="One — single most important objective, focused work on desk" class="pillar-img" loading="lazy" />
          <p class="pillar-word" data-i18n="pillarOne">One</p>
          <p data-i18n="pillarOneDesc">Choose the single most important objective of the day — the one that makes everything else easier.</p>
        </div>
        <div class="pillar">
          <img src="/images/sport.jpg" alt="Two — small and unmissable, musculation training" class="pillar-img" loading="lazy" />
          <p class="pillar-word" data-i18n="pillarTwo">Two</p>
          <p data-i18n="pillarTwoDesc">Keep it small enough to be unmissable. Momentum is built by completing, not by aiming high.</p>
        </div>
        <div class="pillar">
          <img src="/images/path.jpg" alt="Three — complete before evening, going to work / craft" class="pillar-img" loading="lazy" />
          <p class="pillar-word" data-i18n="pillarThree">Three</p>
          <p data-i18n="pillarThreeDesc">Complete all three before the evening closes. The day is the unit of a life well lived.</p>
        </div>
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>