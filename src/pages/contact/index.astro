---
import Layout from "../../layouts/Layout.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
---

<Layout title="Contact — Motiva Hub" description="Write to the desk. Pitches, corrections, quiet hellos.">
  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="contactKicker">Contact</p>
      <h1 data-i18n="contactTitle">Write to <em>the desk.</em></h1>
      <p data-i18n="contactSubtitle">Pitches, corrections, quiet hellos. We read everything, slowly, and reply to most.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-block">
          <p class="bp-meta">Editorial</p>
          <h3>raihaneucef@gmail.com</h3>
        </div>
        <div class="contact-block">
          <p class="bp-meta">Press & Partnerships</p>
          <h3>raihaneucef@gmail.com</h3>
        </div>
        <div class="contact-block">
          <p class="bp-meta">Studio</p>
          <h3>The Quiet Floor<br />14 Ascent Lane<br />Marrakech 40000, Morocco</h3>
        </div>
      </div>

      <div class="contact-form">
        <p class="kicker" data-i18n="contactSendTitle">Send a Message</p>
        <form action="mailto:raihaneucef@gmail.com" method="post" enctype="text/plain">
          <div class="form-group">
            <label for="name" data-i18n="contactName">Name</label>
            <input type="text" id="name" name="name" required />
          </div>
          <div class="form-group">
            <label for="email" data-i18n="contactEmail">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="message" data-i18n="contactMessage">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <button type="submit" class="btn-pill" data-i18n="contactSend">Send to the Desk</button>
          <p class="goals-note" style="margin-top: 14px;">The form opens your email app. To send through the website itself, connect a form backend (e.g. Formspree) by replacing the form action.</p>
        </form>
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>