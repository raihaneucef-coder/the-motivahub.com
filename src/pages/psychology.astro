---
import Layout from "../layouts/Layout.astro";

const lessons = [
  {
    thinker: "Viktor Frankl",
    field: "Psychiatrist · Auschwitz survivor",
    book: "Man's Search for Meaning",
    lesson: "Between stimulus and response there is a space. In that space lies your freedom — even in the darkest place on earth, Frankl found that the last human freedom is choosing your attitude.",
    article: "/journal/identity-precedes-outcome/",
    articleLabel: "Read the lesson",
    bookUrl: "https://www.amazon.fr/dp/080701429X?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=frankl",
    podcast: null,
  },
  {
    thinker: "Marcus Aurelius",
    field: "Roman Emperor · Stoic philosopher",
    book: "Meditations",
    lesson: "You have power over your mind — not outside events. The emperor who commanded legions wrote private notes reminding himself of one thing: master the inside, and the outside loses its grip.",
    article: "/journal/comment-devenir-mentalement-inebranlable/",
    articleLabel: "Read the lesson",
    bookUrl: "https://www.amazon.fr/dp/0140449337?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=marcus",
    podcast: null,
  },
  {
    thinker: "David Goggins",
    field: "Navy SEAL · Ultramarathoner",
    book: "Can't Hurt Me",
    lesson: "Most of us quit at 40% — when it starts to hurt. Goggins calls it the 40% rule: when your mind says you're done, you're only at forty percent of what you're capable of.",
    article: "/journal/cant-hurt-me-review/",
    articleLabel: "Read the review",
    bookUrl: "https://www.amazon.fr/dp/1544512287?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=goggins",
    podcast: null,
  },
  {
    thinker: "James Clear",
    field: "Writer · Habits researcher",
    book: "Atomic Habits",
    lesson: "You do not rise to the level of your goals — you fall to the level of your systems. Every action is a vote for the person you want to become. Identity precedes outcome.",
    article: "/journal/atomic-habits-review/",
    articleLabel: "Read the review",
    bookUrl: "https://www.amazon.fr/dp/0735211299?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=clear",
    podcast: null,
  },
  {
    thinker: "Cal Newport",
    field: "Professor · Deep work researcher",
    book: "Deep Work",
    lesson: "Focus is the new IQ. In a distracted world, the ability to concentrate without distraction on a demanding task is becoming both rarer and more valuable — at exactly the same time.",
    article: "/journal/deep-work-ritual/",
    articleLabel: "Read the lesson",
    bookUrl: "https://www.amazon.fr/dp/1455586692?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=newport",
    podcast: null,
  },
  {
    thinker: "Morgan Housel",
    field: "Financial writer · Behaviour analyst",
    book: "The Psychology of Money",
    lesson: "Money is not a math problem — it is a behaviour problem. Doing well with money has little to do with how smart you are and everything to do with how you behave.",
    article: "/journal/psychology-of-money-business/",
    articleLabel: "Read the lesson",
    bookUrl: "https://www.amazon.fr/dp/0857197681?tag=motivahub-21&utm_source=motivahub&utm_medium=psychology&utm_campaign=housel",
    podcast: null,
  },
  {
    thinker: "Shi Heng Yi",
    field: "Shaolin Master",
    book: null,
    lesson: "Focus on yourself and stay silent. The Shaolin teaching is simple: energy spent proving, comparing and announcing is energy stolen from becoming. Work in silence.",
    article: "/journal/focus-on-yourself-stay-silent-shi-heng-yi/",
    articleLabel: "Read the lesson",
    bookUrl: null,
    podcast: { url: "https://www.youtube.com/watch?v=teJ_rMsFJn0", label: "Listen to the teaching" },
  },
];
---

<Layout title="Psychology — Lessons from the Great Minds | Motiva Hub" description="Timeless psychology lessons from Frankl, Marcus Aurelius, Goggins, Clear and more — each one paired with the book and the teaching behind it.">
  <section class="page-head">
    <div class="container">
      <p class="kicker">Psychology</p>
      <h1>Lessons from the <em>great minds.</em></h1>
      <p class="psy-sub">Not advice from us — wisdom from psychiatrists, emperors, monks and researchers, each one paired with the book and the teaching behind it. Read the lesson, then go to the source.</p>
    </div>
  </section>

  <section class="psy-section">
    <div class="container">
      <div class="psy-grid">
        {lessons.map((l) => (
          <article class="psy-card">
            <div class="psy-card-head">
              <h2 class="psy-thinker">{l.thinker}</h2>
              <p class="psy-field">{l.field}</p>
            </div>
            <p class="psy-lesson">{l.lesson}</p>
            <div class="psy-actions">
              <a class="psy-btn psy-btn-solid" href={l.article}>{l.articleLabel} →</a>
              {l.bookUrl && (
                <a class="psy-btn psy-btn-line" href={l.bookUrl} target="_blank" rel="nofollow sponsored noopener">Get the book</a>
              )}
              {l.podcast && (
                <a class="psy-btn psy-btn-line" href={l.podcast.url} target="_blank" rel="noopener">{l.podcast.label}</a>
              )}
            </div>
            {l.book && <p class="psy-source">Source: <em>{l.book}</em></p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="premise">
    <div class="container">
      <p class="kicker">Why this section exists</p>
      <h2 class="premise-title">We are not your therapists. We are <em>curators.</em> Every idea on this page comes from a book you can hold and a life you can study — our job is only to point you to the source.</h2>
      <div class="hero-btns">
        <a class="btn-pill" href="/books/">Browse the Bookstand</a>
        <a class="btn-pill btn-pill-outline" href="/journal/">Read the Journal</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .psy-sub { max-width: 600px; color: var(--muted); margin-top: 12px; }
  .psy-section { padding: 24px 0 64px; }
  .psy-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; max-width: 1100px; margin: 0 auto; }
  .psy-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
    border-radius: 16px;
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .psy-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(18,18,18,.09); }
  .psy-thinker { font-family: var(--serif); font-size: 28px; font-weight: 600; color: var(--ink); }
  .psy-field { font-family: var(--sans); font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .psy-lesson { font-family: var(--sans); font-size: 15px; line-height: 1.7; color: var(--ink); margin: 18px 0 22px; flex: 1; }
  .psy-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .psy-btn {
    font-family: var(--sans); font-size: 13.5px; font-weight: 600;
    padding: 10px 18px; border-radius: 999px; text-decoration: none;
    transition: opacity .2s ease;
  }
  .psy-btn:hover { opacity: .8; }
  .psy-btn-solid { background: var(--ink); color: var(--white); }
  .psy-btn-line { border: 1px solid var(--line); color: var(--ink); }
  .psy-source { font-family: var(--sans); font-size: 12.5px; color: var(--muted); margin-top: 16px; }
  @media (max-width: 640px) {
    .psy-grid { grid-template-columns: 1fr; }
    .psy-card { padding: 24px 20px; }
  }
</style>
