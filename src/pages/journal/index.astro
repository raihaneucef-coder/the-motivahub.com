---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { topics as allTopics } from "../../data/topics";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lang = typeof window !== "undefined" ? (localStorage.getItem("lang") || "en") : "en";
---

<Layout title="The Journal — Motiva Hub" description="Essays for the long climb. Mindset, habits, discipline, productivity, deep work — articles for the disciplined mind.">
  <link rel="canonical" href="https://the-motivahub.com/journal/" />
  <link rel="next" href="/journal/page/2/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Motiva Hub Journal",
    "description": "Essays on mindset, habits, discipline, productivity, and deep work.",
    "url": "https://the-motivahub.com/journal/",
    "numberOfItems": posts.length,
    "itemListElement": posts.slice(0, 20).map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://the-motivahub.com/journal/${p.id}/`,
      "name": p.data.title
    }))
  })} />
  <section class="page-head">
    <div class="container">
      <p class="kicker">The Journal</p>
      <h1>Essays for the <em>long climb.</em></h1>
      <p>Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="journal-hero">
        <p class="journal-hero-lead">Motivation is a spark. Discipline is the fire.</p>
        <p class="journal-hero-sub">The Motiva Hub Journal: practical essays on mindset, habits, discipline and deep work.</p>
        <p class="journal-hero-cta">Read one. Apply one habit today. Repeat.</p>
      </div>

      <div style="width:100%;margin:0 0 24px;">
        <input id="journal-search" type="search" placeholder="Search by title, topic or keywords..." data-i18n-placeholder="searchPlaceholder" aria-label="Search articles" style="width:100%;padding:14px 16px;border:1px solid var(--line);background:var(--white);font-family:var(--sans);font-size:0.95rem;" />
      </div>

      <div class="topic-filter">
        <a class="active" href="/journal/" data-i18n="all">All</a>
        {allTopics.map((t) => (
          <a href={`/topics/${t.id}/`} data-i18n={`topic-${t.id}`}>{t.title}</a>
        ))}
      </div>

      <div class="grid" id="journal-grid">
        {posts.slice(0, 12).map((post) => {
          const searchTitle = lang === "fr" && post.data.titleFr ? post.data.titleFr.toLowerCase() : post.data.title.toLowerCase();
          const searchDesc = lang === "fr" && post.data.descriptionFr ? post.data.descriptionFr.toLowerCase() : post.data.description.toLowerCase();
          return (
          <div class="searchable" data-title={searchTitle} data-topic={post.data.topic.toLowerCase()} data-desc={searchDesc}>
            <ArticleCard post={post} />
          </div>
          );
        })}
      </div>
      <p id="no-results" hidden style="text-align:center;color:var(--muted);margin-top:32px;" data-i18n="noResults">No results found.</p>

      <nav class="pagination" aria-label="Pagination">
        <span class="pagination-link disabled" data-i18n="newerPagination">← Newer</span>
        <span class="pagination-current">Page 1 of {Math.ceil((posts.length - 1) / 12) + 1}</span>
        <a class="pagination-link" href="/journal/page/2/" data-i18n="olderPagination">Older →</a>
      </nav>
    </div>
  </section>

  <script>
    const input = document.getElementById('journal-search') as HTMLInputElement | null;
    const grid = document.getElementById('journal-grid');
    const noRes = document.getElementById('no-results');
    if (input && grid && noRes) {
      const items = Array.from(grid.querySelectorAll('.searchable')) as HTMLElement[];
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let vis = 0;
        items.forEach((el) => {
          const hay = (el.dataset.title || '') + ' ' + (el.dataset.topic || '') + ' ' + (el.dataset.desc || '');
          const show = !q || hay.includes(q);
          el.style.display = show ? '' : 'none';
          if (show) vis++;
        });
        noRes.hidden = vis !== 0;
      });
    }
  </script>
</Layout>

<style>
  .topic-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 24px 0;
  }
  .topic-filter a {
    padding: 8px 16px;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 6px;
    color: var(--ink, #1a1a1a);
    text-decoration: none;
    font-size: 14px;
    font-family: var(--sans, system-ui, sans-serif);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .topic-filter a:hover {
    border-color: var(--gold, #c8a04a);
    color: var(--gold, #c8a04a);
  }
  .topic-filter a.active {
    border-color: var(--gold, #c8a04a);
    color: var(--gold, #c8a04a);
    font-weight: 600;
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 56px 0 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line, #e5e5e5);
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pagination-link {
    color: var(--gold, #c8a04a);
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    font-size: 12px;
    padding: 8px 16px;
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 6px;
    transition: border-color 0.2s ease;
  }
  .pagination-link:hover { border-color: var(--gold, #c8a04a); }
  .pagination-link.disabled {
    color: var(--muted, #999);
    cursor: not-allowed;
    opacity: 0.5;
  }
  .pagination-current {
    color: var(--muted, #666);
    font-size: 13px;
  }

  /* Journal hero: 3 centered lines (no images, static content, no CLS) */
  .journal-hero{max-width:780px;margin:4px auto 40px;text-align:center;}
  .journal-hero-lead{font-family:var(--serif, Georgia, serif);font-size:clamp(1.35rem, 3vw, 1.7rem);line-height:1.35;color:var(--ink, #0a0a0a);margin:0 0 12px;}
  .journal-hero-sub{font-family:var(--sans, system-ui, sans-serif);font-size:1rem;line-height:1.65;color:var(--muted, #555);margin:0 auto;max-width:640px;}
  .journal-hero-cta{font-family:var(--sans, system-ui, sans-serif);font-size:0.95rem;color:var(--gold, #c8a04a);letter-spacing:0.3px;margin:14px 0 0;}
  </style>