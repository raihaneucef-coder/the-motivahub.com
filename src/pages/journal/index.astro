---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";
import { topics as allTopics } from "../../data/topics";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topics = allTopics.map((t) => t.title);
const featured = posts.find((p) => p.data.featured) || posts[0];
const rest = posts.filter((p) => p.id !== featured.id);
const url = Astro.url;
const activeTopic = url.searchParams.get("topic");
const filtered = activeTopic ? rest.filter((p) => p.data.topic.toLowerCase() === activeTopic.toLowerCase()) : rest;
---

<Layout title="The Journal — Motiva Hub" description="Essays for the long climb. Mindset, habits, discipline, productivity, deep work — articles for the disciplined mind.">
  <section class="page-head">
    <div class="container">
      <p class="kicker" data-i18n="journalKicker">The Journal</p>
      <h1 data-i18n="journalTitle">Essays for the <em>long climb.</em></h1>
      <p data-i18n="journalSubtitle">Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.</p>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <article class="featured-card">
        <a href={`/journal/${featured.id}/`} class="card-img-link">
          <img class="card-img" src={featured.data.image} alt={featured.data.title} loading="lazy" />
        </a>
        <div class="card-pad">
          <p class="card-meta">Featured · {featured.data.topic.toUpperCase()} · {featured.data.readTime}</p>
          <h2><a href={`/journal/${featured.id}/`}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <p class="card-date">{featured.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
          <a class="read-more" href={`/journal/${featured.id}/`}>Read Essay</a>
        </div>
      </article>

      <div style="max-width:520px;margin:0 auto 24px;">
        <input id="journal-search" type="search" placeholder="Search by title, topic or keywords..." data-i18n-placeholder="searchPlaceholder" aria-label="Search articles" style="width:100%;padding:14px 16px;border:1px solid var(--line);background:var(--white);font-family:var(--sans);font-size:0.95rem;" />
      </div>

      <div class="topic-filter">
        <a class={!activeTopic ? "active" : ""} href="/journal/" data-i18n="all">All</a>
        {topics.map((t) => (
          <a class={activeTopic === t.toLowerCase() ? "active" : ""} href={`/journal/?topic=${t.toLowerCase()}`}>{t}</a>
        ))}
      </div>

      <div class="grid" id="journal-grid">
        {filtered.map((post) => (
          <div class="searchable" data-title={post.data.title.toLowerCase()} data-topic={post.data.topic.toLowerCase()} data-desc={post.data.description.toLowerCase()}>
            <ArticleCard post={post} />
          </div>
        ))}
      </div>
      <p id="no-results" hidden style="text-align:center;color:var(--muted);margin-top:32px;" data-i18n="noResults">No results found.</p>
      <script>
        const input = document.getElementById('journal-search') as HTMLInputElement | null;
        const grid = document.getElementById('journal-grid');
        const noRes = document.getElementById('no-results');
        if (input && grid && noRes) {
          const items = Array.from(grid.querySelectorAll('.searchable')) as HTMLElement[];
          input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            let vis = 0;
            items.forEach((el) => {
              const hay = (el.dataset.title || '') + ' ' + (el.dataset.topic || '') + ' ' + (el.dataset.desc || '');
              const show = !q || hay.includes(q);
              el.style.display = show ? '' : 'none';
              if (show) vis++;
            });
            noRes.hidden = vis !== 0;
          });
        }
      </script>
    </div>
  </section>
</Layout>