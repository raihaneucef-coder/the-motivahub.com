---
import Layout from "../../../layouts/Layout.astro";
const title = "The Home Athlete Blueprint — Free 10-Page PDF | Motiva Hub";
const description = "Train at home without the gimmicks. Bodyweight protocols, cold exposure, recovery science, and the consistency system that beats any gym membership.";
const canonical = "https://the-motivahub.com/guides/home-athlete/";
---

<Layout title={title} description={description} canonical={canonical}>
  <link rel="canonical" href={canonical} />
  <style>
    .guide-hero { padding: clamp(48px,8vw,96px) 0 40px; }
    .guide-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    .guide-kicker { color: var(--gold, #d4b377); font-size: 11px; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; margin-bottom: 16px; }
    .guide-h1 { font-family: 'Fraunces', serif; font-size: clamp(32px,5vw,52px); line-height: 1.05; margin: 0 0 16px; }
    .guide-sub { font-size: 16px; line-height: 1.6; color: var(--text-muted, #999); margin: 0 0 24px; max-width: 500px; }
    .guide-form { display: flex; flex-direction: column; gap: 10px; max-width: 460px; }
    .guide-form-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .guide-form input { flex: 1 1 160px; padding: 14px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; color: var(--text, #f5f5f5); font-size: 15px; }
    .guide-form input:focus { outline: none; border-color: var(--gold, #d4b377); }
    .guide-form button { padding: 14px 22px; background: var(--gold, #d4b377); color: #0a0a0a; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 15px; }
    .guide-form button:hover { background: var(--or-light, #e5c890); }
    .guide-msg { font-size: 13px; color: var(--text-muted, #888); min-height: 20px; }
    .guide-legal { font-size: 11px; color: var(--text-muted, #666); }
    .guide-legal a { color: inherit; }
    .guide-mockup { background: #faf8f0; border-radius: 8px; padding: 24px; aspect-ratio: 5/7; max-width: 320px; margin: 0 auto; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.4); display: flex; flex-direction: column; justify-content: space-between; color: #1a1a1a; }
    .guide-mockup-kicker { font-size: 9px; color: #b8965a; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; }
    .guide-mockup-title { font-family: 'Fraunces', serif; font-size: 28px; line-height: 1.05; margin: 10px 0 0; color: #0a0a0a; }
    .guide-mockup-rule { width: 36px; height: 2px; background: #b8965a; margin: 12px 0; }
    .guide-mockup-body { font-size: 11px; color: #333; }
    .guide-mockup-footer { font-size: 10px; color: #6b5320; font-family: 'Fraunces', serif; font-style: italic; }
    .guide-list { max-width: 700px; margin: 40px auto; padding: 0 24px; }
    .guide-list h2 { font-family: 'Fraunces', serif; font-size: 28px; margin: 0 0 20px; }
    .guide-list ol { padding-left: 20px; }
    .guide-list li { margin-bottom: 10px; color: var(--text-muted, #aaa); font-size: 15px; }
    .guide-list li strong { color: var(--text, #f5f5f5); }
    @media (max-width: 780px) { .guide-inner { grid-template-columns: 1fr; } .guide-mockup { max-width: 240px; } }
  </style>

  <section class="guide-hero">
    <div class="guide-inner">
      <div>
        <div class="guide-kicker">Motiva Hub · Field Guide № 04</div>
        <h1 class="guide-h1">The Home Athlete Blueprint</h1>
        <p class="guide-sub">Train at home without the gimmicks. 10 pages: daily protocol, weekly structure, recovery science, cold exposure, and the environment design that makes consistency automatic.</p>
        <form class="guide-form" id="ha-form" novalidate>
          <input type="hidden" name="source" value="home-athlete" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" />
          <div class="guide-form-row">
            <input type="text" name="name" placeholder="First name (optional)" autocomplete="given-name" />
            <input type="email" name="email" placeholder="you@email.com" required autocomplete="email" />
            <button type="submit">Send the PDF →</button>
          </div>
          <p class="guide-msg" id="ha-msg" aria-live="polite"></p>
          <p class="guide-legal">Free forever. <a href="/privacy/">Privacy</a> · <a href="/affiliate-disclosure/">Disclosure</a></p>
        </form>
      </div>
      <aside class="guide-mockup" aria-label="PDF preview">
        <div>
          <div class="guide-mockup-kicker">Field Guide № 04</div>
          <div class="guide-mockup-title">The Home<br>Athlete Blueprint</div>
          <div class="guide-mockup-rule"></div>
          <div class="guide-mockup-body">Train at home without the gimmicks.</div>
        </div>
        <div class="guide-mockup-footer">Youssef Raihane · the-motivahub.com</div>
      </aside>
    </div>
  </section>

  <section class="guide-list">
    <h2>What's inside (10 pages)</h2>
    <ol>
      <li><strong>The Case</strong> — why home training wins at the margin</li>
      <li><strong>The Formula</strong> — consistency beats intensity, every time</li>
      <li><strong>20-Min Protocol</strong> — 5 moves, 3 rounds, zero equipment</li>
      <li><strong>Weekly Structure</strong> — 5 on, 2 active recovery</li>
      <li><strong>Recovery Is Training</strong> — the invisible 23 hours</li>
      <li><strong>Cold Exposure</strong> — the 30-second shower finisher</li>
      <li><strong>Cardio Without Pavement</strong> — walk-run progression</li>
      <li><strong>Environment Design</strong> — make the workout the path of least resistance</li>
      <li><strong>About + Disclosure</strong></li>
    </ol>
  </section>

  <script>
    const form = document.getElementById('ha-form');
    const msg = document.getElementById('ha-msg');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email')||'').trim();
      const name = String(fd.get('name')||'').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent='Enter a valid email.'; return; }
      msg.textContent = 'Sending…';
      try {
        const r = await fetch('/api/pdf-subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({email,name,source:'home-athlete'}) });
        const d = await r.json();
        if (d.ok) { msg.textContent='✓ Check your inbox.'; form.reset(); try{window.gtag&&window.gtag('event','pdf_subscribe',{source:'home-athlete'})}catch{} }
        else throw new Error(d.message);
      } catch { msg.textContent='Failed. Try the direct link.'; }
    });
  </script>
</Layout>
