---
import Layout from "../../layouts/Layout.astro";

// All 30 days — real content preserved from existing implementation
const weeks = [
  {
    label: "Week 1 — Foundation",
    title: "Build the Base",
    days: [
      { n: 1, title: "Wake Up at the Same Time", text: "Set one alarm. Get out of bed on the first ring. No snooze. Your day starts with discipline, not negotiation.", action: "Wake up at 6:00 AM tomorrow. No exceptions." },
      { n: 2, title: "Make Your Bed", text: "The first small win of the day. A made bed signals: I am in control. Admiral William McRaven was right — it changes the world.", action: "Make your bed within 2 minutes of waking up." },
      { n: 3, title: "Cold Shower — 30 Seconds", text: "End your shower with 30 seconds of cold water. It trains your brain to do hard things voluntarily.", action: "Turn the water cold for the last 30 seconds." },
      { n: 4, title: "Write 3 Things You're Grateful For", text: "Discipline is not just physical. Gratitude trains your mind to see what matters. Write them by hand.", action: "Before bed, write 3 gratitudes in a notebook." },
      { n: 5, title: "No Phone for the First Hour", text: "Your morning belongs to you, not to notifications. The first hour sets the tone for everything.", action: "Leave your phone in another room until 7:00 AM." },
      { n: 6, title: "10 Push-Ups", text: "Discipline lives in the body. Ten push-ups is nothing — but doing them when you don't want to is everything.", action: "Drop and do 10 push-ups right now." },
      { n: 7, title: "Review Your Week", text: "What did you do? What did you skip? Write it down. Self-awareness is the foundation of growth.", action: "Spend 10 minutes reviewing your week honestly." },
    ],
  },
  {
    label: "Week 2 — Consistency",
    title: "Stack the Habits",
    days: [
      { n: 8, title: "Eat One Healthy Meal", text: "You don't need a diet. You need one good meal. Cook it, eat it slowly, notice how you feel.", action: "Prepare and eat one nutritious meal today." },
      { n: 9, title: "Read 10 Pages", text: "Not a chapter. Not a book. Just 10 pages. Consistency beats intensity every single time.", action: "Read 10 pages of any book before bed." },
      { n: 10, title: "Walk 20 Minutes", text: "Movement is medicine. A 20-minute walk clears your mind, strengthens your body, and builds the habit of showing up.", action: "Walk for 20 minutes without your phone." },
      { n: 11, title: "Say No to One Distraction", text: "One notification ignored. One scroll session skipped. Every \"no\" to distraction is a \"yes\" to your future.", action: "Identify your biggest distraction and avoid it for 2 hours." },
      { n: 12, title: "Plan Tomorrow Tonight", text: "Write down your top 3 priorities for tomorrow. Wake up with direction, not confusion.", action: "Before bed, write your 3 priorities for tomorrow." },
      { n: 13, title: "5 Minutes of Silence", text: "Sit alone. No music. No phone. No thoughts — just observe. The mind that can be still can do anything.", action: "Sit in complete silence for 5 minutes." },
      { n: 14, title: "Week 2 Review", text: "Two weeks in. Are you consistent? Write down what worked, what didn't, and what you'll change.", action: "Review your progress honestly. Adjust if needed." },
    ],
  },
  {
    label: "Week 3 — Challenge",
    title: "Push the Limits",
    days: [
      { n: 15, title: "Cold Shower — 1 Minute", text: "You survived 30 seconds. Now double it. Comfort is the enemy of growth.", action: "1 minute of cold water. Breathe through it." },
      { n: 16, title: "No Complaining for 24 Hours", text: "Zero complaints. Not about the weather. Not about work. Not about anything. Gratitude replaces complaining.", action: "Go the entire day without complaining once." },
      { n: 17, title: "20 Push-Ups + 20 Squats", text: "The body is getting stronger. Prove it to yourself. Double what you did on Day 6.", action: "20 push-ups and 20 squats. No rest between." },
      { n: 18, title: "Do the Thing You've Been Avoiding", text: "That email. That conversation. That task. Do it today. Discipline means doing what needs to be done.", action: "Complete the one task you've been putting off." },
      { n: 19, title: "Eat Clean All Day", text: "No junk food. No sugar. No processed food. One clean day shows you what your body is capable of.", action: "Eat only whole foods for one full day." },
      { n: 20, title: "Wake Up at 5:00 AM", text: "You've been training for 20 days. Now wake up an hour earlier. Own the morning before the world owns you.", action: "Alarm at 5:00 AM. Out of bed on the first ring." },
      { n: 21, title: "Week 3 Review", text: "Three weeks. You're not the same person who started. Write down how you've changed.", action: "Journal about the person you're becoming." },
    ],
  },
  {
    label: "Week 4 — Mastery",
    title: "Become the Person",
    days: [
      { n: 22, title: "2 Minutes of Cold Water", text: "You've come this far. Two minutes is nothing now. Your mind is stronger than it was on Day 3.", action: "2 minutes cold shower. You've earned this." },
      { n: 23, title: "Help Someone Today", text: "Discipline is not selfish. Use your strength to lift someone else. A kind word, a helping hand, a moment of your time.", action: "Do one act of kindness for someone else." },
      { n: 24, title: "30 Push-Ups + 30 Squats", text: "Three times what you started with. The body follows the mind. You are proof.", action: "30 push-ups and 30 squats. Feel the difference." },
      { n: 25, title: "No Social Media for 24 Hours", text: "One full day. No scrolling. No stories. No reels. You'll survive. You might even thrive.", action: "Delete apps for 24 hours. Reinstall tomorrow." },
      { n: 26, title: "Write Your Future Self a Letter", text: "Where will you be in one year? Write to that person. Tell them what you started. Tell them why.", action: "Write a letter to yourself, one year from now." },
      { n: 27, title: "Fast Until Lunch", text: "Hunger is a feeling, not an emergency. Skip breakfast. Eat at noon. Learn the difference between want and need.", action: "Eat only after 12:00 PM." },
      { n: 28, title: "Run or Walk 5K", text: "28 days of discipline led here. Move your body for 5 kilometers. You are not who you were on Day 1.", action: "Complete 5K — run, jog, or walk." },
      { n: 29, title: "Teach Someone What You've Learned", text: "Share one lesson from this journey with a friend, a family member, a colleague. Teaching cements learning.", action: "Tell one person what 30 days of discipline taught you." },
      { n: 30, title: "Start Again — Day 1", text: "You finished. But discipline has no finish line. Start again. This time, you know who you are.", action: "Tomorrow is Day 1 again. Will you show up?" },
    ],
  },
];

const allDays = weeks.flatMap((w) => w.days);
---

<Layout title="30 Days of Discipline — Free Guide | Motiva Hub" description="A free 30-day challenge to build unshakable discipline. One small act per day — transforms your life by the end.">
  <link rel="canonical" href="https://the-motivahub.com/30-days-discipline/" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://the-motivahub.com/" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://the-motivahub.com/tools/" },
      { "@type": "ListItem", "position": 3, "name": "30 Days of Discipline", "item": "https://the-motivahub.com/30-days-discipline/" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the 30 Days of Discipline program?", "acceptedAnswer": { "@type": "Answer", "text": "A free, practical 30-day challenge. Each day gives you one small action that takes 5 minutes or less. Complete all 30 days to build lasting discipline and consistency." } },
      { "@type": "Question", "name": "Do I need an account?", "acceptedAnswer": { "@type": "Answer", "text": "No. The entire program is free and accessible on one page. No sign-up, no login, no tracking. Just show up and do the daily action." } },
      { "@type": "Question", "name": "How does it work?", "acceptedAnswer": { "@type": "Answer", "text": "Each day has one challenge — a small, concrete action. Start at Day 1, complete the action, then move to Day 2. You can download the PDF version to track your progress offline." } }
    ]
  })} />

  <!-- Hero -->
  <section class="d30-hero">
    <div class="d30-hero-inner">
      <div class="d30-hero-text">
        <p class="d30-hero-eyebrow">A Small Step. Every Day.</p>
        <h1 class="d30-hero-title">30 Days of<br /><em>Discipline.</em></h1>
        <p class="d30-hero-sub">One page. One action. Every day.</p>
        <p class="d30-hero-desc">A simple, practical 30-day program to help you build consistency, take control of your habits and become a better version of yourself.</p>
        <a href="#day-1" class="d30-hero-cta">Start Day 1 →</a>
        <span class="d30-hero-divider"></span>
        <p class="d30-hero-tagline">Discipline today. A better tomorrow.</p>
      </div>
      <div class="d30-hero-img">
        <img src="/images/hero-mountain-man.jpg" alt="Person standing on a mountain at sunset" loading="eager" width="1024" height="1024" />
        <p class="d30-hero-img-label">Consistent<br />actions<br />produce<br />extraordinary<br />results.</p>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="d30-benefits">
    <div class="container">
      <div class="d30-benefits-grid">
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="4" x2="9" y2="10"/></svg></div>
          <div><h3>30 Daily Actions</h3><p>Small, practical steps that compound.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg></div>
          <div><h3>Build Consistency</h3><p>Create real habits that last.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg></div>
          <div><h3>Designed for Real Life</h3><p>Simple. Focused. No perfection needed.</p></div>
        </div>
        <div class="d30-benefit">
          <div class="d30-benefit-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
          <div><h3>A Better You</h3><p>More clarity, energy and direction.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Day Index Grid -->
  <section class="d30-journey">
    <div class="container">
      <div class="journal-section-head">
        <h2 class="journal-section-title">The 30-Day <em>Journey</em></h2>
        <p class="d30-journey-label">30 Days. Real Progress.</p>
      </div>
      <div class="d30-grid">
        {allDays.map((d) => (
          <a href={`#day-${d.n}`} class={`d30-grid-item${d.n === 1 ? ' active' : ''}`}>Day {d.n}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Day Cards (all 30, organized by week) -->
  {weeks.map((week) => (
    <section class="d30-week">
      <div class="container">
        <div class="d30-week-head">
          <p class="d30-week-kicker">{week.label}</p>
          <h2 class="d30-week-title">{week.title}</h2>
        </div>
        <div class="d30-days">
          {week.days.map((d) => (
            <article class="d30-day-card" id={`day-${d.n}`}>
              <span class="d30-day-num">{String(d.n).padStart(2, '0')}</span>
              <div class="d30-day-body">
                <h3 class="d30-day-title">{d.title}</h3>
                <p class="d30-day-text">{d.text}</p>
                <p class="d30-day-action"><strong>Challenge:</strong> {d.action}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Quote -->
  <section class="d30-quote">
    <div class="container">
      <div class="d30-quote-inner">
        <div class="d30-quote-text-wrap">
          <p class="d30-quote-label">Discipline Mindset</p>
          <blockquote class="d30-quote-block">"You don't rise to the level of your goals. You fall to the level of <em>your systems</em>."</blockquote>
          <p class="d30-quote-attr">— James Clear</p>
        </div>
        <div class="d30-quote-img">
          <img src="/images/path.jpg" alt="Mountain path at sunrise" loading="lazy" width="600" height="400" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="d30-faq">
    <div class="container">
      <div class="journal-section-head">
        <h2 class="journal-section-title">Common <em>Questions</em></h2>
        <p class="d30-journey-label">Keep it Simple.</p>
      </div>
      <div class="d30-faq-list">
        <details class="d30-faq-item">
          <summary>What is the 30 Days of Discipline program?</summary>
          <p>A free, practical 30-day challenge. Each day gives you one small action that takes 5 minutes or less. Complete all 30 days to build lasting discipline and consistency.</p>
        </details>
        <details class="d30-faq-item">
          <summary>Do I need an account?</summary>
          <p>No. The entire program is free and accessible on one page. No sign-up, no login, no tracking. Just show up and do the daily action.</p>
        </details>
        <details class="d30-faq-item">
          <summary>How does it work?</summary>
          <p>Each day has one challenge — a small, concrete action. Start at Day 1, complete the action, then move to Day 2. You can download the PDF version to track your progress offline.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- PDF Download -->
  <section class="d30-pdf" id="subscribe">
    <div class="container">
      <div class="d30-pdf-inner">
        <div class="d30-pdf-text">
          <p class="d30-pdf-label">Get the PDF</p>
          <h2>Download "30 Days of Discipline"</h2>
          <p>Take the program with you. One clean PDF, ready to print or use on any device.</p>
        </div>
        <div class="d30-pdf-actions">
          <a href="/30-days-discipline.pdf" download class="d30-pdf-btn">Download PDF</a>
          <form class="d30-pdf-form" id="pdf-form" novalidate>
            <input type="text" name="name" placeholder="Name (optional)" aria-label="Name" autocomplete="name" />
            <input type="email" name="email" placeholder="Or get it via email" aria-label="Email address" required autocomplete="email" />
            <button type="submit">Send →</button>
          </form>
          <p id="pdf-msg" class="d30-pdf-msg" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const pdfForm = document.getElementById("pdf-form") as HTMLFormElement | null;
    const pdfMsg = document.getElementById("pdf-msg");
    pdfForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(pdfForm);
      const email = String(fd.get("email") || "").trim();
      const name = String(fd.get("name") || "").trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (pdfMsg) { pdfMsg.textContent = "Please enter a valid email."; pdfMsg.style.color = "#ff4d00"; }
        return;
      }
      if (pdfMsg) { pdfMsg.textContent = "Sending..."; pdfMsg.style.color = "#888"; }
      try {
        const res = await fetch("https://formsubmit.co/ajax/raihaneucef@gmail.com", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            name: name || "(no name)",
            email,
            _subject: "New 30 Days of Discipline subscriber",
            _template: "table",
            _response: "Thanks! Your free PDF: https://the-motivahub.com/30-days-discipline.pdf",
            source: "30-days-discipline-page"
          })
        });
        if (res.ok) {
          if (pdfMsg) { pdfMsg.textContent = "✓ Check your inbox for the PDF link."; pdfMsg.style.color = "#4caf50"; }
          pdfForm.reset();
        } else throw new Error("failed");
      } catch {
        if (pdfMsg) { pdfMsg.textContent = "Something went wrong. Try the direct download."; pdfMsg.style.color = "#ff4d00"; }
      }
    });
  </script>
</Layout>
