---
import Layout from "../../layouts/Layout.astro";
import NewsletterSection from "../../components/NewsletterSection.astro";
---

<Layout title="30 Days of Discipline — Free Guide | Motiva Hub" description="A free 30-day challenge to build unshakable discipline. One small act per day — transforms your life by the end.">
  <section class="page-head">
    <div class="container">
      <p class="kicker">FREE GUIDE</p>
      <h1>30 Days of <em>Discipline</em></h1>
      <p>A free challenge to build unshakable discipline. One small act per day — transforms your life by the end.</p>
      <div class="hero-btns" style="margin-top:1.5rem;">
        <a class="btn-pill" href="#day-1">Start Day 1</a>
        <a class="btn-pill btn-pill-outline" href="#subscribe">Get the PDF</a>
      </div>
    </div>
  </section>

  <section class="premise">
    <div class="container">
      <div class="pillars">
        <div class="pillar">
          <p class="pillar-num">30</p>
          <p class="pillar-word">Days</p>
          <p>One challenge per day. No excuses.</p>
        </div>
        <div class="pillar">
          <p class="pillar-num">5</p>
          <p class="pillar-word">Min</p>
          <p>Each task takes 5 minutes or less.</p>
        </div>
        <div class="pillar">
          <p class="pillar-num">1</p>
          <p class="pillar-word">Life</p>
          <p>One month changes everything.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">Week 1 — Foundation</p>
        <h2>Build the Base</h2>
      </div>

      <div class="day-cards">
        <article class="day-card" id="day-1">
          <span class="day-num">01</span>
          <div class="day-body">
            <h3>Wake Up at the Same Time</h3>
            <p>Set one alarm. Get out of bed on the first ring. No snooze. Your day starts with discipline, not negotiation.</p>
            <p class="day-action">Challenge: Wake up at 6:00 AM tomorrow. No exceptions.</p>
          </div>
        </article>

        <article class="day-card" id="day-2">
          <span class="day-num">02</span>
          <div class="day-body">
            <h3>Make Your Bed</h3>
            <p>The first small win of the day. A made bed signals: I am in control. Admiral William McRaven was right — it changes the world.</p>
            <p class="day-action">Challenge: Make your bed within 2 minutes of waking up.</p>
          </div>
        </article>

        <article class="day-card" id="day-3">
          <span class="day-num">03</span>
          <div class="day-body">
            <h3>Cold Shower — 30 Seconds</h3>
            <p>End your shower with 30 seconds of cold water. It trains your brain to do hard things voluntarily.</p>
            <p class="day-action">Challenge: Turn the water cold for the last 30 seconds.</p>
          </div>
        </article>

        <article class="day-card" id="day-4">
          <span class="day-num">04</span>
          <div class="day-body">
            <h3>Write 3 Things You're Grateful For</h3>
            <p>Discipline is not just physical. Gratitude trains your mind to see what matters. Write them by hand.</p>
            <p class="day-action">Challenge: Before bed, write 3 gratitudes in a notebook.</p>
          </div>
        </article>

        <article class="day-card" id="day-5">
          <span class="day-num">05</span>
          <div class="day-body">
            <h3>No Phone for the First Hour</h3>
            <p>Your morning belongs to you, not to notifications. The first hour sets the tone for everything.</p>
            <p class="day-action">Challenge: Leave your phone in another room until 7:00 AM.</p>
          </div>
        </article>

        <article class="day-card" id="day-6">
          <span class="day-num">06</span>
          <div class="day-body">
            <h3>10 Push-Ups</h3>
            <p>Discipline lives in the body. Ten push-ups is nothing — but doing them when you don't want to is everything.</p>
            <p class="day-action">Challenge: Drop and do 10 push-ups right now.</p>
          </div>
        </article>

        <article class="day-card" id="day-7">
          <span class="day-num">07</span>
          <div class="day-body">
            <h3>Review Your Week</h3>
            <p>What did you do? What did you skip? Write it down. Self-awareness is the foundation of growth.</p>
            <p class="day-action">Challenge: Spend 10 minutes reviewing your week honestly.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">Week 2 — Consistency</p>
        <h2>Stack the Habits</h2>
      </div>

      <div class="day-cards">
        <article class="day-card" id="day-8">
          <span class="day-num">08</span>
          <div class="day-body">
            <h3>Eat One Healthy Meal</h3>
            <p>You don't need a diet. You need one good meal. Cook it, eat it slowly, notice how you feel.</p>
            <p class="day-action">Challenge: Prepare and eat one nutritious meal today.</p>
          </div>
        </article>

        <article class="day-card" id="day-9">
          <span class="day-num">09</span>
          <div class="day-body">
            <h3>Read 10 Pages</h3>
            <p>Not a chapter. Not a book. Just 10 pages. Consistency beats intensity every single time.</p>
            <p class="day-action">Challenge: Read 10 pages of any book before bed.</p>
          </div>
        </article>

        <article class="day-card" id="day-10">
          <span class="day-num">10</span>
          <div class="day-body">
            <h3>Walk 20 Minutes</h3>
            <p>Movement is medicine. A 20-minute walk clears your mind, strengthens your body, and builds the habit of showing up.</p>
            <p class="day-action">Challenge: Walk for 20 minutes without your phone.</p>
          </div>
        </article>

        <article class="day-card" id="day-11">
          <span class="day-num">11</span>
          <div class="day-body">
            <h3>Say No to One Distraction</h3>
            <p>One notification ignored. One scroll session skipped. Every "no" to distraction is a "yes" to your future.</p>
            <p class="day-action">Challenge: Identify your biggest distraction and avoid it for 2 hours.</p>
          </div>
        </article>

        <article class="day-card" id="day-12">
          <span class="day-num">12</span>
          <div class="day-body">
            <h3>Plan Tomorrow Tonight</h3>
            <p>Write down your top 3 priorities for tomorrow. Wake up with direction, not confusion.</p>
            <p class="day-action">Challenge: Before bed, write your 3 priorities for tomorrow.</p>
          </div>
        </article>

        <article class="day-card" id="day-13">
          <span class="day-num">13</span>
          <div class="day-body">
            <h3>5 Minutes of Silence</h3>
            <p>Sit alone. No music. No phone. No thoughts — just observe. The mind that can be still can do anything.</p>
            <p class="day-action">Challenge: Sit in complete silence for 5 minutes.</p>
          </div>
        </article>

        <article class="day-card" id="day-14">
          <span class="day-num">14</span>
          <div class="day-body">
            <h3>Week 2 Review</h3>
            <p>Two weeks in. Are you consistent? Write down what worked, what didn't, and what you'll change.</p>
            <p class="day-action">Challenge: Review your progress honestly. Adjust if needed.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">Week 3 — Challenge</p>
        <h2>Push the Limits</h2>
      </div>

      <div class="day-cards">
        <article class="day-card" id="day-15">
          <span class="day-num">15</span>
          <div class="day-body">
            <h3>Cold Shower — 1 Minute</h3>
            <p>You survived 30 seconds. Now double it. Comfort is the enemy of growth.</p>
            <p class="day-action">Challenge: 1 minute of cold water. Breathe through it.</p>
          </div>
        </article>

        <article class="day-card" id="day-16">
          <span class="day-num">16</span>
          <div class="day-body">
            <h3>No Complaining for 24 Hours</h3>
            <p>Zero complaints. Not about the weather. Not about work. Not about anything. Gratitude replaces complaint.</p>
            <p class="day-action">Challenge: Go the entire day without complaining once.</p>
          </div>
        </article>

        <article class="day-card" id="day-17">
          <span class="day-num">17</span>
          <div class="day-body">
            <h3>20 Push-Ups + 20 Squats</h3>
            <p>The body is getting stronger. Prove it to yourself. Double what you did on Day 6.</p>
            <p class="day-action">Challenge: 20 push-ups and 20 squats. No rest between.</p>
          </div>
        </article>

        <article class="day-card" id="day-18">
          <span class="day-num">18</span>
          <div class="day-body">
            <h3>Do the Thing You've Been Avoiding</h3>
            <p>That email. That conversation. That task. Do it today. Discipline means doing what needs to be done.</p>
            <p class="day-action">Challenge: Complete the one task you've been putting off.</p>
          </div>
        </article>

        <article class="day-card" id="day-19">
          <span class="day-num">19</span>
          <div class="day-body">
            <h3>Eat Clean All Day</h3>
            <p>No junk food. No sugar. No processed food. One clean day shows you what your body is capable of.</p>
            <p class="day-action">Challenge: Eat only whole foods for one full day.</p>
          </div>
        </article>

        <article class="day-card" id="day-20">
          <span class="day-num">20</span>
          <div class="day-body">
            <h3>Wake Up at 5:00 AM</h3>
            <p>You've been training for 20 days. Now wake up an hour earlier. Own the morning before the world owns you.</p>
            <p class="day-action">Challenge: Alarm at 5:00 AM. Out of bed on the first ring.</p>
          </div>
        </article>

        <article class="day-card" id="day-21">
          <span class="day-num">21</span>
          <div class="day-body">
            <h3>Week 3 Review</h3>
            <p>Three weeks. You're not the same person who started. Write down how you've changed.</p>
            <p class="day-action">Challenge: Journal about the person you're becoming.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">Week 4 — Mastery</p>
        <h2>Become the Person</h2>
      </div>

      <div class="day-cards">
        <article class="day-card" id="day-22">
          <span class="day-num">22</span>
          <div class="day-body">
            <h3>2 Minutes of Cold Water</h3>
            <p>You've come this far. Two minutes is nothing now. Your mind is stronger than it was on Day 3.</p>
            <p class="day-action">Challenge: 2 minutes cold shower. You've earned this.</p>
          </div>
        </article>

        <article class="day-card" id="day-23">
          <span class="day-num">23</span>
          <div class="day-body">
            <h3>Help Someone Today</h3>
            <p>Discipline is not selfish. Use your strength to lift someone else. A kind word, a helping hand, a moment of your time.</p>
            <p class="day-action">Challenge: Do one act of kindness for someone else.</p>
          </div>
        </article>

        <article class="day-card" id="day-24">
          <span class="day-num">24</span>
          <div class="day-body">
            <h3>30 Push-Ups + 30 Squats</h3>
            <p>Three times what you started with. The body follows the mind. You are proof.</p>
            <p class="day-action">Challenge: 30 push-ups and 30 squats. Feel the difference.</p>
          </div>
        </article>

        <article class="day-card" id="day-25">
          <span class="day-num">25</span>
          <div class="day-body">
            <h3>No Social Media for 24 Hours</h3>
            <p>One full day. No scrolling. No stories. No reels. You'll survive. You might even thrive.</p>
            <p class="day-action">Challenge: Delete apps for 24 hours. Reinstall tomorrow.</p>
          </div>
        </article>

        <article class="day-card" id="day-26">
          <span class="day-num">26</span>
          <div class="day-body">
            <h3>Write Your Future Self a Letter</h3>
            <p>Where will you be in one year? Write to that person. Tell them what you started. Tell them why.</p>
            <p class="day-action">Challenge: Write a letter to yourself, one year from now.</p>
          </div>
        </article>

        <article class="day-card" id="day-27">
          <span class="day-num">27</span>
          <div class="day-body">
            <h3>Fast Until Lunch</h3>
            <p>Hunger is a feeling, not an emergency. Skip breakfast. Eat at noon. Learn the difference between want and need.</p>
            <p class="day-action">Challenge: Eat only after 12:00 PM.</p>
          </div>
        </article>

        <article class="day-card" id="day-28">
          <span class="day-num">28</span>
          <div class="day-body">
            <h3>Run or Walk 5K</h3>
            <p>28 days of discipline led here. Move your body for 5 kilometers. You are not who you were on Day 1.</p>
            <p class="day-action">Challenge: Complete 5K — run, jog, or walk.</p>
          </div>
        </article>

        <article class="day-card" id="day-29">
          <span class="day-num">29</span>
          <div class="day-body">
            <h3>Teach Someone What You've Learned</h3>
            <p>Share one lesson from this journey with a friend, a family member, a colleague. Teaching cements learning.</p>
            <p class="day-action">Challenge: Tell one person what 30 days of discipline taught you.</p>
          </div>
        </article>

        <article class="day-card" id="day-30">
          <span class="day-num">30</span>
          <div class="day-body">
            <h3>Start Again — Day 1</h3>
            <p>You finished. But discipline has no finish line. Start again. This time, you know who you are.</p>
            <p class="day-action">Challenge: Tomorrow is Day 1 again. Will you show up?</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="newsletter" id="subscribe">
    <div class="container">
      <p class="kicker">GET THE PDF</p>
      <h2>Download "30 Days of Discipline"</h2>
      <p class="newsletter-sub">Enter your email and receive the free PDF guide — printable, shareable, and ready to start.</p>
      <form class="newsletter-form" id="pdf-form" novalidate>
        <input type="text" name="name" placeholder="Name (optional)" aria-label="Name" autocomplete="name">
        <input type="email" name="email" placeholder="Your email address *" aria-label="Email address" required autocomplete="email">
        <button type="submit" class="btn-pill btn-pill-cream">Get the Free PDF</button>
      </form>
      <p id="pdf-msg" class="newsletter-note" aria-live="polite"></p>
      <p class="newsletter-note">No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  <style>
    .day-cards { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem; }
    .day-card {
      display: flex; gap: 1.5rem; align-items: flex-start;
      padding: 1.5rem; border-radius: 12px;
      background: var(--cream); border: 1px solid var(--gold-light);
      transition: transform 0.2s;
    }
    .day-card:hover { transform: translateY(-2px); }
    .day-num {
      font-family: var(--font-display); font-size: 2.5rem; font-weight: 700;
      color: var(--gold); line-height: 1; min-width: 60px; text-align: center;
    }
    .day-body h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    .day-body p { color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
    .day-action {
      margin-top: 0.75rem; padding: 0.75rem 1rem;
      background: var(--ink); color: var(--cream); border-radius: 8px;
      font-size: 0.85rem; font-weight: 500;
    }
    @media (max-width: 600px) {
      .day-card { flex-direction: column; gap: 0.75rem; }
      .day-num { font-size: 2rem; min-width: auto; text-align: left; }
    }
  </style>

  <script>
    const pdfForm = document.getElementById("pdf-form");
    const pdfMsg = document.getElementById("pdf-msg");
    pdfForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(pdfForm);
      const email = String(fd.get("email") || "").trim();
      const name = String(fd.get("name") || "").trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        if (pdfMsg) { pdfMsg.textContent = "Please enter a valid email address."; pdfMsg.style.color = "#a67c52"; }
        return;
      }
      if (pdfMsg) { pdfMsg.textContent = "Sending..."; pdfMsg.style.color = "#6b665e"; }
      try {
        const res = await fetch("https://formsubmit.co/ajax/raihaneucef@gmail.com", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            name: name || "(no name)",
            email,
            _subject: "New 30 Days of Discipline subscriber",
            _template: "table",
            source: "30-days-discipline-page"
          })
        });
        if (res.ok) {
          if (pdfMsg) {
            pdfMsg.innerHTML = "Thanks! Your PDF is ready. <a href='#day-1' style='color:var(--gold);text-decoration:underline;'>Start Day 1 now →</a>";
            pdfMsg.style.color = "#121212";
          }
          pdfForm.reset();
        } else throw new Error("failed");
      } catch {
        if (pdfMsg) { pdfMsg.textContent = "Something went wrong. Please try again."; pdfMsg.style.color = "#a67c52"; }
      }
    });
  </script>
</Layout>
