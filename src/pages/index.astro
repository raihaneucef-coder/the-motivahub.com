---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Founder from "../components/Founder.astro";
import Quote from "../components/Quote.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import PodcastCard from "../components/PodcastCard.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getCollection } from "astro:content";
import { books } from "../data/books";
import { podcasts } from "../data/podcasts";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Motiva Hub — The Long Ascent. Mindset, habits, and the daily discipline of becoming." description="A premium editorial sanctuary for the disciplined mind. Mindset, habits, books, and free tools — for the long ascent, one day at a time.">
  <Hero
    kicker="EST. 2025 · THE LONG ASCENT"
    title={`Build the discipline.<br/><em>One day at a time.</em>`}
    subtitle="Mindset, habits, books, and free tools — for the person who would rather be patient and unstoppable than loud and brief."
    image="/images/hero-stoic-ascent.jpg"
    primaryCta={{ label: "Start Reading", href: "/journal/" }}
    secondaryCta={{ label: "Take the Quiz", href: "/tools/discipline-quiz/" }}
    meta={[
      { num: "227+", label: "Editorial Pages" },
      { num: "5", label: "Free Tools" },
      { num: "EN · FR", label: "Bilingue" },
      { num: "30", label: "Day Programs" },
    ]}
  />

  <section class="trust-strip">
    <div class="container trust-inner">
      <span class="trust-label">The books that built the work</span>
      <div class="trust-logos">
        <span class="trust-logo">Atomic Habits</span>
        <span class="trust-logo-bold">CAN'T HURT ME</span>
        <span class="trust-logo">Meditations</span>
        <span class="trust-logo-bold">DEEP WORK</span>
        <span class="trust-logo">The Daily Stoic</span>
        <span class="trust-logo-bold">30 DAYS</span>
      </div>
    </div>
  </section>

  <Manifesto />

  <Founder />

  <section>
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The Journal</span>
        <div>
          <h2>Essays for the <em>long climb.</em></h2>
          <p>Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.</p>
        </div>
      </div>
      <div class="feed-grid reveal-stagger">
        {posts.slice(0, 6).map((post) => <ArticleCard post={post} />)}
      </div>
      <div class="text-center" style="margin-top:48px;">
        <a class="btn-arrow" href="/journal/">Read all essays</a>
      </div>
    </div>
  </section>

  <section class="section-dark">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Free Tools</span>
        <div>
          <h2>Not just reading. <em>Doing.</em></h2>
          <p>Six tools, built for the people who would rather act than scroll. No accounts. No paywall. No noise.</p>
        </div>
      </div>
      <div class="feed-grid reveal-stagger">
        <a class="tool-card" href="/tools/discipline-quiz/">
          <p class="tool-card-num">01</p>
          <h3 class="tool-card-title">Discipline Type Quiz</h3>
          <p class="tool-card-desc">Five questions. One archetype. Find the kind of disciplined person you actually are — and what to do about it.</p>
          <span class="tool-card-link">Take the quiz</span>
        </a>
        <a class="tool-card" href="/tools/habit-stacker/">
          <p class="tool-card-num">02</p>
          <h3 class="tool-card-title">Habit Stack Generator</h3>
          <p class="tool-card-desc">James Clear's formula. One anchor. One new habit. One 30-day plan, generated in 60 seconds.</p>
          <span class="tool-card-link">Build the stack</span>
        </a>
        <a class="tool-card" href="/tools/meditation-timer/">
          <p class="tool-card-num">03</p>
          <h3 class="tool-card-title">Meditation Timer</h3>
          <p class="tool-card-desc">Web audio bells. Seven presets. A daily practice you can hear — no app, no account, no friction.</p>
          <span class="tool-card-link">Start the bell</span>
        </a>
        <a class="tool-card" href="/tools/cold-shower-tracker/">
          <p class="tool-card-num">04</p>
          <h3 class="tool-card-title">Cold Shower Tracker</h3>
          <p class="tool-card-desc">Build the streak. Track every cold shower. Export the data. Watch the daily discomfort compound.</p>
          <span class="tool-card-link">Begin the streak</span>
        </a>
        <a class="tool-card" href="/tools/reading-calculator/">
          <p class="tool-card-num">05</p>
          <h3 class="tool-card-title">Reading Calculator</h3>
          <p class="tool-card-desc">How many books can you actually read this year? Set the daily page target. Make the math honest.</p>
          <span class="tool-card-link">Run the numbers</span>
        </a>
        <a class="tool-card" href="/pdf/30-days-discipline/">
          <p class="tool-card-num">06</p>
          <h3 class="tool-card-title">30 Days of Discipline</h3>
          <p class="tool-card-desc">One page a day, for one month. A free PDF that turns these ideas into a daily practice you can hold.</p>
          <span class="tool-card-link">Get the PDF</span>
        </a>
      </div>
    </div>
  </section>

  <Quote />

  <section class="section-cream-deep">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">The Wisdom Stack</span>
        <div>
          <h2>Books that <em>built the work.</em></h2>
          <p>The texts that shaped Motiva Hub. The texts that will outlast the noise. Read slowly. Re-read often.</p>
        </div>
      </div>
      <div class="feed-grid reveal-stagger">
        {books.slice(0, 8).map((book) => <BookCard book={book} />)}
      </div>
      <div class="text-center" style="margin-top:48px;">
        <a class="btn-arrow" href="/books/">The full bookstand</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Listen</span>
        <div>
          <h2>The Daily Drive · <em>Podcast</em></h2>
          <p>Conversations with the people doing the quiet work — founders, athletes, monks, and the writers who shaped how we think.</p>
        </div>
      </div>
      <div class="feed-grid reveal-stagger">
        {podcasts.slice(0, 3).map((p) => <PodcastCard podcast={p} />)}
      </div>
    </div>
  </section>

  <NewsletterSection showPdf={true} />
</Layout>
