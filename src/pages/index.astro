---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Wild Family — Family Adventures in Nature" description="Practical guides for camping, hiking, and outdoor adventures with your family. Screen-free activities, checklists, and tips that actually work.">
  <section class="hero">
    <div class="container">
      <h1>Family adventures in nature, without the stress</h1>
      <p>Camping checklists, kid-friendly hikes, and screen-free activities — practical guides for families who want real outdoor memories.</p>
      <a class="btn" href="/blog/">Read the Blog</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Latest Articles</h2>
      <p class="section-sub">Fresh, practical guides written for real families — no fluff, no perfectionism, just what works.</p>
      <div class="grid">
        {
          posts.map((post) => (
            <article class="card">
              <p class="card-meta">{post.data.category}</p>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <p class="card-meta" style="margin-top: 16px;">{post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 32px;"><a class="btn" href="/blog/">All Articles</a></p>
    </div>
  </section>

  <section class="section" style="background: var(--green-100);">
    <div class="container">
      <h2 class="section-title">What We Write About</h2>
      <div class="grid">
        <div class="card">
          <h3>🏕️ Camping</h3>
          <p>Complete packing checklists, campfire safety, and meal plans that turn camping with kids from a disaster into a tradition.</p>
        </div>
        <div class="card">
          <h3>🥾 Hiking</h3>
          <p>Easy trails, hiking games, and gear lists built for toddler legs and family pace — because kids hike for features, not views.</p>
        </div>
        <div class="card">
          <h3>🌿 Nature Play</h3>
          <p>Screen-free activities that need nothing but a backyard. Mud kitchens, bug safaris, scavenger hunts — simple fun that works.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>