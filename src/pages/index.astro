---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import GoalTracker from "../components/GoalTracker.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getCollection } from "astro:content";
import { books } from "../data/books";
import { quotes, getDailyQuote } from "../data/quotes";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const daily = getDailyQuote();
---

<Layout title="Motiva Hub — Unlock your potential with the Daily Drive" description="A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.">
  <Hero
    kicker="Motiva Hub · The Daily Drive"
    title="Unlock your potential with the Daily Drive."
    subtitle="A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time."
    image="/images/hero.jpg"
    primaryCta={{ label: "Explore the Guides", href: "/journal/" }}
    secondaryCta={{ label: "Start with Mindset", href: "/objectives/" }}
  />

  <section class="premise">
    <div class="container">
      <p class="kicker" data-i18n="premiseKicker">The Premise</p>
      <h2 class="premise-title" data-i18n="premiseTitle">Motivation is a visitor. <em>Discipline is a resident.</em> We do not chase the feeling — we build the room it returns to, day after day, until the practice becomes the person.</h2>
      <div class="premise-line"></div>
      <div class="pillars">
        <div class="pillar">
          <p class="pillar-num">01</p>
          <p class="pillar-word" data-i18n="clarity">Clarity</p>
          <p data-i18n="clarityDesc">We strip away the noise to find the one thing that matters.</p>
        </div>
        <div class="pillar">
          <p class="pillar-num">02</p>
          <p class="pillar-word" data-i18n="consistency">Consistency</p>
          <p data-i18n="consistencyDesc">Small, repeated acts compound into an unrecognisable life.</p>
        </div>
        <div class="pillar">
          <p class="pillar-num">03</p>
          <p class="pillar-word" data-i18n="composure">Composure</p>
          <p data-i18n="composureDesc">The mind that can hold its centre decides the shape of the day.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">The Journal</p>
        <a class="link-ochre" href="/journal/">All Essays →</a>
      </div>
      <div class="grid">
        {posts.slice(0, 6).map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="quote-band" style="background: var(--ink);">
    <div class="container">
      <p class="kicker" style="color: var(--gold-light);">The Daily Quote</p>
      <blockquote class="band-quote">
        <p>"{daily.quote}"</p>
        <cite>— {daily.author}, {daily.source}</cite>
      </blockquote>
      <a class="link-ochre" href="/quotes/" style="color: var(--gold-light);">All Quotes →</a>
    </div>
  </section>

  <section class="bookstand">
    <div class="container">
      <div class="feed-head">
        <p class="kicker" style="color: var(--gold-light);">The Wisdom Stack — The Bookstand</p>
        <a class="link-ochre" href="/books/" style="color: var(--gold-light);">All Books →</a>
      </div>
      <div class="book-grid">
        {books.slice(0, 8).map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <section class="premise">
    <div class="container">
      <SectionHeader kicker="The Long Ascent" title="One idea at a time. <em>Every day.</em>" subtitle="Join thousands of readers building a stronger mind, one Daily Drive at a time." />
      <div class="hero-btns">
        <a class="btn-pill" href="/objectives/">Set Today's Objectives</a>
        <a class="btn-pill btn-pill-outline" href="/journal/">Read the Journal</a>
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>