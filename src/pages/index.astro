---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Motiva Hub — Unlock your potential with the Daily Drive" description="Family camping, hiking, and nature guides — practical checklists and screen-free activities for real outdoor memories.">
  <section class="hero">
    <div class="container">
      <p class="kicker">An Editorial Sanctuary for Outdoor Families</p>
      <h1>Family adventures in nature, without the stress</h1>
      <p>Camping checklists, kid-friendly hikes, and screen-free activities — practical guides for families who want real outdoor memories.</p>
      <a class="btn" href="/blog/">Read the Journal</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="kicker">The Journal</p>
        <h2 class="section-title">Latest Essays</h2>
        <p class="section-sub">Fresh, practical guides written for real families — no fluff, no perfectionism, just what works.</p>
      </div>
      <div class="grid">
        {
          posts.map((post, i) => (
            <article class="card">
              <p class="card-meta">{post.data.category}</p>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <p class="card-meta" style="margin-top: 18px;">{post.data.pubDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
              <a class="read-more" href={`/blog/${post.id}/`}>Read More</a>
            </article>
          ))
        }
      </div>
      <p style="text-align: center; margin-top: 54px;"><a class="btn" href="/blog/">All Articles</a></p>
    </div>
  </section>

  <section class="section" style="background: var(--white);">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Departments</p>
        <h2 class="section-title">What We Write About</h2>
      </div>
      <div class="grid">
        <article class="card">
          <p class="card-num">01</p>
          <h3>Camping</h3>
          <p>Complete packing checklists, campfire safety, and meal plans that turn camping with kids from a disaster into a tradition.</p>
        </article>
        <article class="card">
          <p class="card-num">02</p>
          <h3>Hiking</h3>
          <p>Easy trails, hiking games, and gear lists built for toddler legs and family pace — because kids hike for features, not views.</p>
        </article>
        <article class="card">
          <p class="card-num">03</p>
          <h3>Nature Play</h3>
          <p>Screen-free activities that need nothing but a backyard. Mud kitchens, bug safaris, scavenger hunts — simple fun that works.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>