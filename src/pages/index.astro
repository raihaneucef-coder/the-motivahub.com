---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import BookCard from "../components/BookCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import GoalTracker from "../components/GoalTracker.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getCollection } from "astro:content";
import { books } from "../data/books";
import { quotes, getDailyQuote } from "../data/quotes";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const daily = getDailyQuote();
---

<Layout title="Motiva Hub — Unlock your potential with the Daily Drive" description="A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.">
  <Hero
    kicker="Motiva Hub · The Daily Drive"
    title="Unlock your potential with the Daily Drive."
    subtitle="A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time."
    image="/images/hero.jpg"
    primaryCta={{ label: "Explore the Guides", href: "/journal/" }}
    secondaryCta={{ label: "Start with Mindset", href: "/objectives/" }}
  />

  <section class="premise">
    <div class="container">
      <SectionHeader kicker="The Premise" title="Motivation is a visitor. <em>Discipline is a resident.</em>" subtitle="We do not chase the feeling — we build the room it returns to. The long ascent is climbed one idea at a time." />
      <div class="pillars">
        <div class="pillar">
          <p class="pillar-word">Clarity</p>
          <p>We strip away the noise to find the one thing that matters.</p>
        </div>
        <div class="pillar">
          <p class="pillar-word">Consistency</p>
          <p>Small, repeated acts compound into an unrecognisable life.</p>
        </div>
        <div class="pillar">
          <p class="pillar-word">Composure</p>
          <p>The mind that can hold its centre decides the shape of the day.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="goals-section" style="background: var(--white);">
    <div class="container">
      <GoalTracker />
    </div>
  </section>

  <section class="feed">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">The Journal</p>
        <a class="link-ochre" href="/journal/">All Essays →</a>
      </div>
      <div class="grid">
        {posts.slice(0, 3).map((post) => <ArticleCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="quote-band" style="background: var(--ink);">
    <div class="container">
      <p class="kicker" style="color: var(--gold-light);">The Daily Quote</p>
      <blockquote class="band-quote">
        <p>"{daily.quote}"</p>
        <cite>— {daily.author}, {daily.source}</cite>
      </blockquote>
      <a class="link-ochre" href="/quotes/" style="color: var(--gold-light);">All Quotes →</a>
    </div>
  </section>

  <section class="blueprint">
    <div class="container">
      <div class="feed-head">
        <p class="kicker">The Wisdom Stack</p>
        <a class="link-ochre" href="/books/">All Books →</a>
      </div>
      <div class="book-grid">
        {books.slice(0, 3).map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <section class="premise">
    <div class="container">
      <SectionHeader kicker="The Long Ascent" title="One idea at a time. <em>Every day.</em>" subtitle="Join thousands of readers building a stronger mind, one Daily Drive at a time." />
      <div class="hero-btns">
        <a class="btn-pill" href="/objectives/">Set Today's Objectives</a>
        <a class="btn-pill btn-pill-outline" href="/journal/">Read the Journal</a>
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>