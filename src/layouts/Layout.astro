---
import { GA_ID, GSC_VERIFICATION } from "../data/analytics";
import MegaMenu from "../components/MegaMenu.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  lang?: "en" | "fr";
}

const { title, description, image = "/images/youssef-raihane.jpg", noindex = false, ogType = "website", lang } = Astro.props;
const canonical = Astro.url.href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
const isFr = lang === "fr" || Astro.url.pathname.startsWith("/fr") || Astro.url.searchParams.get("lang") === "fr";
const htmlLang = isFr ? "fr" : "en";
const ogLocale = isFr ? "fr_FR" : "en_US";
const ogLocaleAlt = isFr ? "en_US" : "fr_FR";
const gaSnippet = GA_ID
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`
  : "";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Motiva Hub" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {ogType === "article" && (
      <>
        <meta property="article:author" content="Youssef Raihane" />
        <meta property="article:section" content="Self-Improvement" />
      </>
    )}
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="google-adsense-account" content="ca-pub-7700455846106476">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7700455846106476" crossorigin="anonymous"></script>
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <meta name="impact-site-verification" content="e2d5e2d9-5097-4b2d-b582-7d63c33ec316" />
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={gaSnippet}></script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://the-motivahub.com/#organization",
          "name": "Motiva Hub",
          "url": "https://the-motivahub.com",
          "logo": { "@type": "ImageObject", "url": "https://the-motivahub.com/logo.jpg" },
          "founder": { "@type": "Person", "@id": "https://the-motivahub.com/author/youssef-raihane/#person", "name": "Youssef Raihane", "url": "https://the-motivahub.com/author/youssef-raihane/" },
          "sameAs": [
            "https://www.instagram.com/motivahub/",
            "https://twitter.com/motivahub"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://the-motivahub.com/#website",
          "url": "https://the-motivahub.com",
          "name": "Motiva Hub",
          "description": "A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.",
          "publisher": { "@id": "https://the-motivahub.com/#organization" },
          "inLanguage": ["en", "fr"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://the-motivahub.com/journal/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner container">
        <a href="/" class="logo logo-text" data-magnetic>
          <span class="logo-word">Motiva <em>Hub</em></span>
        </a>
        <div class="header-actions">
          <div class="lang-switcher" aria-label="Language switcher">
            <button class="lang-btn active" data-lang="en" aria-label="Switch to English" aria-pressed="true">EN</button>
            <span class="lang-sep">/</span>
            <button class="lang-btn" data-lang="fr" aria-label="Passer en français" aria-pressed="false">FR</button>
          </div>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu" data-magnetic>
            <span data-i18n="menu">Menu</span>
            <span class="menu-btn-bars"><span></span><span></span></span>
          </button>
        </div>
      </div>
    </header>

    <MegaMenu />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
