            <a href="/contact/" data-i18n="footerContact">Contact</a>
            <a href="/privacy/" data-i18n="footerPrivacy">Privacy</a>
            <a href="/terms/" data-i18n="footerTerms">Terms</a>
            <a href="/affiliate-disclosure/" data-i18n="footerDisclosure">Disclosure</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuBtn = document.getElementById("menu-btn");
      const menuClose = document.getElementById("menu-close");
      const overlay = document.getElementById("overlay-menu");

      const onScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", onScroll);
      onScroll();

      const openMenu = () => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const closeMenu = () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };
      menuBtn.addEventListener("click", openMenu);
      menuClose.addEventListener("click", closeMenu);
      overlay.addEventListener("click", (e) => {
        const link = e.target.closest("a");
        if (link) closeMenu();
      });

      const resetOverlay = () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };

      const resetPageCurtain = () => {
        document.querySelectorAll(".page-curtain").forEach((el) => el.remove());
      };

      window.addEventListener("astro:page-load", () => {
        resetOverlay();
        resetPageCurtain();
      });
      window.addEventListener("pageshow", (event) => {
        resetOverlay();
        resetPageCurtain();
      });
    </script>
