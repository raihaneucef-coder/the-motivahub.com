    <script is:inline>
      function showCookieBanner(){document.getElementById('cookie-consent').style.display='flex';}
      function hideCookieBanner(){document.getElementById('cookie-consent').style.display='none';}
      function acceptCookies(){localStorage.setItem('cookie_consent','accepted');hideCookieBanner();}
      function declineCookies(){localStorage.setItem('cookie_consent','declined');hideCookieBanner();}
      if(!localStorage.getItem('cookie_consent'))setTimeout(showCookieBanner,2000);
    </script>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <script is:inline>
    (function () {
      const progress = document.getElementById('read-progress');
      if (!progress) return;
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const h = doc.scrollHeight - doc.clientHeight;
        const pct = h > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / h) * 100)) : 0;
        progress.style.setProperty('--progress', pct + '%');
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal, .reveal-stagger, .reveal-scale').forEach((el) => observer.observe(el));

      // (magnetic buttons + 3D card tilt + custom cursor removed for performance)

      // Page transition (fade-up on link click)
      document.querySelectorAll('a[href^="/"]:not([href^="//"])').forEach((a) => {
        a.addEventListener('click', (e) => {
          const href = a.getAttribute('href');
          if (href.startsWith('#') || a.target === '_blank' || e.metaKey || e.ctrlKey) return;
          if (document.querySelector('.page-leaving')) return;
          if (document.querySelector('.page-curtain')) return;
          e.preventDefault();
          const curtain = document.createElement('div');
          curtain.className = 'page-curtain';
          document.body.appendChild(curtain);
          requestAnimationFrame(() => curtain.classList.add('active'));
          const cleanup = () => {
            try { curtain.remove(); } catch (e) {}
          };
          setTimeout(() => { cleanup(); window.location.href = href; }, 120);
          window.addEventListener('pagehide', cleanup, { once: true });
          window.addEventListener('pageshow', cleanup, { once: true });
        });
      });
    })();
  </script>
