---
import { GA_ID, GSC_VERIFICATION } from "../data/analytics";
import MegaMenu from "../components/MegaMenu.astro";
import Link from "../components/Link.astro";
import { getLangFromUrl, getLocalePath } from "../utils/i18n";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  lang?: "en" | "fr" | "ar";
  schema?: any;
}

const { title, description, image = "/images/youssef-raihane.jpg", noindex = false, ogType = "website", lang, schema } = Astro.props;
const currentLocale = getLangFromUrl(Astro.url);
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(fr|en)/, '') || '/';
const canonical = Astro.url.href;
const enUrl = new URL(pathWithoutLocale, Astro.site ?? Astro.url.origin).href;
const frUrl = new URL(getLocalePath(pathWithoutLocale, 'fr'), Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
const isFr = lang === "fr" || (lang !== "ar" && Astro.url.pathname.startsWith("/fr") || Astro.url.searchParams.get("lang") === "fr");
const htmlLang = lang || (Astro.url.pathname.startsWith("/ar") ? "ar" : Astro.url.pathname.startsWith("/fr") ? "fr" : "en");
const ogLocale = lang === "ar" ? "ar_SA" : lang === "fr" ? "fr_FR" : "en_US";
const ogLocaleAlt = lang === "ar" ? "en_US" : lang === "fr" ? "en_US" : "fr_FR";
const gaSnippet = GA_ID
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`
  : "";
