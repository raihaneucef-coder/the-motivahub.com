        <div class="header-actions">
          <div class="lang-switcher" aria-label="Language switcher">
            <button class="lang-btn active" data-lang="en" aria-label="Switch to English" aria-pressed="true">EN</button>
            <span class="lang-sep">/</span>
            <button class="lang-btn" data-lang="fr" aria-label="Passer en français" aria-pressed="false">FR</button>
          </div>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu" data-i18n="menu">Menu</button>
        </div>
      </div>
    </header>

    <div class="overlay-menu" id="overlay-menu">
      <div class="overlay-head container">
        <a href="/" class="logo logo-cream">
          <img src="/logo.jpg" alt="Motiva Hub" class="logo-img" />
          <span class="logo-word">Motiva <em>Hub</em></span>
        </a>
        <button class="menu-btn menu-btn-cream" id="menu-close" aria-label="Close menu" data-i18n="close">Close</button>
      </div>
      <nav class="overlay-nav" aria-label="Fullscreen menu">
        <div class="overlay-nav-section">
          <p class="overlay-nav-heading">Pages</p>
          <a href="/">01 <span data-i18n="home">Home</span></a>
          <a href="/about/">02 <span data-i18n="about">About</span></a>
          <a href="/author/youssef-raihane/">03 <span>The Author</span></a>
          <a href="/topics/">04 <span data-i18n="topics">Topics</span></a>
          <a href="/contact/">05 <span data-i18n="contact">Contact</span></a>
        </div>
        <div class="overlay-nav-section">
          <p class="overlay-nav-heading">Read</p>
          <a href="/journal/">06 <span data-i18n="journal">Journal</span></a>
          <a href="/books/">07 <span data-i18n="books">Books</span></a>
          <a href="/quotes/">08 <span data-i18n="quotes">Quotes</span></a>
          <a href="/podcast/">09 <span data-i18n="podcast">Podcast</span></a>
        </div>
        <div class="overlay-nav-section">
          <p class="overlay-nav-heading">Best Of</p>
          <a href="/best/books/">10 <span>Best Self-Help Books</span></a>
          <a href="/best/focus-books/">11 <span>Best Focus Books</span></a>
          <a href="/best/habit-books/">12 <span>Best Habit Books</span></a>
          <a href="/best/stoicism-books/">13 <span>Best Stoicism Books</span></a>
        </div>
        <div class="overlay-nav-section">
          <p class="overlay-nav-heading">Tools</p>
          <a href="/tracker/">14 <span>Habit Tracker</span></a>
          <a href="/memento-mori/">15 <span>Memento Mori</span></a>
          <a href="/psychology/">16 <span>Psychology</span></a>
          <a href="/objectives/">17 <span>Daily Objectives</span></a>
          <a href="/30-days-discipline/">18 <span>30 Days of Discipline</span></a>
        </div>
      </nav>
      <div class="overlay-foot container">
        <button class="btn-pill btn-pill-cream" type="button" onclick="document.getElementById('newsletter')?.scrollIntoView({behavior:'smooth'}); document.getElementById('overlay-menu')?.classList.remove('open'); document.body.style.overflow='';">Subscribe</button>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-logo"><img src="/logo.jpg" alt="Motiva Hub" class="logo-img" /> Motiva <em>Hub</em></p>
          <p class="footer-tag" data-i18n="footerTag">The Daily Drive. Motivation, growth, and better habits, delivered daily.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/journal/">Journal</a>
          <a href="/topics/">Topics</a>
          <a href="/books/">Books</a>
          <a href="/best/books/">Best Books 2026</a>
          <a href="/best/focus-books/">Best Focus Books</a>
          <a href="/best/habit-books/">Best Habit Books</a>
          <a href="/best/stoicism-books/">Best Stoicism Books</a>
          <a href="/quotes/">Quotes</a>
          <a href="/podcast/">Podcast</a>
          <a href="/objectives/">Objectives</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
          <a href="/30-days-discipline/">30 Days of Discipline</a>
          <a href="/tracker/">Habit Tracker</a>
          <a href="/psychology/">Psychology</a>
          <a href="/memento-mori/">Memento Mori</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} Motiva Hub. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuBtn = document.getElementById("menu-btn");
      const menuClose = document.getElementById("menu-close");
      const overlay = document.getElementById("overlay-menu");

      const onScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", onScroll);
      onScroll();

      const openMenu = () => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const closeMenu = () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };
      menuBtn.addEventListener("click", openMenu);
      menuClose.addEventListener("click", closeMenu);
      overlay.addEventListener("click", (e) => {
        if (e.target.tagName === "A") closeMenu();
      });
    </script>
    <script is:inline>
      (function(){
        const dict = {
          en: { menu:"Menu", close:"Close", home:"Home", about:"About", topics:"Topics", journal:"Journal", books:"Books", quotes:"Quotes", podcast:"Podcast", contact:"Contact", footerTag:"The Daily Drive. Motivation, growth, and better habits, delivered daily.", heroKicker:"Motiva Hub · The Daily Drive", heroTitle:"Unlock your potential with the Daily Drive.", heroSubtitle:"A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.", heroPrimary:"Explore the Guides", heroSecondary:"Start with Mindset", journalKicker:"The Journal", journalTitle:"Essays for the <em>long climb.</em>", journalSubtitle:"Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.", searchPlaceholder:"Search by title, topic or keywords...", all:"All", noResults:"No results found.", premiseKicker:"The Premise", premiseTitle:"Motivation is a visitor. <em>Discipline is a resident.</em> We do not chase the feeling — we build the room it returns to, day after day, until the practice becomes the person.", clarity:"Clarity", clarityDesc:"We strip away the noise to find the one thing that matters.", consistency:"Consistency", consistencyDesc:"Small, repeated acts compound into an unrecognisable life.", composure:"Composure", composureDesc:"The mind that can hold its centre decides the shape of the day.", objectivesKicker:"Objectives", objectivesTitle:"The <em>Daily Drive.</em>", objectivesSubtitle:"Up to three objectives a day. Small, repeated acts compound into an unrecognisable life.", pillarOne:"One", pillarOneDesc:"Choose the single most important objective of the day — the one that makes everything else easier.", pillarTwo:"Two", pillarTwoDesc:"Keep it small enough to be unmissable. Momentum is built by completing, not by aiming high.", pillarThree:"Three", pillarThreeDesc:"Complete all three before the evening closes. The day is the unit of a life well lived.", booksKicker:"The Wisdom Stack", booksT