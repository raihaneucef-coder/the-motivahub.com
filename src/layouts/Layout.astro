        const enCache = new Map();
        const enTextCache = new Map();
        document.querySelectorAll("[data-i18n-html]").forEach(el=>{
          const k = el.getAttribute("data-i18n-html");
          // FR pages render French server-side; the English original is kept
          // in data-en-html so the toggle can restore it.
          if(k && !enCache.has(k)) enCache.set(k, el.getAttribute("data-en-html") || el.innerHTML);
        });
        document.querySelectorAll("[data-i18n]").forEach(el=>{
          const k = el.getAttribute("data-i18n");
          if(k && !enTextCache.has(k)) enTextCache.set(k, el.getAttribute("data-en-text") || el.textContent);
        });
        // FR article pages render the French body server-side (marked with
        // [data-ssr-fr]). Capture that French so toggling FR after EN
        // restores it — with the heading ids — without re-fetching
        // articles-fr.json or re-swapping from it.
        const ssrFr = !!document.querySelector("[data-ssr-fr]");
        const frCache = new Map();
        const frTextCache = new Map();
        if(ssrFr){
          document.querySelectorAll("[data-i18n-html][data-en-html]").forEach(el=>{
            const k = el.getAttribute("data-i18n-html");
            if(k && !frCache.has(k)) frCache.set(k, el.innerHTML);
          });
          document.querySelectorAll("[data-i18n][data-en-text]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(k && !frTextCache.has(k)) frTextCache.set(k, el.textContent);
          });
        }
        async function setLang(lang, initial){
          const baseDict = dict[lang] || dict.en;
          let t = {...baseDict};
          if(lang === "fr" && !ssrFr){
            try{
              const res = await fetch("/i18n/articles-fr.json");
              if(res.ok){
                const articles = await res.json();
                t = {...t, ...articles};
              }
            }catch(e){}
          }
          document.documentElement.lang = lang;
          localStorage.setItem("lang", lang);
          document.querySelectorAll("[data-i18n]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(lang === "en" && enTextCache.has(k)){
              el.textContent = enTextCache.get(k);
            } else if(lang === "fr" && ssrFr && el.hasAttribute("data-en-text")){
              if(!initial && frTextCache.has(k)) el.textContent = frTextCache.get(k);
            } else if(k && t[k]){
              el.textContent = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-html]").forEach(el=>{
            const k = el.getAttribute("data-i18n-html");
            if(lang === "en" && enCache.has(k)){
              el.innerHTML = enCache.get(k);
            } else if(lang === "fr" && ssrFr && el.hasAttribute("data-en-html")){
              if(!initial && frCache.has(k)) el.innerHTML = frCache.get(k);
            } else if(k && t[k]){
              el.innerHTML = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
            const k = el.getAttribute("data-i18n-placeholder");
            if(k && t[k]) el.setAttribute("placeholder", t[k]);
          });
          document.querySelectorAll(".lang-btn").forEach(b=>{
            const active = b.getAttribute("data-lang")===lang;
            b.classList.toggle("active", active);
            b.setAttribute("aria-pressed", active ? "true" : "false");
          });
          window.dispatchEvent(new CustomEvent("langchange", {detail: lang}));
        }
        async function initLang(){
          const path = window.location.pathname;
          const urlLang = path.startsWith('/fr') ? 'fr' : path.startsWith('/ar') ? 'ar' : 'en';
          const saved = localStorage.getItem('lang');
          const initial = (saved === 'fr' || saved === 'ar') && saved !== urlLang ? saved : urlLang;
          await setLang(initial, true);
        }
        initLang();
        document.querySelectorAll(".lang-btn").forEach(b=> b.addEventListener("click", ()=> setLang(b.getAttribute("data-lang")||"en")));
        window.setLang = setLang;
        window.i18nDict = dict;
      })();
    </script>
