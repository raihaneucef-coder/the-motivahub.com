---
import { GA_ID, GSC_VERIFICATION } from "../data/analytics";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/images/hero.jpg" } = Astro.props;
const canonical = Astro.url.href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.jpg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index, follow" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline>{`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`}</script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner container">
        <a href="/" class="logo">
          <img src="/logo.jpg" alt="Motiva Hub" class="logo-img" />
          <span class="logo-word">Motiva <em>Hub</em></span>
        </a>
        <div class="header-actions">
          <div class="lang-switcher" aria-label="Language switcher">
            <button class="lang-btn active" data-lang="en" aria-label="Switch to English" aria-pressed="true">EN</button>
            <span class="lang-sep">/</span>
            <button class="lang-btn" data-lang="fr" aria-label="Passer en français" aria-pressed="false">FR</button>
          </div>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu" data-i18n="menu">Menu</button>
        </div>
      </div>
    </header>

    <div class="overlay-menu" id="overlay-menu">
      <div class="overlay-head container">
        <a href="/" class="logo logo-cream">
          <img src="/logo.jpg" alt="Motiva Hub" class="logo-img" />
          <span class="logo-word">Motiva <em>Hub</em></span>
        </a>
        <button class="menu-btn menu-btn-cream" id="menu-close" aria-label="Close menu" data-i18n="close">Close</button>
      </div>
      <nav class="overlay-nav" aria-label="Fullscreen menu">
        <a href="/">01 <span data-i18n="home">Home</span></a>
        <a href="/about/">02 <span data-i18n="about">About</span></a>
        <a href="/topics/">03 <span data-i18n="topics">Topics</span></a>
        <a href="/journal/">04 <span data-i18n="journal">Journal</span></a>
        <a href="/books/">05 <span data-i18n="books">Books</span></a>
        <a href="/quotes/">06 <span data-i18n="quotes">Quotes</span></a>
        <a href="/podcast/">07 <span data-i18n="podcast">Podcast</span></a>
        <a href="/contact/">08 <span data-i18n="contact">Contact</span></a>
      </nav>
      <div class="overlay-foot container">
        <button class="btn-pill btn-pill-cream" type="button">Subscribe</button>
      </div>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <p class="footer-logo"><img src="/logo.jpg" alt="Motiva Hub" class="logo-img" /> Motiva <em>Hub</em></p>
          <p class="footer-tag" data-i18n="footerTag">The Daily Drive. Motivation, growth, and better habits, delivered daily.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/journal/">Journal</a>
          <a href="/topics/">Topics</a>
          <a href="/books/">Books</a>
          <a href="/quotes/">Quotes</a>
          <a href="/podcast/">Podcast</a>
          <a href="/objectives/">Objectives</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} Motiva Hub. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuBtn = document.getElementById("menu-btn");
      const menuClose = document.getElementById("menu-close");
      const overlay = document.getElementById("overlay-menu");

      const onScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", onScroll);
      onScroll();

      const openMenu = () => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const closeMenu = () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };
      menuBtn.addEventListener("click", openMenu);
      menuClose.addEventListener("click", closeMenu);
      overlay.addEventListener("click", (e) => {
        if (e.target.tagName === "A") closeMenu();
      });
    </script>
    <script is:inline>
      (function(){
        const dict = {
          en: { menu:"Menu", close:"Close", home:"Home", about:"About", topics:"Topics", journal:"Journal", books:"Books", quotes:"Quotes", podcast:"Podcast", contact:"Contact", footerTag:"The Daily Drive. Motivation, growth, and better habits, delivered daily.", heroKicker:"Motiva Hub · The Daily Drive", heroTitle:"Unlock your potential with the Daily Drive.", heroSubtitle:"A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.", heroPrimary:"Explore the Guides", heroSecondary:"Start with Mindset", journalKicker:"The Journal", journalTitle:"Essays for the <em>long climb.</em>", journalSubtitle:"Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.", searchPlaceholder:"Search by title, topic or keywords...", all:"All", noResults:"No results found." },
          fr: { menu:"Menu", close:"Fermer", home:"Accueil", about:"À propos", topics:"Thèmes", journal:"Journal", books:"Livres", quotes:"Citations", podcast:"Podcast", contact:"Contact", footerTag:"The Daily Drive. Motivation, croissance et meilleures habitudes, chaque jour.", heroKicker:"Motiva Hub · Le Quotidien", heroTitle:"Libérez votre potentiel avec le Daily Drive.", heroSubtitle:"Un sanctuaire éditorial premium pour l'esprit discipliné. État d'esprit, habitudes et longue ascension — une idée à la fois.", heroPrimary:"Explorer les Guides", heroSecondary:"Commencer par l'État d'esprit", journalKicker:"Le Journal", journalTitle:"Essais pour la <em>longue ascension.</em>", journalSubtitle:"État d'esprit, habitudes, discipline, productivité, travail profond — à lire lentement.", searchPlaceholder:"Rechercher par titre, thème ou mots-clés...", all:"Tous", noResults:"Aucun résultat trouvé." }
        };
        function setLang(lang){
          const t = dict[lang] || dict.en;
          document.documentElement.lang = lang;
          localStorage.setItem("lang", lang);
          document.querySelectorAll("[data-i18n]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(k && t[k]) {
              if(t[k].indexOf("<") !== -1) el.innerHTML = t[k];
              else el.textContent = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
            const k = el.getAttribute("data-i18n-placeholder");
            if(k && t[k]) el.setAttribute("placeholder", t[k]);
          });
          document.querySelectorAll(".lang-btn").forEach(b=>{
            const active = b.getAttribute("data-lang")===lang;
            b.classList.toggle("active", active);
            b.setAttribute("aria-pressed", active ? "true" : "false");
          });
        }
        document.querySelectorAll(".lang-btn").forEach(b=> b.addEventListener("click", ()=> setLang(b.getAttribute("data-lang")||"en")));
        const saved = localStorage.getItem("lang") || "en";
        setLang(saved);
        window.setLang = setLang;
      })();
    </script>
    <script is:inline>
      window.trackAffiliateClick = function(bookId, bookTitle){
        var payload = {event:"affiliate_click", bookId: bookId, bookTitle: bookTitle, timestamp: new Date().toISOString()};
        try{console.debug("[affiliate_click]", payload);}catch(e){}
        if (typeof window.gtag === "function") try{window.gtag("event","affiliate_click",{book_id:bookId, book_title:bookTitle});}catch(e){}
        if (Array.isArray(window.dataLayer)) try{window.dataLayer.push(payload);}catch(e){}
      };
    </script>
  </body>
</html>