---
import { GA_ID, GSC_VERIFICATION } from "../data/analytics";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Link from "../components/Link.astro";
import { getLangFromUrl, getFrenchSlug, getEnglishSlug } from "../utils/i18n";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  lang?: "en" | "fr" | "ar";
  schema?: any;
  // Optional canonical override (pagination page 1 points at /journal/).
  // Defaults to the page's own URL so every other page is unaffected.
  canonical?: string;
}

const { title, description, image = "/images/youssef-raihane.jpg", noindex = false, ogType = "website", lang, schema, canonical: canonicalOverride } = Astro.props;
const currentLocale = getLangFromUrl(Astro.url);
const canonical = canonicalOverride ?? Astro.url.href;
// hreflang alternates must point at the real sibling page: map the journal
// slug both ways (1 of 169 slugs differs, e.g. sleep-is-unfair-advantage <->
// sommeil-avantage-indefendable) instead of just stripping the /fr prefix,
// which used to declare 404 alternates for that article in both directions.
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const onFrPath = pathParts[0] === "fr";
const bodyParts = onFrPath ? pathParts.slice(1) : pathParts;
const altParts = bodyParts[0] === "journal" && bodyParts[1]
  ? [bodyParts[0], onFrPath ? getEnglishSlug(bodyParts[1]) : getFrenchSlug(bodyParts[1]), ...bodyParts.slice(2)]
  : bodyParts;
const tail = Astro.url.pathname.endsWith("/") ? "/" : "";
const enTwin = altParts.length === 0 ? "/" : "/" + altParts.join("/") + tail;
const frTwin = enTwin === "/" ? "/fr/" : "/fr" + enTwin;
const enUrl = new URL(onFrPath ? enTwin : Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const frUrl = new URL(onFrPath ? Astro.url.pathname : frTwin, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
const isFr = lang === "fr" || (lang !== "ar" && Astro.url.pathname.startsWith("/fr") || Astro.url.searchParams.get("lang") === "fr");
const htmlLang = lang || (Astro.url.pathname.startsWith("/ar") ? "ar" : Astro.url.pathname.startsWith("/fr") ? "fr" : "en");
const ogLocale = lang === "ar" ? "ar_SA" : lang === "fr" ? "fr_FR" : "en_US";
const ogLocaleAlt = lang === "ar" ? "en_US" : lang === "fr" ? "en_US" : "fr_FR";
// Cache-busting version of the global stylesheet: the file is served with a
// 1-year immutable header, so its URL must change whenever its content does.
const globalCssV = createHash("sha256")
  .update(readFileSync(new URL("../../public/styles/global.css", import.meta.url)))
  .digest("hex")
  .slice(0, 10);
const gaSnippet = GA_ID
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}`
  : "";
// Third-party scripts (AdSense, GA) are deferred to the first user interaction:
// keeps first paint free of render-blocking/cookie-setting third-party requests.
const deferTpl = (body: string) =>
  `(function(){var done=false;function load(){if(done)return;done=true;${body}}["scroll","pointerdown","keydown","touchstart"].forEach(function(e){window.addEventListener(e,load,{once:true,passive:true});});})();`;
const deferAds = deferTpl(
  `var s=document.createElement("script");s.async=true;s.crossOrigin="anonymous";s.src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7700455846106476";document.head.appendChild(s);`
);
const deferGa = GA_ID
  ? deferTpl(
      `gtag('js',new Date());gtag('config','${GA_ID}');var s=document.createElement("script");s.async=true;s.src="https://www.googletagmanager.com/gtag/js?id=${GA_ID}";document.head.appendChild(s);`
    )
  : "";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Motiva Hub" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {ogType === "article" && (
      <>
        <meta property="article:author" content="Youssef Raihane" />
        <meta property="article:section" content="Self-Improvement" />
      </>
    )}
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="google-adsense-account" content="ca-pub-7700455846106476">
    <script is:inline define:vars={{ deferAds }} set:html={deferAds}></script>
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <meta name="impact-site-verification" content="e2d5e2d9-5097-4b2d-b582-7d63c33ec316" />
    {GA_ID && (
      <script is:inline define:vars={{ gaSnippet, deferGa }} set:html={gaSnippet + deferGa}></script>
    )}
    <link rel="preload" href="/fonts/fraunces-normal-latin-63f165.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-normal-latin-1ab1ad.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`/styles/global.css?v=${globalCssV}`} />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://the-motivahub.com/#organization",
          "name": "Motiva Hub",
          "url": "https://the-motivahub.com",
          "logo": { "@type": "ImageObject", "url": "https://the-motivahub.com/logo.jpg" },
          "founder": { "@type": "Person", "@id": "https://the-motivahub.com/author/youssef-raihane/#person", "name": "Youssef Raihane", "url": "https://the-motivahub.com/author/youssef-raihane/" },
          "sameAs": [
            "https://www.instagram.com/motivahub/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://the-motivahub.com/#website",
          "url": "https://the-motivahub.com",
          "name": "Motiva Hub",
          "description": "A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.",
          "publisher": { "@id": "https://the-motivahub.com/#organization" },
          "inLanguage": ["en", "fr"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://the-motivahub.com/journal/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <SiteHeader />

    <main>
      <slot />
    </main>

    <SiteFooter />

    <script is:inline>
      (function(){
const coreDict = {"en":{"newsletterEmailRequired":"Please enter your email address.","newsletterEmailValid":"Please enter a valid email address.","newsletterSending":"Sending...","newsletterWelcome":"🎉 Welcome! Check your inbox for confirmation.","newsletterWelcomeName":"🎉 Welcome aboard, {name}! Check your inbox for confirmation.","newsletterError":"⚠️ Something went wrong. Try email us directly.","quizNext":"Next →","quizProgress":"Question {n} of {total}","quizSeeMyType":"See My Type →"},"fr":{"newsletterEmailRequired":"Veuillez entrer votre adresse email.","newsletterEmailValid":"Veuillez entrer une adresse email valide.","newsletterSending":"Envoi en cours...","newsletterWelcome":"🎉 Bienvenue ! Vérifiez votre boîte de réception.","newsletterWelcomeName":"🎉 Bienvenue à bord, {name} ! Vérifiez votre boîte de réception.","newsletterError":"⚠️ Quelque chose s'est mal passé. Essayez de nous envoyer un email directement.","quizNext":"Suivant →","quizProgress":"Question {n} sur {total}","quizSeeMyType":"Voir Mon Type →"}};
        window.i18nDict = window.i18nDict || coreDict;
        const dict = { en: null, fr: null };
        const dictPending = {};
        // Full dictionaries live in cached static files (/i18n/dict-<lang>.json,
        // ~53-64 KB raw, gzipped on the wire) instead of a ~128 KB blob inlined
        // into every page. Network-first with a localStorage fallback; results
        // are merged into window.i18nDict so parse-time consumers (newsletter
        // messages, quiz labels - shipped inline above as coreDict) keep working.
        function loadDict(lang){
          if(lang !== "en" && lang !== "fr") return Promise.resolve({});
          if(dict[lang]) return Promise.resolve(dict[lang]);
          if(!dictPending[lang]){
            dictPending[lang] = (async function(){
              try{ dict[lang] = await (await fetch("/i18n/dict-" + lang + ".json")).json(); }
              catch(e){
                try{
                  const raw = localStorage.getItem("i18n-dict-v1:" + lang);
                  dict[lang] = raw ? JSON.parse(raw) : {};
                }catch(e2){ dict[lang] = {}; }
              }
              try{ localStorage.setItem("i18n-dict-v1:" + lang, JSON.stringify(dict[lang])); }catch(e){}
              try{ window.i18nDict[lang] = Object.assign(window.i18nDict[lang] || {}, dict[lang]); }catch(e){}
              return window.i18nDict[lang] || {};
            })();
          }
          return dictPending[lang];
        }
        const enCache = new Map();
        const enTextCache = new Map();
        document.querySelectorAll("[data-i18n-html]").forEach(el=>{
          const k = el.getAttribute("data-i18n-html");
          // FR pages render French server-side; the English original is kept
          // in data-en-html so the toggle can restore it.
          if(k && !enCache.has(k)) enCache.set(k, el.getAttribute("data-en-html") || el.innerHTML);
        });
        document.querySelectorAll("[data-i18n]").forEach(el=>{
          const k = el.getAttribute("data-i18n");
          if(k && !enTextCache.has(k)) enTextCache.set(k, el.getAttribute("data-en-text") || el.textContent);
        });
        // FR article pages render the French body server-side (marked with
        // [data-ssr-fr]). Capture that French so toggling FR after EN
        // restores it — with the heading ids — without re-fetching
        // articles-fr.json or re-swapping from it.
        const ssrFr = !!document.querySelector("[data-ssr-fr]");
        const frCache = new Map();
        const frTextCache = new Map();
        if(ssrFr){
          document.querySelectorAll("[data-i18n-html][data-en-html]").forEach(el=>{
            const k = el.getAttribute("data-i18n-html");
            if(k && !frCache.has(k)) frCache.set(k, el.innerHTML);
          });
          document.querySelectorAll("[data-i18n][data-en-text]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(k && !frTextCache.has(k)) frTextCache.set(k, el.textContent);
          });
        }
        async function setLang(lang, initial){
          const baseDict = await loadDict(lang);
          let t = {...baseDict};
          if(lang === "fr" && !ssrFr){
            try{
              const res = await fetch("/i18n/articles-fr.json");
              if(res.ok){
                const articles = await res.json();
                t = {...t, ...articles};
              }
            }catch(e){}
          }
          document.documentElement.lang = lang;
          localStorage.setItem("lang", lang);
          document.querySelectorAll("[data-i18n]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(lang === "en" && enTextCache.has(k)){
              el.textContent = enTextCache.get(k);
            } else if(lang === "fr" && ssrFr && el.hasAttribute("data-en-text")){
              if(!initial && frTextCache.has(k)) el.textContent = frTextCache.get(k);
            } else if(k && t[k]){
              el.textContent = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-html]").forEach(el=>{
            const k = el.getAttribute("data-i18n-html");
            if(lang === "en" && enCache.has(k)){
              el.innerHTML = enCache.get(k);
            } else if(lang === "fr" && ssrFr && el.hasAttribute("data-en-html")){
              if(!initial && frCache.has(k)) el.innerHTML = frCache.get(k);
            } else if(k && t[k]){
              el.innerHTML = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
            const k = el.getAttribute("data-i18n-placeholder");
            if(k && t[k]) el.setAttribute("placeholder", t[k]);
          });
          document.querySelectorAll(".lang-btn").forEach(b=>{
            const active = b.getAttribute("data-lang")===lang;
            b.classList.toggle("active", active);
            b.setAttribute("aria-pressed", active ? "true" : "false");
          });
          window.dispatchEvent(new CustomEvent("langchange", {detail: lang}));
        }
        async function initLang(){
          const path = window.location.pathname;
          const urlLang = path.startsWith('/fr') ? 'fr' : path.startsWith('/ar') ? 'ar' : 'en';
          const saved = localStorage.getItem('lang');
          const initial = (saved === 'fr' || saved === 'ar') && saved !== urlLang ? saved : urlLang;
          await setLang(initial, true);
        }
        initLang();
        // Language buttons navigate to the real twin page (EN <-> /fr/) so the
        // target language is fully server-rendered — card titles, descriptions
        // and article bodies included. The slug map is fetched only on click,
        // and only for journal articles (1 of 169 slugs differs). Pages
        // without a twin (404s, unknown paths) keep the client-side swap.
        const FR_SECTIONS = new Set(["30-days-discipline","about","affiliate-disclosure","author","best","bio","books","contact","credits","forgot-password","guides","journal","login","memento-mori","objectives","pdf","privacy","psychology","quotes","register","reset-password","terms","tools","topics","tracker"]);
        async function twinUrl(lang){
          const loc = window.location;
          const onFrPath = loc.pathname === "/fr" || loc.pathname.startsWith("/fr/");
          const cur = onFrPath ? "fr" : "en";
          if(cur === lang || (lang !== "en" && lang !== "fr")) return null;
          let rest = onFrPath ? (loc.pathname.replace(/^\/fr/, "") || "/") : loc.pathname;
          const first = rest.split("/").filter(Boolean)[0];
          if(first && !FR_SECTIONS.has(first)) return null;
          if(/^\/journal\/[^/]+\/?$/.test(rest)){
            try{
              const map = await (await fetch("/i18n/slugs-fr.json")).json();
              const slug = rest.split("/").filter(Boolean)[1];
              const mapped = lang === "fr" ? (map[slug] || slug) : (Object.keys(map).find((k) => map[k] === slug) || slug);
              rest = rest.endsWith("/") ? "/journal/" + mapped + "/" : "/journal/" + mapped;
            }catch(e){ return null; }
          }
          const target = lang === "fr" ? ("/fr" + (rest === "/" ? "/" : rest)) : rest;
          return target + loc.search + loc.hash;
        }
        document.querySelectorAll(".lang-btn").forEach(b=> b.addEventListener("click", async ()=>{
          const lang = b.getAttribute("data-lang")||"en";
          try{
            const url = await twinUrl(lang);
            if(url){
              try{ localStorage.setItem("lang", lang); }catch(e){}
              window.location.assign(url);
              return;
            }
          }catch(e){}
          setLang(lang);
        }));
        window.setLang = setLang;
      })();
    </script>
    <script is:inline>
      (function(){
        try{
          var US_TAGS = ["US","CA","PR"];
          fetch("/api/geo").then(function(r){return r.json();}).then(function(d){
            if(!d || US_TAGS.indexOf(d.country) === -1) return;
            document.querySelectorAll('a[href*="amazon."]').forEach(function(a){
              a.href = a.href
                .replace("amazon.fr/dp", "amazon.com/dp")
                .replace(/([?&])tag=[^&]*/, "$1tag=motivahub21-20");
            });
          }).catch(function(){});
        }catch(e){}
      })();
    </script>
    <script is:inline>
      window.trackAffiliateClick = function(bookId, bookTitle){
        var payload = {event:"affiliate_click", bookId: bookId, bookTitle: bookTitle, timestamp: new Date().toISOString()};
        try{console.debug("[affiliate_click]", payload);}catch(e){}
        if (typeof window.gtag === "function") try{window.gtag("event","affiliate_click",{book_id:bookId, book_title:bookTitle});}catch(e){}
        if (Array.isArray(window.dataLayer)) try{window.dataLayer.push(payload);}catch(e){}
      };
    </script>
    <div id="cookie-consent" class="cookie-banner" style="transform:translateY(110%);opacity:0;transition:transform .4s cubic-bezier(.22,1,.36,1),opacity .3s ease;">
      <div class="cookie-inner">
        <p data-i18n-html="cookieText">We use cookies to improve your experience and for analytics. By continuing, you agree to our <Link href="/privacy/" data-i18n="cookiePrivacy">Privacy Policy</Link>.</p>
        <div class="cookie-actions">
          <button class="cookie-btn cookie-accept" onclick="acceptCookies()" data-i18n="cookieAccept">Accept</button>
          <button class="cookie-btn cookie-decline" onclick="declineCookies()" data-i18n="cookieDecline">Decline</button>
        </div>
      </div>
    </div>
    <script is:inline>
      function showCookieBanner(){var el=document.getElementById('cookie-consent');el.style.transform='translateY(0)';el.style.opacity='1';el.style.pointerEvents='auto';document.body.classList.add('cookie-visible');}
      function hideCookieBanner(){var el=document.getElementById('cookie-consent');el.style.transform='translateY(110%)';el.style.opacity='0';el.style.pointerEvents='none';document.body.classList.remove('cookie-visible');}
      function acceptCookies(){localStorage.setItem('cookie_consent','accepted');hideCookieBanner();}
      function declineCookies(){localStorage.setItem('cookie_consent','declined');hideCookieBanner();}
      if(!localStorage.getItem('cookie_consent'))setTimeout(showCookieBanner,1500);
    </script>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <script is:inline>
    (function () {
      const progress = document.getElementById('read-progress');
      if (!progress) return;
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const h = doc.scrollHeight - doc.clientHeight;
        const pct = h > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / h) * 100)) : 0;
        progress.style.setProperty('--progress', pct + '%');
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();
    
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal, .reveal-stagger, .reveal-scale').forEach((el) => {
        if (el.getBoundingClientRect().top > window.innerHeight) el.classList.add('reveal-init');
        observer.observe(el);
      });
    })();
  </script>
  </body>
</html>
