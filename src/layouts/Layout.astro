        <p data-i18n="cookieText">We use cookies to improve your experience and for analytics. By continuing, you agree to our <Link href="/privacy/" data-i18n="cookiePrivacy">Privacy Policy</Link>.</p>
        <div class="cookie-actions">
          <button class="cookie-btn cookie-accept" onclick="acceptCookies()" data-i18n="cookieAccept">Accept</button>
