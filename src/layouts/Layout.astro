---
import { GA_ID, GSC_VERIFICATION } from "../data/analytics";
import MegaMenu from "../components/MegaMenu.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  lang?: "en" | "fr";
}

const { title, description, image = "/images/hero-athlete.jpg", noindex = false, ogType = "website", lang } = Astro.props;
const canonical = Astro.url.href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;
const isFr = lang === "fr" || Astro.url.pathname.startsWith("/fr") || Astro.url.searchParams.get("lang") === "fr";
const htmlLang = isFr ? "fr" : "en";
const ogLocale = isFr ? "fr_FR" : "en_US";
const ogLocaleAlt = isFr ? "en_US" : "fr_FR";
const gaSnippet = GA_ID
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_ID}');`
  : "";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Motiva Hub" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {ogType === "article" && (
      <>
        <meta property="article:author" content="Youssef Raihane" />
        <meta property="article:section" content="Self-Improvement" />
      </>
    )}
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" hreflang="fr" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="google-adsense-account" content="ca-pub-7700455846106476">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7700455846106476" crossorigin="anonymous"></script>
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <meta name="impact-site-verification" content="e2d5e2d9-5097-4b2d-b582-7d63c33ec316" />
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline set:html={gaSnippet}></script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,500;1,9..144,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://the-motivahub.com/#organization",
          "name": "Motiva Hub",
          "url": "https://the-motivahub.com",
          "logo": { "@type": "ImageObject", "url": "https://the-motivahub.com/logo.jpg" },
          "founder": { "@type": "Person", "@id": "https://the-motivahub.com/author/youssef-raihane/#person", "name": "Youssef Raihane", "url": "https://the-motivahub.com/author/youssef-raihane/" },
          "sameAs": [
            "https://www.instagram.com/motivahub/",
            "https://twitter.com/motivahub"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://the-motivahub.com/#website",
          "url": "https://the-motivahub.com",
          "name": "Motiva Hub",
          "description": "A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.",
          "publisher": { "@id": "https://the-motivahub.com/#organization" },
          "inLanguage": ["en", "fr"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://the-motivahub.com/journal/?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="header-inner container">
        <a href="/" class="logo">
          <span class="logo-mark">M</span>
          <span class="logo-word">Motiva <em>Hub</em></span>
        </a>
        <div class="header-actions">
          <div class="lang-switcher" aria-label="Language switcher">
            <button class="lang-btn active" data-lang="en" aria-label="Switch to English" aria-pressed="true">EN</button>
            <span class="lang-sep">/</span>
            <button class="lang-btn" data-lang="fr" aria-label="Passer en français" aria-pressed="false">FR</button>
          </div>
          <button class="menu-btn" id="menu-btn" aria-label="Open menu">
            <span>Menu</span>
            <span class="menu-btn-bars"><span></span><span></span></span>
          </button>
        </div>
      </div>
    </header>

    <MegaMenu />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-newsletter">
        <div class="container">
          <div class="footer-newsletter-inner">
            <p class="kicker kicker-or" style="justify-content:center; display:flex;">The Daily Drive · Newsletter</p>
            <h2>One letter. <em>Every Sunday.</em></h2>
            <p>The week's essays, one book worth reading, and a small practice to try — delivered to people building the long ascent.</p>
            <form class="newsletter-form" action="https://formsubmit.co/contact@the-motivahub.com" method="POST">
              <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
              <button type="submit">Subscribe</button>
            </form>
            <p style="font-family:var(--mono); font-size:0.6875rem; text-transform:uppercase; letter-spacing:0.14em; color:rgba(245,241,232,0.4); margin-top:16px;">Free · No spam · Unsubscribe anytime</p>
          </div>
        </div>
      </div>

      <div class="container">
        <div class="footer-main">
          <div class="footer-brand">
            <a href="/" class="logo">
              <span class="logo-mark">M</span>
              <span class="logo-word">Motiva <em>Hub</em></span>
            </a>
            <p class="footer-tagline">The Daily Drive. Mindset, habits, books and free tools — for the long ascent, one day at a time.</p>
            <div class="footer-social">
              <a href="https://twitter.com/motivahub" aria-label="Twitter" rel="noopener">𝕏</a>
              <a href="https://www.instagram.com/motivahub/" aria-label="Instagram" rel="noopener">IG</a>
              <a href="https://www.youtube.com/@motivahub" aria-label="YouTube" rel="noopener">YT</a>
              <a href="https://www.linkedin.com/company/motivahub" aria-label="LinkedIn" rel="noopener">in</a>
            </div>
          </div>
          <div class="footer-col">
            <h4>Read</h4>
            <ul>
              <li><a href="/journal/">The Journal</a></li>
              <li><a href="/books/">The Bookstand</a></li>
              <li><a href="/quotes/">Daily Quotes</a></li>
              <li><a href="/podcast/">Podcast</a></li>
              <li><a href="/topics/">All Topics</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Guides</h4>
            <ul>
              <li><a href="/guides/atomic-habits-ultimate-guide/">Atomic Habits</a></li>
              <li><a href="/best/books/">Best Books 2026</a></li>
              <li><a href="/best/focus-books/">Best Focus Books</a></li>
              <li><a href="/best/habit-books/">Best Habit Books</a></li>
              <li><a href="/best/stoicism-books/">Stoicism</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Tools</h4>
            <ul>
              <li><a href="/tools/discipline-quiz/">Discipline Quiz</a></li>
              <li><a href="/tools/habit-stacker/">Habit Stacker</a></li>
              <li><a href="/tools/meditation-timer/">Meditation Timer</a></li>
              <li><a href="/tools/cold-shower-tracker/">Cold Shower Tracker</a></li>
              <li><a href="/tools/reading-calculator/">Reading Calculator</a></li>
              <li><a href="/pdf/30-days-discipline/">30 Days PDF</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Motiva Hub · The Long Ascent</p>
          <div class="footer-bottom-links">
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/affiliate-disclosure/">Disclosure</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuBtn = document.getElementById("menu-btn");
      const menuClose = document.getElementById("menu-close");
      const overlay = document.getElementById("overlay-menu");

      const onScroll = () => {
        if (window.scrollY > 40) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      };
      window.addEventListener("scroll", onScroll);
      onScroll();

      const openMenu = () => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const closeMenu = () => {
        overlay.classList.remove("open");
        document.body.style.overflow = "";
      };
      menuBtn.addEventListener("click", openMenu);
      menuClose.addEventListener("click", closeMenu);
      overlay.addEventListener("click", (e) => {
        if (e.target.tagName === "A") closeMenu();
      });
    </script>
    <script is:inline>
      (function(){
        const dict = {
          en: { menu:"Menu", close:"Close", home:"Home", about:"About", topics:"Topics", journal:"Journal", books:"Books", quotes:"Quotes", podcast:"Podcast", contact:"Contact", footerTag:"The Daily Drive. Motivation, growth, and better habits, delivered daily.", heroKicker:"Motiva Hub · The Daily Drive", heroTitle:"Unlock your potential with the Daily Drive.", heroSubtitle:"A premium editorial sanctuary for the disciplined mind. Mindset, habits and the long ascent — one idea at a time.", heroPrimary:"Explore the Guides", heroSecondary:"Start with Mindset", journalKicker:"The Journal", journalTitle:"Essays for the <em>long climb.</em>", journalSubtitle:"Mindset, habits, discipline, productivity, deep work — written to be read slowly and returned to.", searchPlaceholder:"Search by title, topic or keywords...", all:"All", noResults:"No results found.", premiseKicker:"The Premise", premiseTitle:"Motivation is a visitor. <em>Discipline is a resident.</em> We do not chase the feeling — we build the room it returns to, day after day, until the practice becomes the person.", clarity:"Clarity", clarityDesc:"We strip away the noise to find the one thing that matters.", consistency:"Consistency", consistencyDesc:"Small, repeated acts compound into an unrecognisable life.", composure:"Composure", composureDesc:"The mind that can hold its centre decides the shape of the day." },
          fr: { menu:"Menu", close:"Fermer", home:"Accueil", about:"À propos", topics:"Thèmes", journal:"Journal", books:"Livres", quotes:"Citations", podcast:"Podcast", contact:"Contact", footerTag:"The Daily Drive. Motivation, croissance et meilleures habitudes, chaque jour.", heroKicker:"Motiva Hub · Le Quotidien", heroTitle:"Libérez votre potentiel avec le Daily Drive.", heroSubtitle:"Un sanctuaire éditorial premium pour l'esprit discipliné. État d'esprit, habitudes et longue ascension — une idée à la fois.", heroPrimary:"Explorer les Guides", heroSecondary:"Commencer par l'État d'esprit", journalKicker:"Le Journal", journalTitle:"Essais pour la <em>longue ascension.</em>", journalSubtitle:"État d'esprit, habitudes, discipline, productivité, travail profond — à lire lentement.", searchPlaceholder:"Rechercher par titre, thème ou mots-clés...", all:"Tous", noResults:"Aucun résultat trouvé.", premiseKicker:"La Prémisse", premiseTitle:"La motivation est une visiteuse. <em>La discipline est une résidente.</em> Nous ne chassons pas le sentiment — nous construisons la pièce où il revient, jour après jour, jusqu'à ce que la pratique devienne la personne.", clarity:"Clarté", clarityDesc:"Nous éliminons le bruit pour trouver la seule chose qui compte.", consistency:"Constance", consistencyDesc:"De petits actes répétés se composent en une vie méconnaissable.", composure:"Sang-froid", composureDesc:"L'esprit qui garde son centre décide de la forme du jour." },
        };
        function setLang(lang){
          const t = dict[lang] || dict.en;
          document.documentElement.lang = lang;
          localStorage.setItem("lang", lang);
          document.querySelectorAll("[data-i18n]").forEach(el=>{
            const k = el.getAttribute("data-i18n");
            if(k && t[k]) {
              if(t[k].indexOf("<") !== -1) el.innerHTML = t[k];
              else el.textContent = t[k];
            }
          });
          document.querySelectorAll("[data-i18n-placeholder]").forEach(el=>{
            const k = el.getAttribute("data-i18n-placeholder");
            if(k && t[k]) el.setAttribute("placeholder", t[k]);
          });
          document.querySelectorAll(".lang-btn").forEach(b=>{
            const active = b.getAttribute("data-lang")===lang;
            b.classList.toggle("active", active);
            b.setAttribute("aria-pressed", active ? "true" : "false");
          });
          window.dispatchEvent(new CustomEvent("langchange", {detail: lang}));
        }
        document.querySelectorAll(".lang-btn").forEach(b=> b.addEventListener("click", ()=> setLang(b.getAttribute("data-lang")||"en")));
        const saved = localStorage.getItem("lang") || "en";
        setLang(saved);
        window.setLang = setLang;
      })();
    </script>
    <script is:inline>
      (function(){
        try{
          var US_TAGS = ["US","CA","PR"];
          fetch("/api/geo").then(function(r){return r.json();}).then(function(d){
            if(!d || US_TAGS.indexOf(d.country) === -1) return;
            document.querySelectorAll('a[href*="amazon."]').forEach(function(a){
              a.href = a.href
                .replace("amazon.fr/dp", "amazon.com/dp")
                .replace(/([?&])tag=[^&]*/, "$1tag=motivahub21-20");
            });
          }).catch(function(){});
        }catch(e){}
      })();
    </script>
    <script is:inline>
      window.trackAffiliateClick = function(bookId, bookTitle){
        var payload = {event:"affiliate_click", bookId: bookId, bookTitle: bookTitle, timestamp: new Date().toISOString()};
        try{console.debug("[affiliate_click]", payload);}catch(e){}
        if (typeof window.gtag === "function") try{window.gtag("event","affiliate_click",{book_id:bookId, book_title:bookTitle});}catch(e){}
        if (Array.isArray(window.dataLayer)) try{window.dataLayer.push(payload);}catch(e){}
      };
    </script>
    <div id="cookie-consent" class="cookie-banner" style="display:none;">
      <div class="cookie-inner">
        <p>We use cookies to improve your experience and for analytics. By continuing, you agree to our <a href="/privacy/">Privacy Policy</a>.</p>
        <div class="cookie-actions">
          <button class="cookie-btn cookie-accept" onclick="acceptCookies()">Accept</button>
          <button class="cookie-btn cookie-decline" onclick="declineCookies()">Decline</button>
        </div>
      </div>
    </div>
    <script is:inline>
      function showCookieBanner(){document.getElementById('cookie-consent').style.display='flex';}
      function hideCookieBanner(){document.getElementById('cookie-consent').style.display='none';}
      function acceptCookies(){localStorage.setItem('cookie_consent','accepted');hideCookieBanner();}
      function declineCookies(){localStorage.setItem('cookie_consent','declined');hideCookieBanner();}
      if(!localStorage.getItem('cookie_consent'))setTimeout(showCookieBanner,2000);
    </script>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>
  <script is:inline>
    (function () {
      const progress = document.getElementById('read-progress');
      if (!progress) return;
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const h = doc.scrollHeight - doc.clientHeight;
        const pct = h > 0 ? Math.min(100, Math.max(0, (doc.scrollTop / h) * 100)) : 0;
        progress.style.setProperty('--progress', pct + '%');
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      update();

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) e.target.classList.add('visible');
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal, .reveal-stagger, .reveal-scale').forEach((el) => observer.observe(el));

      // Magnetic buttons
      document.querySelectorAll('[data-magnetic]').forEach((btn) => {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          btn.style.transform = `translate(${x * 0.18}px, ${y * 0.18}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = '';
        });
      });

      // 3D card tilt
      document.querySelectorAll('.card, .tool-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          const rx = (y - 0.5) * -6;
          const ry = (x - 0.5) * 6;
          card.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-6px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
        });
      });
    })();
  </script>
  </body>
</html>
