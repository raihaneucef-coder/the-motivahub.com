              <li><a href="/best/focus-books/" data-i18n="footerBestFocus">Best Focus Books</a></li>
              <li><a href="/best/habit-books/" data-i18n="footerBestHabit">Best Habit Books</a></li>
              <li><a href="/best/stoicism-books/" data-i18n="footerStoicism">Stoicism</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4 data-i18n="footerColTools">Tools</h4>
            <ul>
              <li><a href="/tools/discipline-quiz/" data-i18n="footerDisciplineQuiz">Discipline Quiz</a></li>
              <li><a href="/tools/habit-stacker/" data-i18n="footerHabitStacker">Habit Stacker</a></li>
