---
import type { Podcast } from "../data/podcasts";

interface Props {
  podcast: Podcast;
}
const { podcast } = Astro.props;
const hasPodcast = Boolean(podcast.podcastUrl && podcast.podcastUrl.trim().length > 0);
---

<article class="book-card podcast-card" id={podcast.id}>
  <img class="book-cover" src={podcast.cover} alt={`${podcast.title} cover`} loading="lazy" />
  <div class="book-body">
    <p class="card-meta">{podcast.date} · {podcast.duration}</p>
    <h3>{podcast.title}</h3>
    <p class="book-desc">{podcast.description}</p>
    {hasPodcast ? (
      <a class="read-more" href={podcast.podcastUrl} target="_blank" rel="noopener">Listen to Podcast</a>
    ) : (
      <span class="read-more read-more-disabled" aria-disabled="true" title="Podcast coming soon">Listen to Podcast — Coming soon</span>
    )}
  </div>
</article>
