---
// Stats now live in the hero-line on the homepages; the duplicate 5-column
// stats grid was removed (Oct-5 de-template pass).
---

<section class="manifesto">
  <svg class="manifesto-bg" aria-hidden="true" focusable="false" viewBox="0 0 1500 330" preserveAspectRatio="xMidYMid meet"><text x="750" y="262" text-anchor="middle" textLength="1400" lengthAdjust="spacingAndGlyphs" font-family="Fraunces, Georgia, serif" font-style="italic" font-size="300" fill="var(--cream-deep)" letter-spacing="-0.05em">discipline</text></svg>
  <div class="container">
    <div class="manifesto-inner reveal">
      <p class="kicker kicker-sage" style="justify-content:center; display:flex;" data-i18n="manifestoKicker">A Quiet Manifesto</p>
      <p class="manifesto-statement" data-i18n="manifestoStatement">
        We are not here to be inspired<br/>
        for an afternoon.<br/>
        <em>We are here to be built, slowly,</em><br/>
        into the kind of person<br/>
        who does the work<br/>
        even when no one is watching.
      </p>
      <div class="manifesto-cite">
        <span class="manifesto-cite-line"></span>
        <span class="manifesto-cite-text" data-i18n="manifestoCite">— Motiva Hub · 2026</span>
        <span class="manifesto-cite-line"></span>
      </div>
    </div>
  </div>
</section>
