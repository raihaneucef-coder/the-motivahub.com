---
interface Props {
  count?: number;
  title?: string;
}
const { count = 3, title = "Related Essays" } = Astro.props;
---

<section class="related">
  <div class="container">
    <div class="section-head">
      <p class="kicker" data-i18n="relatedKicker">Keep Reading</p>
      <h2 class="section-title" data-i18n={title.includes('Essays') ? 'relatedEssaysTitle' : 'relatedArticlesTitle'}>{title}</h2>
    </div>
    <div class="grid">
      <slot />
    </div>
  </div>
</section>