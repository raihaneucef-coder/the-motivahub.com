---
import { getLangFromUrl, getLocalePath } from "../utils/i18n";

interface Props {
  kicker?: string;
  title: string;
  subtitle: string;
  image?: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  meta?: Array<{ num: string; label: string }>;
}

const { kicker = "Motiva Hub", title, subtitle, image = "/images/hero-poster.jpg", primaryCta, secondaryCta, meta } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const primaryCtaHref = getLocalePath(primaryCta.href, locale);
const secondaryCtaHref = getLocalePath(secondaryCta.href, locale);
---

<section class="hero hero-portrait" id="hero">
  <video class="hero-video" muted loop playsinline poster={image}
    data-src-webm="/videos/hero-bg.webm"
    data-src-mp4="/videos/hero-bg.mp4">
  </video>
  <div class="hero-portrait-overlay"></div>

  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title" data-i18n-html="heroTitle">
        <Fragment set:html={title} />
      </h1>

      <p class="hero-subtitle" data-i18n="heroSubtitle">{subtitle}</p>

      <div class="hero-btns">
        <a class="btn btn-primary" href={primaryCtaHref}>
          <span data-i18n="heroPrimary">{primaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
        <a class="btn btn-ghost" href={secondaryCtaHref}>
          <span data-i18n="heroSecondary">{secondaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
      </div>

      {meta && meta.length > 0 && (
        <div class="hero-meta">
          {meta.map((m) => (
            <div class="hero-meta-item">
              <span class="hero-meta-num" set:html={m.num}></span>
              <span class="hero-meta-label" data-i18n={m.labelKey}>{m.label || ''}</span>
            </div>
          ))}
        </div>
      )}

      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        <span data-i18n="heroKicker">{kicker}</span>
      </span>
    </div>
  </div>
</section>

<script>
  // Defer video loading until after LCP paint (improves PageSpeed)
  function initHeroVideo() {
    const video = document.querySelector('.hero-video');
    if (!video || video.querySelector('source')) return;
    const webm = video.dataset.srcWebm;
    const mp4 = video.dataset.srcMp4;
    if (webm) {
      const src = document.createElement('source');
      src.src = webm; src.type = 'video/webm';
      video.appendChild(src);
    }
    if (mp4) {
      const src = document.createElement('source');
      src.src = mp4; src.type = 'video/mp4';
      video.appendChild(src);
    }
    video.load();
    video.muted = true;
    video.play().catch(() => {
      const retry = () => { video.play(); document.removeEventListener('click', retry); };
      document.addEventListener('click', retry);
    });
  }
  // Load video after first paint to not block LCP
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initHeroVideo, { timeout: 2000 });
  } else {
    setTimeout(initHeroVideo, 1000);
  }
</script>
