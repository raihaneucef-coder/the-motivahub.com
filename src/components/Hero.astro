---
import { getLangFromUrl, getLocalePath } from "../utils/i18n";

interface Props {
  kicker?: string;
  title: string;
  subtitle: string;
  image?: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  meta?: Array<{ num: string; label: string; labelKey?: string }>;
}

const { kicker = "Motiva Hub", title, subtitle, primaryCta, secondaryCta, meta } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const primaryCtaHref = getLocalePath(primaryCta.href, locale);
const secondaryCtaHref = getLocalePath(secondaryCta.href, locale);
---

<section class="hero hero-portrait" id="hero">
  <!-- Static hero art (video retired): full-quality photo; on portrait screens the
       complete picture is shown contained over a softly blurred backdrop. -->
  <picture class="hero-picture">
    <img class="hero-video" src="/images/hero-static-pc.webp" alt="" width="1920" height="1080" fetchpriority="high" decoding="async">
    <img class="hero-full" src="/images/hero-static-pc.webp" alt="" width="1920" height="1080" decoding="async" aria-hidden="true">
  </picture>
  <div class="hero-portrait-overlay"></div>

  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title" data-i18n-html="heroTitle">
        <Fragment set:html={title} />
      </h1>

      <p class="hero-subtitle" data-i18n="heroSubtitle">{subtitle}</p>

      <div class="hero-btns">
        <a class="btn btn-primary" href={primaryCtaHref}>
          <span data-i18n="heroPrimary">{primaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
        <a class="btn btn-ghost" href={secondaryCtaHref}>
          <span data-i18n="heroSecondary">{secondaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
      </div>

      {meta && meta.length > 0 && (
        <div class="hero-meta">
          {meta.map((m) => (
            <div class="hero-meta-item">
              <span class="hero-meta-num" set:html={m.num}></span>
              <span class="hero-meta-label" data-i18n={m.labelKey}>{m.label || ''}</span>
            </div>
          ))}
        </div>
      )}

      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        <span data-i18n="heroKicker">{kicker}</span>
      </span>
    </div>
  </div>
</section>

