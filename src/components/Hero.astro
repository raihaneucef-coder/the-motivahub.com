---
interface Props {
  kicker?: string;
  title: string;
  subtitle: string;
  image?: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  meta?: Array<{ num: string; label: string }>;
}

const { kicker = "Est. 2025 · The Long Ascent", title, subtitle, image = "/images/hero-mountain-man.jpg", primaryCta, secondaryCta, meta } = Astro.props;
const titleText = title.replace(/<[^>]+>/g, '');
---

<section class="hero hero-portrait" id="hero">
  <div class="hero-portrait-bg" style={`background-image: url('${image}');`}></div>
  <div class="hero-portrait-overlay"></div>

  <div class="hero-vertical-text" aria-hidden="true">
    <span>EST · MMXXV</span>
    <span>·</span>
    <span>THE LONG ASCENT</span>
    <span>·</span>
    <span>NO SHORTCUTS</span>
  </div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        {kicker}
      </span>

      <h1 class="hero-title" data-stagger-reveal>
        {title.split('<br/>').map((line, i) => (
          <span class="hero-title-line">
            {line.split(/(<em>.*?<\/em>)/g).map((part) => {
              if (part.startsWith('<em>')) {
                const text = part.replace(/<\/?em>/g, '');
                return <em class="hero-title-word">{text}</em>;
              }
              return <span class="hero-title-word">{part}</span>;
            })}
          </span>
        ))}
      </h1>

      <p class="hero-subtitle" data-stagger-reveal>{subtitle}</p>

      <div class="hero-btns" data-stagger-reveal>
        <a class="btn btn-primary btn-magnetic" href={primaryCta.href}>
          <span>{primaryCta.label}</span>
          <span class="btn-arrow-sm">→</span>
        </a>
        <a class="btn btn-ghost btn-magnetic" href={secondaryCta.href}>
          <span>{secondaryCta.label}</span>
          <span class="btn-arrow-sm">→</span>
        </a>
      </div>

      {meta && meta.length > 0 && (
        <div class="hero-meta" data-stagger-reveal>
          {meta.map((m) => (
            <div class="hero-meta-item">
              <span class="hero-meta-num" set:html={m.num}></span>
              <span class="hero-meta-label">{m.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="hero-scroll">
    <span>SCROLL</span>
    <span class="hero-scroll-line"></span>
  </div>

  <div class="hero-corner hero-corner-br" aria-hidden="true">
    <span>Frame 01 / 12</span>
  </div>
</section>

<script is:inline>
  (function () {
    const hero = document.getElementById('hero');
    if (!hero) return;

    // Letter-by-letter reveal
    const words = hero.querySelectorAll('.hero-title-word');
    words.forEach((word, i) => {
      const text = word.textContent;
      word.innerHTML = '';
      const letters = text.split('');
      letters.forEach((letter, j) => {
        const span = document.createElement('span');
        span.className = 'hero-letter';
        span.textContent = letter === ' ' ? '\u00A0' : letter;
        span.style.transitionDelay = (0.1 + (i * 0.05) + (j * 0.025)) + 's';
        word.appendChild(span);
      });
    });
    requestAnimationFrame(() => {
      hero.querySelectorAll('[data-stagger-reveal]').forEach((el, idx) => {
        el.style.transitionDelay = (0.1 + idx * 0.15) + 's';
        el.classList.add('revealed');
      });
      hero.querySelectorAll('.hero-letter').forEach((l) => l.classList.add('revealed'));
    });

    // Single-layer scroll-driven parallax (no mouse, no rotation, no second layer)
    const onScroll = () => {
      const rect = hero.getBoundingClientRect();
      if (rect.bottom < 0) return;
      const progress = Math.max(0, Math.min(1, 1 - (rect.bottom / window.innerHeight)));
      hero.style.setProperty('--scroll-depth', progress.toFixed(3));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
