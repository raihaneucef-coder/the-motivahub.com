---
import { getLangFromUrl, getLocalePath } from "../utils/i18n";

interface Props {
  kicker?: string;
  title: string;
  subtitle: string;
  image?: string;
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  meta?: Array<{ num: string; label: string; labelKey?: string }>;
}

const { kicker = "Motiva Hub", title, subtitle, image = "/images/hero-editorial.webp", primaryCta, secondaryCta, meta } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const primaryCtaHref = getLocalePath(primaryCta.href, locale);
const secondaryCtaHref = getLocalePath(secondaryCta.href, locale);
---

<section class="hero hero-portrait" id="hero">
  <video class="hero-video" muted loop playsinline
    data-img={image}
    data-src-webm="/videos/hero-bg-v3.webm"
    data-src-mp4="/videos/hero-bg-v3.mp4"
    data-src-webm-mobile="/videos/hero-bg-mobile-v1.webm"
    data-src-mp4-mobile="/videos/hero-bg-mobile-v1.mp4"
    data-img-mobile="/images/hero-editorial-mobile.webp">
  </video>
  <script is:inline>
    // Set the poster synchronously per viewport so only ONE image is ever fetched.
    (function () {
      var v = document.querySelector('.hero-video');
      if (!v) return;
      var portrait = window.matchMedia('(max-width: 1024px)').matches;
      v.poster = (portrait && v.dataset.imgMobile) ? v.dataset.imgMobile : v.dataset.img;
    })();
  </script>
  <noscript><img src="/images/hero-editorial.webp" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;z-index:0"></noscript>
  <div class="hero-portrait-overlay"></div>

  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title" data-i18n-html="heroTitle">
        <Fragment set:html={title} />
      </h1>

      <p class="hero-subtitle" data-i18n="heroSubtitle">{subtitle}</p>

      <div class="hero-btns">
        <a class="btn btn-primary" href={primaryCtaHref}>
          <span data-i18n="heroPrimary">{primaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
        <a class="btn btn-ghost" href={secondaryCtaHref}>
          <span data-i18n="heroSecondary">{secondaryCta.label}</span>
          <span class="btn-arrow-sm">{String.fromCharCode(8594)}</span>
        </a>
      </div>

      {meta && meta.length > 0 && (
        <div class="hero-meta">
          {meta.map((m) => (
            <div class="hero-meta-item">
              <span class="hero-meta-num" set:html={m.num}></span>
              <span class="hero-meta-label" data-i18n={m.labelKey}>{m.label || ''}</span>
            </div>
          ))}
        </div>
      )}

      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        <span data-i18n="heroKicker">{kicker}</span>
      </span>
    </div>
  </div>
</section>

<script>
  // Portrait art direction: phones/tablets get a dedicated 9:16 hero composition.
  const portraitMq = window.matchMedia('(max-width: 1024px)');
  // Defer video loading until after LCP paint (improves PageSpeed)
  function initHeroVideo() {
    const video = document.querySelector('.hero-video');
    if (!video || video.querySelector('source')) return;
    const usePortrait = portraitMq.matches && video.dataset.srcWebmMobile;
    const webm = usePortrait ? video.dataset.srcWebmMobile : video.dataset.srcWebm;
    const mp4 = usePortrait ? video.dataset.srcMp4Mobile : video.dataset.srcMp4;
    if (webm) {
      const src = document.createElement('source');
      src.src = webm; src.type = 'video/webm';
      video.appendChild(src);
    }
    if (mp4) {
      const src = document.createElement('source');
      src.src = mp4; src.type = 'video/mp4';
      video.appendChild(src);
    }
    video.load();
    video.muted = true;
    video.play().catch(() => {
      const retry = () => { video.play(); document.removeEventListener('click', retry); };
      document.addEventListener('click', retry);
    });
  }
  // Respect reduced-motion: keep the static poster, never load the video.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    // Load video after first paint to not block LCP
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initHeroVideo, { timeout: 2000 });
    } else {
      setTimeout(initHeroVideo, 1000);
    }
  }
</script>
