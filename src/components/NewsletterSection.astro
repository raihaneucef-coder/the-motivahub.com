---
const { title = "Are you ready for the next level?", subtitle = "One letter each week. A single idea on mindset, discipline and the long ascent — delivered at dawn. No noise, no algorithms — just the idea." } = Astro.props;
---

<section class="newsletter">
  <div class="container">
    <p class="kicker">The Daily Drive · Newsletter</p>
    <h2>{title}</h2>
    <p class="newsletter-sub">{subtitle}</p>
    <form class="newsletter-form" id="newsletter-form" novalidate>
      <input type="text" name="name" placeholder="Name (optional)" aria-label="Name" autocomplete="name" />
      <input type="email" name="email" placeholder="Your email address *" aria-label="Email address" required autocomplete="email" />
      <button type="submit" class="btn-pill btn-pill-cream">Subscribe</button>
    </form>
    <p id="newsletter-msg" class="newsletter-note" aria-live="polite"></p>
    <p class="newsletter-note">No spam. Unsubscribe anytime.</p>
    <p class="newsletter-note" style="opacity:0.6;font-size:0.72rem;">Stored via FormSubmit → <code>hello@motivahub.com</code> (replace with your Gmail in <code>NewsletterSection.astro</code> when ready).</p>
  </div>
</section>
<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const msg = document.getElementById('newsletter-msg') as HTMLElement | null;
  if (form && msg) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const name = String(fd.get('name') || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!email) { msg.textContent = 'Please enter your email address.'; msg.style.color = '#a67c52'; return; }
      if (!emailOk) { msg.textContent = 'Please enter a valid email address.'; msg.style.color = '#a67c52'; return; }
      // TODO: picks real provider — replace hello@motivahub.com with your Gmail and enable FormSubmit/Brevo.
      // Example: await fetch('https://formsubmit.co/ajax/YOUR_GMAIL@gmail.com', {method:'POST', body: JSON.stringify({name,email})})
      msg.textContent = name ? `Thanks, ${name}! Check your inbox — you’re on the list.` : 'Thanks! Check your inbox — you’re on the list.';
      msg.style.color = '#121212';
      form.reset();
    });
  }
</script>