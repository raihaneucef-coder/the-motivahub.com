---
const { title = "Are you ready for the next level?", subtitle = "One letter each week. A single idea on mindset, discipline and the long ascent — delivered at dawn. No noise, no algorithms — just the idea." } = Astro.props;
---

<section class="newsletter">
  <div class="container">
    <p class="kicker" data-i18n="newsletterKicker">The Daily Drive · Newsletter</p>
    <h2 data-i18n="newsletterTitle">{title}</h2>
    <p class="newsletter-sub" data-i18n="newsletterSubtitle">{subtitle}</p>
    <form class="newsletter-form" id="newsletter-form" novalidate>
      <input type="text" name="name" placeholder="Name (optional)" data-i18n-placeholder="newsletterName" aria-label="Name" autocomplete="name" />
      <input type="email" name="email" placeholder="Your email address *" data-i18n-placeholder="newsletterEmail" aria-label="Email address" required autocomplete="email" />
      <button type="submit" class="btn-pill btn-pill-cream" data-i18n="newsletterBtn">Subscribe</button>
    </form>
    <p id="newsletter-msg" class="newsletter-note" aria-live="polite"></p>
    <p class="newsletter-note" data-i18n="newsletterNoSpam">No spam. Unsubscribe anytime.</p>
    <p class="newsletter-note" style="opacity:0.6;font-size:0.72rem;">Stored via FormSubmit → <code>raihaneucef@gmail.com</code></p>
  </div>
</section>
<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const msg = document.getElementById('newsletter-msg') as HTMLElement | null;
  if (form && msg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const name = String(fd.get('name') || '').trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!email) { msg.textContent = 'Please enter your email address.'; msg.style.color = '#a67c52'; return; }
      if (!emailOk) { msg.textContent = 'Please enter a valid email address.'; msg.style.color = '#a67c52'; return; }
      // Connected to raihaneucef@gmail.com via FormSubmit
      msg.textContent = 'Sending...'; msg.style.color = '#6b665e';
      try {
        const res = await fetch('https://formsubmit.co/ajax/raihaneucef@gmail.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ name: name || '(no name)', email, _subject: 'New Motiva Hub subscriber', _template: 'table' })
        });
        if (res.ok) {
          msg.textContent = name ? `Thanks, ${name}! Check your inbox — you’re on the list.` : 'Thanks! Check your inbox — you’re on the list.';
          msg.style.color = '#121212';
          form.reset();
        } else { throw new Error('failed'); }
      } catch {
        msg.textContent = 'Something went wrong. Please try again.';
        msg.style.color = '#a67c52';
      }
    });
  }
</script>