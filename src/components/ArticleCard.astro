---
import type { CollectionEntry } from "astro:content";
import Link from "./Link.astro";
import { getFrenchSlug } from "../utils/i18n";
import { getImageDimensions } from "../utils/image";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
  locale?: "en" | "fr";
}
const { post, featured = false, locale = "en" } = Astro.props;

const slug = locale === "fr" ? getFrenchSlug(post.id) : post.id;
const title = locale === "fr" && post.data.titleFr ? post.data.titleFr : post.data.title;
const description = locale === "fr" && post.data.descriptionFr ? post.data.descriptionFr : post.data.description;
const imageDimensions = await getImageDimensions(post.data.image);
---

<article class={`card ${featured ? "card-featured" : ""}`}>
      <Link href={`/${locale === "fr" ? "fr/" : ""}journal/${slug}/`} class="card-img-link">
        <div class="card-img-wrap">
          <img class="card-img" src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" width={imageDimensions.width} height={imageDimensions.height} />
        </div>
      </Link>
  <div class="card-body">
    <p class="card-meta"><span data-i18n={`topic-${post.data.topic.toLowerCase()}`}>{post.data.topic.toUpperCase()}</span> — {post.data.readTime}</p>
    <h3 class="card-title">
      <Link href={`/${locale === "fr" ? "fr/" : ""}journal/${slug}/`}>
        {title}
      </Link>
    </h3>
    <p class="card-excerpt">{description}</p>
    <p class="card-date">{post.data.pubDate.toLocaleDateString(locale === "fr" ? "fr-FR" : "en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
  </div>
