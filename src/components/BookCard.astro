---
import type { Book } from "../data/books";

interface Props {
  book: Book;
}
const { book } = Astro.props;
const hasAffiliate = Boolean(book.affiliateUrl && book.affiliateUrl.trim().length > 0);

const relatedSlug = (() => {
  switch (book.id) {
    case "atomic-habits":
      return "/journal/atomic-habits-review/";
    case "deep-work":
      return "/journal/deep-work-focus/";
    case "cant-hurt-me":
      return "/journal/cant-hurt-me-review/";
    case "meditations":
      return "/journal/morning-routines-12-tested/";
    default:
      return null;
  }
})();
const relatedLabel = (() => {
  const labels = {
    "atomic-habits": "readAtomicFieldReport",
    "deep-work": "readDeepWorkProtocol",
    "cant-hurt-me": "readCantHurtMeReview",
    "meditations": "readStoicMorningTest"
  };
  return labels[book.id] || null;
})();
---

<article class="book-card" id={book.id}>
  <div style="position:relative; overflow:hidden;">
    <img class="book-cover" src={book.cover} alt={`${book.title} cover`} loading="lazy" />
    <span class="book-cat">{book.category}</span>
  </div>
  <div class="book-body">
    <h3>{book.title}</h3>
    <p class="book-author">{book.author}</p>
    <p class="book-desc">{book.description}</p>
    <p class="book-reason"><strong data-i18n="bookWhyRecommend">Why we recommend it:</strong> {book.reason}</p>
    {relatedSlug && relatedLabel ? (
      <p style="margin-top:10px;">
        <a class="read-more" href={relatedSlug} data-i18n={relatedLabel}>{relatedLabel}</a>
      </p>
    ) : null}
    {hasAffiliate ? (
      <a class="read-more" href={book.affiliateUrl} target="_blank" rel="nofollow sponsored noopener" data-book-id={book.id} data-book-title={book.title} onclick="try{window.trackAffiliateClick&&window.trackAffiliateClick(this.dataset.bookId,this.dataset.bookTitle)}catch(e){}" data-i18n="viewBook">View Book</a>
    ) : (
      <span class="read-more read-more-disabled" aria-disabled="true" title="Affiliate link coming soon" data-i18n="viewBookComingSoon">View Book — Affiliate link coming soon</span>
    )}
  </div>
</article>