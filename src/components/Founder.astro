---
const principles = [
  { num: "01", word: "Clarity", desc: "Strip away the noise to find the one thing that matters." },
  { num: "02", word: "Consistency", desc: "Small acts, repeated daily, compound into an unrecognisable life." },
  { num: "03", word: "Composure", desc: "The mind that can hold its centre decides the shape of the day." },
];
---

<section class="founder">
  <div class="container">
    <div class="founder-grid">
      <div class="founder-portrait reveal-scale">
        <div class="founder-photo" role="img" aria-label="Youssef Raihane — Founder of Motiva Hub">
          <svg viewBox="0 0 240 240" width="240" height="240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="fpFace" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#1a1a1a"/>
                <stop offset="100%" stop-color="#0a0a0a"/>
              </linearGradient>
              <linearGradient id="fpGold" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#fff3c4"/>
                <stop offset="40%" stop-color="#e8c879"/>
                <stop offset="100%" stop-color="#8a6420"/>
              </linearGradient>
            </defs>
            <rect width="240" height="240" fill="url(#fpFace)"/>
            <g transform="translate(120, 138)" text-anchor="middle" style="filter: drop-shadow(0 1px 0 #5a3e10) drop-shadow(0 2px 0 #4a2f08) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.6));">
              <path d="M -50 -50 L -42 -50 L -22 -10 L -2 -50 L 6 -50 L -18 -2 L -18 50 L -26 50 L -26 -2 Z" fill="url(#fpGold)" stroke="#5a3e10" stroke-width="0.5"/>
              <path d="M 18 -50 L 18 50 L 26 50 L 26 8 L 40 8 L 56 50 L 66 50 L 48 6 Q 60 4 60 -12 Q 60 -50 30 -50 Z" fill="url(#fpGold)" stroke="#5a3e10" stroke-width="0.5"/>
              <path d="M 26 -42 L 30 -42 Q 52 -42 52 -12 Q 52 0 30 0 L 26 0 Z" fill="url(#fpFace)"/>
            </g>
            <text x="120" y="208" text-anchor="middle" font-family="Georgia, serif" font-size="11" letter-spacing="2" fill="#8a6420" opacity="0.7">FOUNDER</text>
          </svg>
        </div>
        <div class="founder-portrait-frame"></div>
        <div class="founder-portrait-caption">
          <span class="founder-portrait-name">Youssef Raihane</span>
          <span class="founder-portrait-role">Founder · Editor · Builder</span>
        </div>
      </div>
      </div>
      <div class="founder-text reveal">
        <span class="kicker">The Founder</span>
        <h2 class="founder-title">A long ascent, <em>taken slowly.</em></h2>
        <p class="founder-lead">Motiva Hub is the editorial work of one person, building in public, choosing the slow road on purpose.</p>
        <p>It began as a private notebook — the kind of writing you do for yourself at 5 AM, when the house is quiet and the work is honest. It became a site. Then a publication. Then a quiet community of readers who would rather be patient and unstoppable than loud and brief.</p>
        <p>Every essay here is written to be read slowly. Every tool is built for the person who would rather act than scroll. The Daily Drive is a long game. We play it like one.</p>
        <div class="founder-signature">
          <svg viewBox="0 0 200 60" class="founder-signature-svg" aria-hidden="true">
            <path d="M 10 40 Q 30 10, 50 30 T 90 35 Q 120 15, 140 35 T 180 30" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            <path d="M 50 30 L 60 25 M 130 32 L 145 28" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
          </svg>
          <span class="founder-signature-text">— Youssef Raihane, Est. 2025</span>
        </div>
        <a class="btn-arrow btn-arrow-or" href="/author/youssef-raihane/">Read the full bio</a>
      </div>
    </div>
  </div>
</section>

<section class="section-cream-deep">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">The Premise</span>
      <div>
        <h2>Three principles.<br/><em>One quiet work.</em></h2>
        <p>The editorial backbone of every essay, every tool, every page on this site. Read once. Return often.</p>
      </div>
    </div>
    <div class="pillars reveal-stagger">
      {principles.map((p) => (
        <article class="pillar">
          <span class="pillar-num">{p.num}</span>
          <h3 class="pillar-title">{p.word}</h3>
          <p class="pillar-desc">{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
