---
interface Props {
  variant?: "compact" | "full";
  showSchema?: boolean;
  lang?: "en" | "fr";
  name: string;
  jobTitle: string;
  bio: string;
}

const { variant = "full", showSchema = true, lang = "en", name, jobTitle, bio } = Astro.props;

// The bio box is a <div>, not an <aside>: axe flags complementary landmarks
// nested in the article's <main> (landmark-complementary-is-top-level). It is
// an article footer, not a page-level complementary region.

// The author page has a French twin; without this every French page was
// pointing its readers at the English bio.
const localePrefix = lang === "fr" ? "/fr" : "";

const author = {
  name: "Youssef Raihane",
  jobTitle: "Founder & Editor-in-Chief",
  worksFor: "Motiva Hub",
  url: "https://the-motivahub.com",
  bio: "Founder of Motiva Hub, launched in 2026. Writes essays on discipline, habits, and stoicism. Believes discipline beats motivation — every single time.",
  avatar: "/images/youssef-raihane.jpg",
  founded: 2026,
};

// This box renders inside /fr/journal/*, which the post-build FR swap never
// touches (see scripts/i18n-fr-ssr.mjs), and it carries no data-i18n keys, so
// the French labels have to be resolved here, at build time. French wording
// comes from public/i18n/dict-fr.json where the dictionary has a ready string
// (authorTag verbatim; authorReadFull and authorFullPage with the trailing
// arrow the English links already use), while the role translates
// author.jobTitle directly — the dictionary only stores it inside the longer
// authorSubtitle sentence.
const copy = lang === "fr" ? {
  role: "Fondateur & Rédacteur en Chef",
  about: "À propos de l'auteur",
  founded: `A fondé ${author.worksFor} en ${author.founded}`,
  bio: "Fondateur de Motiva Hub, lancé en 2026. Il écrit des essais sur la discipline, les habitudes et le stoïcisme. Il pense que la discipline bat la motivation — à chaque fois.",
  readFull: "Lire la biographie complète →",
  fullPage: "Page auteur complète →",
} : {
  role: author.jobTitle,
  about: "About the author",
  founded: `Founded ${author.worksFor} in ${author.founded}`,
  bio: author.bio,
  readFull: "Read full bio →",
  fullPage: "Full Author Page →",
};

---

{variant === "compact" && (
  <div class="author-bio author-bio--compact">
    <span class="author-avatar author-avatar--img">
      <img
        src="/images/yr-320.jpg"
        srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w"
        sizes="56px"
        alt={author.name}
        width="56" height="56"
        loading="lazy"
      />
    </span>
    <div class="author-meta">
      <p class="author-name">{author.name}</p>
      <p class="author-role">{copy.role} · {author.worksFor}</p>
      <a class="author-link" href={localePrefix + "/author/youssef-raihane/"}>{copy.readFull}</a>
    </div>
  </div>
)}

{variant === "full" && (
  <div class="author-bio author-bio--full">
    <div class="author-bio-head">
      <span class="author-avatar-lg author-avatar--img">
        <img
          src="/images/yr-320.jpg"
          srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w"
          sizes="88px"
          alt={author.name}
          width="88" height="88"
          loading="lazy"
        />
      </span>
      <div>
        <p class="author-tag">{copy.about}</p>
        <h3 class="author-name-lg">{author.name}</h3>
        <p class="author-role-lg">{copy.role} · {copy.founded}</p>
      </div>
    </div>
    <p class="author-bio-text">{copy.bio}</p>
    <div class="author-links">
      <a class="author-link-pill author-link-pill--primary" href={localePrefix + "/author/youssef-raihane/"}>{copy.fullPage}</a>
    </div>
  </div>
)}

<style>
  .author-bio {
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 14px;
    background: var(--cream, #ffffff);
    margin: 56px auto;
    max-width: 720px;
    padding: 28px 28px;
  }
  .author-bio--compact {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
  }
  .author-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: inline-block;
    border: 1px solid var(--line, #e5e5e5);
  }
  .author-avatar-lg {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--gold, #111111);
    display: inline-block;
    flex-shrink: 0;
  }
  .author-avatar--yr svg { display: block; width: 100%; height: 100%; }
  .author-avatar--img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-meta {
    flex: 1;
  }
  .author-name {
    font-family: var(--serif, Georgia, serif);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink, #1a1a1a);
    margin: 0 0 2px;
  }
  .author-role {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--muted, #666);
    margin: 0 0 6px;
  }
  .author-link {
    /* WCAG 2.5.8: standalone CTA link, measured 93x16 by the Oct-30 audit. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--gold, #111111);
    text-decoration: none;
    font-weight: 600;
  }
  .author-bio-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 18px;
  }
  .author-tag {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold, #111111);
    margin: 0 0 4px;
    font-weight: 700;
  }
  .author-name-lg {
    font-family: var(--serif, Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink, #1a1a1a);
    margin: 0 0 2px;
    line-height: 1.2;
  }
  .author-role-lg {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    color: var(--muted, #666);
    margin: 0;
  }
  .author-bio-text {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    margin: 0 0 14px;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line, #e5e5e5);
  }
  .author-link-pill {
    display: inline-block;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--ink, #1a1a1a);
    background: var(--panel);
    border: 1px solid var(--line, #e5e5e5);
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .author-link-pill:hover {
    border-color: var(--gold, #111111);
    color: var(--gold, #111111);
  }
  .author-link-pill--primary {
    background: var(--text-1);
    color: #ffffff;
    font-weight: 700;
  }
  .author-link-pill--primary:hover {
    color: #ffffff;
    background: var(--text-1);
  }
</style>
