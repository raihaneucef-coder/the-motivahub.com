---
interface Props {
  variant?: "compact" | "full";
  showSchema?: boolean;
  lang?: "en" | "fr";
  name: string;
  jobTitle: string;
  bio: string;
}

const { variant = "full", showSchema = true, lang = "en", name, jobTitle, bio } = Astro.props;

// The author page has a French twin; without this every French page was
// pointing its readers at the English bio.
const localePrefix = lang === "fr" ? "/fr" : "";

const author = {
  name: "Youssef Raihane",
  jobTitle: "Founder & Editor-in-Chief",
  worksFor: "Motiva Hub",
  url: "https://the-motivahub.com",
  bio: "Founder of Motiva Hub, launched in 2025. Writes essays on discipline, habits, and stoicism. Believes discipline beats motivation — every single time.",
  avatar: "/images/youssef-raihane.jpg",
  founded: 2025,
};

---

{variant === "compact" && (
  <aside class="author-bio author-bio--compact">
    <span class="author-avatar author-avatar--img">
      <img
        src="/images/yr-320.jpg"
        srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w"
        sizes="56px"
        alt={author.name}
        width="56" height="56"
        loading="lazy"
      />
    </span>
    <div class="author-meta">
      <p class="author-name">{author.name}</p>
      <p class="author-role">{author.jobTitle} · {author.worksFor}</p>
      <a class="author-link" href={localePrefix + "/author/youssef-raihane/"}>Read full bio →</a>
    </div>
  </aside>
)}

{variant === "full" && (
  <aside class="author-bio author-bio--full">
    <div class="author-bio-head">
      <span class="author-avatar-lg author-avatar--img">
        <img
          src="/images/yr-320.jpg"
          srcset="/images/yr-320.jpg 320w, /images/yr-640.jpg 640w"
          sizes="88px"
          alt={author.name}
          width="88" height="88"
          loading="lazy"
        />
      </span>
      <div>
        <p class="author-tag">About the author</p>
        <h3 class="author-name-lg">{author.name}</h3>
        <p class="author-role-lg">{author.jobTitle} · Founded {author.worksFor} in {author.founded}</p>
      </div>
    </div>
    <p class="author-bio-text">{author.bio}</p>
    <div class="author-links">
      <a class="author-link-pill author-link-pill--primary" href={localePrefix + "/author/youssef-raihane/"}>Full Author Page →</a>
    </div>
  </aside>
)}

<style>
  .author-bio {
    border: 1px solid var(--line, #e5e5e5);
    border-radius: 14px;
    background: var(--cream, #faf7f2);
    margin: 56px auto;
    max-width: 720px;
    padding: 28px 28px;
  }
  .author-bio--compact {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
  }
  .author-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: inline-block;
    border: 1px solid var(--line, #e5e5e5);
  }
  .author-avatar-lg {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--gold, #c8a04a);
    display: inline-block;
    flex-shrink: 0;
  }
  .author-avatar--yr svg { display: block; width: 100%; height: 100%; }
  .author-avatar--img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-meta {
    flex: 1;
  }
  .author-name {
    font-family: var(--serif, Georgia, serif);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink, #1a1a1a);
    margin: 0 0 2px;
  }
  .author-role {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--muted, #666);
    margin: 0 0 6px;
  }
  .author-link {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--gold, #c8a04a);
    text-decoration: none;
    font-weight: 600;
  }
  .author-bio-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 18px;
  }
  .author-tag {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold, #c8a04a);
    margin: 0 0 4px;
    font-weight: 700;
  }
  .author-name-lg {
    font-family: var(--serif, Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink, #1a1a1a);
    margin: 0 0 2px;
    line-height: 1.2;
  }
  .author-role-lg {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    color: var(--muted, #666);
    margin: 0;
  }
  .author-bio-text {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink, #1a1a1a);
    margin: 0 0 14px;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line, #e5e5e5);
  }
  .author-link-pill {
    display: inline-block;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    color: var(--ink, #1a1a1a);
    background: var(--white, #fff);
    border: 1px solid var(--line, #e5e5e5);
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .author-link-pill:hover {
    border-color: var(--gold, #c8a04a);
    color: var(--gold, #c8a04a);
  }
  .author-link-pill--primary {
    background: var(--gold, #c8a04a);
    color: var(--ink, #0e0e0e);
    font-weight: 700;
  }
  .author-link-pill--primary:hover {
    color: var(--ink, #0e0e0e);
    background: #d4ab58;
  }
</style>
