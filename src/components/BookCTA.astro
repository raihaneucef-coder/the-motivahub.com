---
import { books } from "../data/books";
import dictFr from "../../public/i18n/dict-fr.json";

interface Props {
  bookSlug?: string;
  variant?: "primary" | "compact";
}

const { bookSlug, variant = "primary" } = Astro.props;
const book = bookSlug ? books.find((b) => b.id === bookSlug) : null;
const rel = "nofollow sponsored noopener";
const isPrimary = variant === "primary";
const showDefaultSlot = Astro.slots.has("default");

// /fr/ routes render the card fully in French at build time: the runtime
// data-i18n swap only knows the dictionary's raw "{title}"/"{author}"
// placeholders and has no access to the book data, so leaving them to the
// client produced "Prêt à lire {title} ?" on French pages. EN routes are
// untouched and keep the client-side swap.
const onFr = Astro.url.pathname === "/fr" || Astro.url.pathname.startsWith("/fr/");
const fill = (s: string) =>
  s.replace(/\{(\w+)\}/g, (_, v) => (v === "title" ? book?.title ?? "" : v === "author" ? book?.author ?? "" : `{${v}}`));

const t = (() => {
  if (typeof window === "undefined") return {};
  const dict = window.i18nDict || {};
  const lang = localStorage.getItem("lang") || "en";
  return dict[lang] || dict.en || {};
})();

const lang = typeof window !== "undefined" ? (localStorage.getItem("lang") || "en") : "en";
const bookReason = book && lang === "fr" && book.reasonFr ? book.reasonFr : book?.reason;
---

{(book || showDefaultSlot) && isPrimary && (
  <aside class="aff-cta">
    {book && onFr ? (
      <>
        <p class="aff-cta-tag">{fill(dictFr.bookCtaRecommended)}</p>
        <h3 class="aff-cta-title">{fill(dictFr.bookCtaReady)}</h3>
        <p class="aff-cta-by">{fill(dictFr.bookCtaBy)}</p>
        <p class="aff-cta-desc">{book.reasonFr || book.reason}</p>
        <a class="aff-cta-btn" href={book.affiliateUrl} target="_blank" rel={rel}>{fill(dictFr.bookCtaViewAmazon)}</a>
        <p class="aff-cta-foot">{dictFr.bookCtaAssociate}</p>
      </>
    ) : (
      <>
        <p class="aff-cta-tag" data-i18n="bookCtaRecommended">★ Recommended</p>
        {book && (
          <>
            <h3 class="aff-cta-title" data-i18n="bookCtaReady">Ready to read {book.title}?</h3>
            <p class="aff-cta-by" data-i18n="bookCtaBy">by {book.author}</p>
            <p class="aff-cta-desc">{bookReason}</p>
            <a class="aff-cta-btn" href={book.affiliateUrl} target="_blank" rel={rel} data-i18n="bookCtaViewAmazon">View on Amazon →</a>
            <p class="aff-cta-foot" data-i18n="bookCtaAssociate">As an Amazon Associate we earn from qualifying purchases. The price you pay is unchanged.</p>
          </>
        )}
        {!book && showDefaultSlot && <slot />}
      </>
    )}
  </aside>
)}

{(book || showDefaultSlot) && !isPrimary && (
  <div class="aff-cta-compact">
    {book && onFr && (
      <a class="aff-cta-btn-sm" href={book.affiliateUrl} target="_blank" rel={rel}>{fill(dictFr.bookCtaBuyAmazon)}</a>
    )}
    {book && !onFr && (
      <a class="aff-cta-btn-sm" href={book.affiliateUrl} target="_blank" rel={rel} data-i18n="bookCtaBuyAmazon">Buy {book.title} on Amazon →</a>
    )}
    {!book && showDefaultSlot && <slot />}
  </div>
)}

<style>
  .aff-cta {
    margin: 48px auto;
    max-width: 720px;
    padding: 32px 28px;
    border: 1px solid var(--line, #e5e5e5);
    border-top: 3px solid var(--gold, #c8a04a);
    border-radius: 14px;
    background: var(--white, #fff);
    text-align: center;
  }
  .aff-cta-tag {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--gold, #c8a04a);
    margin: 0 0 12px;
    font-weight: 700;
  }
  .aff-cta-title {
    font-family: var(--serif, Georgia, serif);
    font-size: 26px;
    font-weight: 600;
    margin: 0 0 4px;
    color: var(--ink, #1a1a1a);
    line-height: 1.3;
  }
  .aff-cta-by {
    font-family: var(--serif, Georgia, serif);
    font-style: italic;
    font-size: 14px;
    color: var(--muted, #666);
    margin: 0 0 16px;
  }
  .aff-cta-desc {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink, #1a1a1a);
    margin: 0 0 24px;
  }
  .aff-cta-btn {
    display: inline-block;
    background: var(--gold, #c8a04a);
    color: var(--ink, #0e0e0e);
    padding: 14px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .aff-cta-btn:hover {
    background: #d4ab58;
    transform: translateY(-1px);
  }
  .aff-cta-foot {
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 11px;
    color: var(--muted, #888);
    margin: 16px 0 0;
    font-style: italic;
  }
  .aff-cta-compact {
    margin: 24px 0;
    text-align: center;
  }
  .aff-cta-btn-sm {
    display: inline-block;
    border: 1px solid var(--gold, #c8a04a);
    color: var(--gold, #c8a04a);
    padding: 10px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .aff-cta-btn-sm:hover {
    background: var(--gold, #c8a04a);
    color: var(--ink, #0e0e0e);
  }
</style>