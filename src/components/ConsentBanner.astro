---
// F-12: first-party cookie banner.
// Google's Privacy & messaging CMP (Funding Choices) does not load for most
// visitors (0 fundingchoices requests observed), so the googlefc callback never
// fires and Consent Mode v2 stays all-denied forever — GA4 then only receives
// cookieless hits (and none since 2026-10-27). This banner provides the
// consent decision locally: it applies a stored decision on every page load
// and shows the banner only when no decision exists yet.
// Priority: a stored first-party decision wins over the (missing) CMP verdict.
---
<div id="mh-consent-banner" hidden role="region" aria-label="Cookie consent">
  <div class="mh-consent-card">
    <p class="mh-consent-text" data-en="We use cookies to measure traffic and improve the site. Analytics stay off until you accept.">
      We use cookies to measure traffic and improve the site. Analytics stay off until you accept.
    </p>
    <div class="mh-consent-actions">
      <button type="button" class="mh-consent-btn mh-consent-accept" data-en="Accept">Accept</button>
      <button type="button" class="mh-consent-btn mh-consent-reject" data-en="Reject">Reject</button>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var KEY = "mh-consent";
    var LANG = document.documentElement.lang || "en";
    var TXT_EN = { t: "We use cookies to measure traffic and improve the site. Analytics stay off until you accept.", a: "Accept", r: "Reject" };
    var TXT = {
      en: TXT_EN,
      fr: { t: "Nous utilisons des cookies pour mesurer le trafic et am\u00e9liorer le site. La mesure reste d\u00e9sactiv\u00e9e tant que vous n'acceptez pas.", a: "Accepter", r: "Refuser" },
      ar: { t: "\u0646\u0633\u062a\u0639\u0645\u0644 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0644\u0642\u064a\u0627\u0633 \u0627\u0644\u0632\u064a\u0627\u0631\u0627\u062a \u0648\u062a\u062d\u0633\u064a\u0646 \u0627\u0644\u0645\u0648\u0642\u0639. \u0627\u0644\u0642\u064a\u0627\u0633 \u0645\u0628\u0644\u0648\u0643 \u062d\u062a\u0649 \u062a\u0642\u0628\u0644.", a: "\u0642\u0628\u0648\u0644", r: "\u0631\u0641\u0636" }
    }[LANG] || TXT_EN;

    function updateConsent(analyticsGranted) {
      if (typeof window.gtag !== "function") return;
      gtag("consent", "update", {
        analytics_storage: analyticsGranted ? "granted" : "denied",
        ad_storage: analyticsGranted ? "granted" : "denied",
        ad_user_data: analyticsGranted ? "granted" : "denied",
        ad_personalization: analyticsGranted ? "granted" : "denied"
      });
    }

    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    if (stored === "granted" || stored === "denied") {
      updateConsent(stored === "granted");
      return;
    }

    var banner = document.getElementById("mh-consent-banner");
    if (!banner) return;
    banner.hidden = false;
    var el = banner.querySelector(".mh-consent-text");
    var btnA = banner.querySelector(".mh-consent-accept");
    var btnR = banner.querySelector(".mh-consent-reject");
    if (el) el.textContent = TXT.t;
    if (btnA) btnA.textContent = TXT.a;
    if (btnR) btnR.textContent = TXT.r;

    function decide(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      updateConsent(value === "granted");
      banner.hidden = true;
    }
    if (btnA) btnA.addEventListener("click", function () { decide("granted"); });
    if (btnR) btnR.addEventListener("click", function () { decide("denied"); });
  })();
</script>
<style>
  #mh-consent-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 2147483000;
    padding: 12px 16px;
    background: #0f172a;
    color: #e2e8f0;
    box-shadow: 0 -4px 16px rgba(2, 6, 23, 0.4);
  }
  .mh-consent-card {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .mh-consent-text { margin: 0; font-size: 0.875rem; line-height: 1.4; }
  .mh-consent-actions { display: flex; gap: 8px; }
  .mh-consent-btn {
    border: 1px solid #475569;
    background: transparent;
    color: #e2e8f0;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .mh-consent-accept { background: #2563eb; border-color: #2563eb; color: #fff; }
  .mh-consent-btn:hover { filter: brightness(1.1); }
  [dir="rtl"] .mh-consent-card { flex-direction: row-reverse; }
</style>
