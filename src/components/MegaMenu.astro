---
import Link from "./Link.astro";

const sections = [
  {
    heading: "Start Here",
    headingKey: "navStartHere",
    items: [
      { num: "01", label: "Begin your journey", href: "/journal/", labelKey: "navBeginJourney" },
    ],
  },
  {
    heading: "Read",
    headingKey: "navRead",
    items: [
      { num: "02", label: "Journal", href: "/journal/", labelKey: "navJournal" },
      { num: "03", label: "Essays", href: "/topics/", labelKey: "navEssays" },
      { num: "04", label: "Quotes", href: "/quotes/", labelKey: "navQuotes" },
    ],
  },
  {
    heading: "Learn",
    headingKey: "navLearn",
    items: [
      { num: "05", label: "Guides", href: "/guides/", labelKey: "navGuides" },
      { num: "06", label: "Books", href: "/books/", labelKey: "navBooks" },
      { num: "07", label: "Curated Listening", href: "/podcast/", labelKey: "navCuratedListening" },
    ],
  },
  {
    heading: "Apply",
    headingKey: "navApply",
    items: [
      { num: "08", label: "Tools", href: "/tools/", labelKey: "navTools" },
      { num: "09", label: "30 Days of Discipline", href: "/30-days-discipline/", labelKey: "nav30Days" },
      { num: "10", label: "Quiz", href: "/tools/discipline-quiz/", labelKey: "navQuiz" },
    ],
  },
  {
    heading: "Grow",
    headingKey: "navGrow",
    items: [
      { num: "11", label: "About", href: "/about/", labelKey: "navAbout" },
      { num: "12", label: "Founder", href: "/author/youssef-raihane/", labelKey: "navFounder" },
      { num: "13", label: "Newsletter", href: "/#newsletter", labelKey: "navNewsletter" },
    ],
  },
];
---

<div class="overlay-menu" id="overlay-menu">
  <div class="overlay-head container">
    <Link href="/" class="logo logo-text logo-text-cream">
      <span class="logo-word">Motiva <em>Hub</em></span>
    </Link>
    <button class="menu-btn menu-btn-cream" id="menu-close" aria-label="Close menu">
      <span data-i18n="close">Close</span>
      <span class="menu-btn-bars"><span></span><span></span></span>
    </button>
  </div>
  <nav class="overlay-nav" aria-label="Fullscreen menu">
    {sections.map((section) => (
      <div class="overlay-nav-section">
        <p class="overlay-nav-heading" data-i18n={section.headingKey}>{section.heading}</p>
        {section.items.map((item) => (
          <Link href={item.href} data-num={item.num} class={section.headingKey === "navStartHere" ? "overlay-nav-entry" : undefined}>
            <span data-i18n={item.labelKey}>{item.label}</span>
          </Link>
        ))}
      </div>
    ))}
  </nav>
  <div class="overlay-foot container">
    <p data-i18n="footerTagline">The Daily Drive. Mindset, habits, books and free tools — for the long ascent, one day at a time.</p>
    <button class="btn btn-primary" type="button" onclick="document.getElementById('newsletter')?.scrollIntoView({behavior:'smooth'}); document.getElementById('overlay-menu')?.classList.remove('open'); document.body.style.overflow=''; document.body.classList.remove('menu-open');" data-i18n="footerSubscribe">Subscribe</button>
  </div>
</div>
