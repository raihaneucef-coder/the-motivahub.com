---
const sections = [
  {
    heading: "Read",
    items: [
      { num: "01", label: "The Journal", href: "/journal/", labelKey: "navJournal" },
      { num: "02", label: "Daily Quotes", href: "/quotes/", labelKey: "navQuotes" },
      { num: "03", label: "Topics", href: "/topics/", labelKey: "navTopics" },
      { num: "04", label: "The Bookstand", href: "/books/", labelKey: "navBookstand" },
    ],
  },
  {
    heading: "Guides",
    items: [
      { num: "05", label: "Atomic Habits", href: "/guides/atomic-habits-ultimate-guide/", labelKey: "navAtomicHabits" },
      { num: "06", label: "Best Books 2026", href: "/best/books/", labelKey: "navBestBooks" },
      { num: "07", label: "Best Focus Books", href: "/best/focus-books/", labelKey: "navBestFocus" },
      { num: "08", label: "Best Habit Books", href: "/best/habit-books/", labelKey: "navBestHabit" },
      { num: "09", label: "Best Stoicism Books", href: "/best/stoicism-books/", labelKey: "navBestStoicism" },
    ],
  },
  {
    heading: "Tools",
    items: [
      { num: "10", label: "Discipline Quiz", href: "/tools/discipline-quiz/", labelKey: "navDisciplineQuiz" },
      { num: "11", label: "Habit Stacker", href: "/tools/habit-stacker/", labelKey: "navHabitStacker" },
      { num: "12", label: "Meditation Timer", href: "/tools/meditation-timer/", labelKey: "navMeditationTimer" },
      { num: "13", label: "Cold Shower Tracker", href: "/tools/cold-shower-tracker/", labelKey: "navColdShower" },
      { num: "14", label: "Reading Calculator", href: "/tools/reading-calculator/", labelKey: "navReadingCalc" },
    ],
  },
  {
    heading: "Brand",
    items: [
      { num: "15", label: "The Author", href: "/author/youssef-raihane/", labelKey: "navAuthor" },
      { num: "16", label: "About", href: "/about/", labelKey: "navAbout" },
      { num: "17", label: "30 Days of Discipline", href: "/pdf/30-days-discipline/", labelKey: "nav30Days" },
      { num: "18", label: "Contact", href: "/contact/", labelKey: "navContact" },
    ],
  },
];
---

<div class="overlay-menu" id="overlay-menu">
  <div class="overlay-head container">
    <a href="/" class="logo logo-text logo-text-cream">
      <span class="logo-word">Motiva <em>Hub</em></span>
    </a>
    <button class="menu-btn menu-btn-cream" id="menu-close" aria-label="Close menu">
      <span data-i18n="close">Close</span>
      <span class="menu-btn-bars"><span></span><span></span></span>
    </button>
  </div>
  <nav class="overlay-nav" aria-label="Fullscreen menu">
    {sections.map((section) => (
      <div class="overlay-nav-section">
        <p class="overlay-nav-heading" data-i18n={`nav${section.heading}`}>{section.heading}</p>
        {section.items.map((item) => (
          <a href={item.href} data-num={item.num}>
            <span data-i18n={item.labelKey}>{item.label}</span>
          </a>
        ))}
      </div>
    ))}
  </nav>
  <div class="overlay-foot container">
    <p data-i18n="footerTagline">The Daily Drive. Mindset, habits, books and free tools — for the long ascent, one day at a time.</p>
    <button class="btn btn-primary" type="button" onclick="document.getElementById('newsletter')?.scrollIntoView({behavior:'smooth'}); document.getElementById('overlay-menu')?.classList.remove('open'); document.body.style.overflow='';" data-i18n="footerSubscribe">Subscribe</button>
  </div>
</div>
